+#[test]
+fn host_acknowledges_only_captured_revision_and_bounds_payloads() {
+    let (mut base, written) = app_with(Vec::new());
+    base.services.host_mode = true;
+    let sends = Rc::new(Cell::new(0));
+    let sent = sends.clone();
+    base.services.host_save = Some(Box::new(move |_, _| {
+        sent.set(sent.get() + 1);
+        Ok(format!("save-{}", sent.get()))
+    }));
+    let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), base.services);
+    assert!(app.open_file_pathless("bad.png", b"x").is_err());
+    assert!(app.open_file_pathless("empty.pcraft", b"").is_err());
+    let oversized = vec![0; crate::host_document::MAX_BYTES + 1];
+    assert!(app.open_file_pathless("big.pcraft", &oversized).is_err());
+    app.open_file_pathless("bound.pcraft", b"x").unwrap();
+    app.run("layer.new.layer", json!({})).unwrap();
+    let captured = app.session.active().unwrap().revision;
+    let ticket = app.run("file.save", json!({})).unwrap();
+    app.run("layer.new.layer", json!({})).unwrap();
+    assert!(app.host_save_result(ticket.as_str().unwrap(), true, None));
+    assert_eq!(app.session.active().unwrap().saved_revision, captured);
+    assert!(app.session.active().unwrap().is_dirty(), "edit after capture survives positive ACK");
+    assert!(!app.host_save_result(ticket.as_str().unwrap(), true, None));
+    let ticket = app.save_host_snapshot().unwrap();
+    app.host_save_timed_out();
+    for _ in 0..3 {
+        assert!(app.save_host_snapshot().is_err());
+    }
+    assert_eq!(sends.get(), 2, "timeout never retries");
+    assert!(app.has_unsaved_work());
+    assert!(app.host_save_result(&ticket, false, Some("rejected")));
+    assert!(app.session.active().unwrap().is_dirty());
+    app.services.export = Some(Box::new(move |_, _, _| Ok((oversized.clone(), Vec::new()))));
+    assert!(app.save_host_snapshot().is_err());
+    assert_eq!(sends.get(), 2, "oversized output never reaches transport");
+    assert!(app.host_save_pending.is_none());
+    assert!(written.borrow().is_empty());
+}
