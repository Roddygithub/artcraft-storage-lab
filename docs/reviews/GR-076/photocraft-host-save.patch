+use crate::{EngineError, Session};
+use serde_json::json;
+
+fn session() -> Session {
+    let mut session = Session::new();
+    session.execute("file.new", json!({"width": 4, "height": 4})).unwrap();
+    session
+}
+
+#[test]
+fn acknowledging_a_stale_snapshot_keeps_later_edits_dirty() {
+    let mut session = session();
+    let snapshot = session.active().unwrap().saved_snapshot();
+    let saved_revision = snapshot.revision();
+    session
+        .edit("test edit", |doc, _| {
+            doc.name = "edited after capture".into();
+            Ok(())
+        })
+        .unwrap();
+    let current_revision = session.active().unwrap().revision;
+    assert!(current_revision > saved_revision);
+
+    session.acknowledge_saved_snapshot(snapshot).unwrap();
+
+    let state = session.active().unwrap();
+    assert_eq!(state.saved_revision, saved_revision);
+    assert_eq!(state.revision, current_revision);
+    assert!(state.is_dirty());
+}
+
+#[test]
+fn acknowledging_the_current_snapshot_marks_it_saved() {
+    let mut session = session();
+    session
+        .edit("test edit", |doc, _| {
+            doc.name = "ready to save".into();
+            Ok(())
+        })
+        .unwrap();
+    let snapshot = session.active().unwrap().saved_snapshot();
+    assert_eq!(snapshot.document().name, "ready to save");
+    let revision = snapshot.revision();
+
+    session.acknowledge_saved_snapshot(snapshot).unwrap();
+
+    let state = session.active().unwrap();
+    assert_eq!(state.saved_revision, revision);
+    assert!(!state.is_dirty());
+}
+
+#[test]
+fn snapshot_ack_is_rejected_after_its_document_closes() {
+    let mut session = session();
+    let snapshot = session.active().unwrap().saved_snapshot();
+    session.close(0);
+    assert!(matches!(session.acknowledge_saved_snapshot(snapshot), Err(EngineError::Other(_))));
+}
+
+#[test]
+fn snapshot_ack_is_rejected_after_same_id_reopens() {
+    let mut session = session();
+    let snapshot = session.active().unwrap().saved_snapshot();
+    let doc = snapshot.document().clone();
+    session.close(0);
+    session.add_document(doc, None);
+    session.execute("layer.new.layer", json!({})).unwrap();
+    assert!(session.acknowledge_saved_snapshot(snapshot).is_err());
+    assert!(session.active().unwrap().is_dirty());
+}
