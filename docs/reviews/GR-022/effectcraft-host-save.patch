+#[test]
+fn host_save_ack_commits_only_the_captured_project_snapshot() {
+    let source = demo();
+    let bytes = source.project.to_file_json_with_view(&source.saved_view()).unwrap().into_bytes();
+    let mut host = Session::default();
+    host.set_host_mode(true);
+    host.open_host_project(&bytes).unwrap();
+    assert_eq!(host.path, None);
+    host.execute("comp.new", json!({"name":"Captured"})).unwrap();
+    let snapshot = host.host_save_snapshot().unwrap();
+    assert!(!snapshot.bytes.is_empty());
+    let committed_bytes = snapshot.bytes.clone();
+    host.execute("comp.new", json!({"name":"Later"})).unwrap();
+    assert!(host.ack_host_save(snapshot));
+    assert!(host.is_dirty(), "the ACK cannot clean edits made after serialization");
+
+    let committed: serde_json::Value = serde_json::from_slice(&committed_bytes).unwrap();
+    assert!(committed["items"].as_object().unwrap().values().any(|item| item["name"] == "Captured"));
+    assert!(!committed["items"].as_object().unwrap().values().any(|item| item["name"] == "Later"));
+}
+
+#[test]
+fn host_save_serializes_current_snapshot_without_discarding_undo_branch() {
+    let source = demo();
+    let bytes = source.project.to_file_json_with_view(&source.saved_view()).unwrap().into_bytes();
+    let mut host = Session::default();
+    host.set_host_mode(true);
+    host.open_host_project(&bytes).unwrap();
+
+    host.execute("comp.new", json!({"name":"A"})).unwrap();
+    host.execute("edit.undo", json!({})).unwrap();
+    host.execute("comp.new", json!({"name":"B"})).unwrap();
+    let branches_before_save = host.history.branches.len();
+    assert!(branches_before_save > 0, "undo then new edit creates a history branch");
+
+    let snapshot = host.host_save_snapshot().unwrap();
+    let serialized: serde_json::Value = serde_json::from_slice(&snapshot.bytes).unwrap();
+    let item_names = serialized["items"].as_object().unwrap().values().filter_map(|item| item["name"].as_str()).collect::<Vec<_>>();
+    assert!(item_names.contains(&"B"), "host snapshot serializes the current edit: {item_names:?}");
+    assert!(!item_names.contains(&"A"), "undone edit is not serialized: {item_names:?}");
+    assert_eq!(host.history.branches.len(), branches_before_save, "snapshot serialization preserves undo history");
+
+    assert!(host.ack_host_save(snapshot));
+    assert!(!host.is_dirty(), "the exact current snapshot becomes the saved baseline");
+    assert_eq!(host.history.branches.len(), branches_before_save, "ack preserves history in memory");
+}
+
+#[test]
