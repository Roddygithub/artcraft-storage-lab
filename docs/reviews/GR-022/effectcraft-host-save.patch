+    /// Opt this session into the single-document browser host contract.
+    pub fn set_host_mode(&mut self, enabled: bool) {
+        self.host_mode = enabled;
+    }
+
+    /// Open a host-provided native `.ecproj` without assigning it a local filesystem path.
+    pub fn open_host_project(&mut self, bytes: &[u8]) -> Result<()> {
+        if self.host_mode && self.is_dirty() {
+            return Err(EngineError::Other("refusing to replace unsaved edits made before the host document arrived".into()));
+        }
+        let text = std::str::from_utf8(bytes).map_err(|_| EngineError::Other("not a text project file".into()))?;
+        let (project, _) = Project::from_json_repaired(text).map_err(|e| EngineError::Other(format!("not a project EffectCraft can open: {e}")))?;
+        self.replace_project(project, None);
+        self.restore_view(&effectcraft_project::saved_view(text));
+        Ok(())
+    }
+
+    /// Serialize the exact current project snapshot for an asynchronous host write.
+    pub fn host_save_snapshot(&self) -> Result<HostSaveSnapshot> {
+        if !self.host_mode || self.path.is_some() {
+            return Err(EngineError::Other("no host-bound document is open".into()));
+        }
+        let json = self.project.to_file_json_with_view(&self.saved_view())?;
+        Ok(HostSaveSnapshot {
+            project: self.project.clone(),
+            saved_project: self.saved_project.clone(),
+            revision: self.revision,
+            bytes: json.into_bytes().into(),
+        })
+    }
+
+    /// Record a durable host acknowledgement against its captured snapshot. Later edits stay dirty.
+    pub fn ack_host_save(&mut self, snapshot: HostSaveSnapshot) -> bool {
+        if !self.host_mode || self.path.is_some() || !Arc::ptr_eq(&self.saved_project, &snapshot.saved_project) || snapshot.revision > self.revision {
+            return false;
+        }
+        self.saved_project = snapshot.project.clone();
+        self.saved_revision = if Arc::ptr_eq(&self.project, &snapshot.project) { self.revision } else { snapshot.revision };
+        true
+    }
