@@ -0,0 +1,107 @@
+//! Opt-in parent transport for one pathless EffectCraft project.
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use craft_platform::browser::host::{HostListener, HostMessage, HostTransport};
+use craft_platform::host_protocol::SaveTicket;
+use effectcraft_ui_egui::EffectcraftApp;
+use wasm_bindgen::JsValue;
+
+pub struct HostController {
+    transport: HostTransport,
+    _listener: HostListener,
+    events: Rc<RefCell<HostQueue>>,
+    dirty: Option<bool>,
+}
+
+struct HostQueue {
+    events: Vec<HostMessage>,
+    queued_bytes: usize,
+    open_seen: bool,
+    pending_ticket: Option<String>,
+}
+
+const MAX_EVENTS: usize = 2;
+const MAX_OPEN_BYTES: usize = 256 * 1024 * 1024;
+
+impl HostController {
+    pub fn new() -> Result<Self, JsValue> {
+        let transport = HostTransport::current("effectcraft")?.ok_or_else(|| JsValue::from_str("host=parent requires a same-origin parent frame"))?;
+        let events = Rc::new(RefCell::new(HostQueue { events: Vec::new(), queued_bytes: 0, open_seen: false, pending_ticket: None }));
+        let queued = events.clone();
+        let listener = transport.listen(move |message| {
+            let mut queue = queued.borrow_mut();
+            match message {
+                HostMessage::Open { name, bytes }
+                    if !queue.open_seen
+                        && bytes.len() <= MAX_OPEN_BYTES
+                        && queue.queued_bytes + bytes.len() <= MAX_OPEN_BYTES
+                        && queue.events.len() < MAX_EVENTS =>
+                {
+                    queue.queued_bytes += bytes.len();
+                    queue.open_seen = true;
+                    queue.events.push(HostMessage::Open { name, bytes });
+                    crate::repaint();
+                }
+                HostMessage::SaveResult { ticket, ok, error }
+                    if queue.pending_ticket.as_deref() == Some(ticket.as_str()) && queue.events.len() < MAX_EVENTS =>
+                {
+                    queue.pending_ticket = None;
+                    queue.events.push(HostMessage::SaveResult { ticket, ok, error });
+                    crate::repaint();
+                }
+                _ => {}
+            }
+        })?;
+        Ok(Self { transport, _listener: listener, events, dirty: None })
+    }
+
+    pub fn ready(&self) -> Result<(), JsValue> {
+        self.transport.post_ready(env!("CARGO_PKG_VERSION"))
+    }
+
+    pub fn failed(&self, error: &str) {
+        let _ = self.transport.post_failed(error);
+    }
+
+    pub fn tick(&mut self, app: &mut EffectcraftApp, now: f64, ctx: &egui::Context) {
+        let events = {
+            let mut queue = self.events.borrow_mut();
+            queue.queued_bytes = 0;
+            std::mem::take(&mut queue.events)
+        };
+        for event in events {
+            match event {
+                HostMessage::Open { name, bytes } => {
+                    if let Err(error) = app.host_open(name, &bytes) {
+                        log::warn!("host open rejected: {error}");
+                        let _ = self.transport.post_failed(&error);
+                        // HostTransport's copied-byte budget is cumulative. Keep this iframe's
+                        // one initial Open consumed; retry requires reloading the iframe.
+                    }
+                }
+                HostMessage::SaveResult { ticket, ok, error } => app.host_save_result(ticket.as_str(), ok, error.as_deref()),
+            }
+        }
+        if let Some(save) = app.take_host_save() {
+            self.events.borrow_mut().pending_ticket = Some(save.ticket.clone());
+            match SaveTicket::new(save.ticket.clone())
+                .ok_or_else(|| JsValue::from_str("invalid save ticket"))
+                .and_then(|ticket| self.transport.post_save(&ticket, &save.name, &save.bytes, false).map(|_| ticket))
+            {
+                Ok(_) => {}
+                Err(error) => {
+                    if self.events.borrow().pending_ticket.as_deref() == Some(save.ticket.as_str()) {
+                        self.events.borrow_mut().pending_ticket = None;
+                    }
+                    app.host_save_send_failed(&save.ticket, &format!("{error:?}"));
+                }
+            }
+        }
+        app.tick_host_save_timeout(now, ctx);
+        let dirty = app.host_dirty();
+        if self.dirty != Some(dirty) && self.transport.post_dirty(dirty).is_ok() {
+            self.dirty = Some(dirty);
+        }
+    }
+}
