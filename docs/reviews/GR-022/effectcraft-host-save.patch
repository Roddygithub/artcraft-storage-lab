+    let mut s = Session::default();
+    s.set_host_mode(true);
+    for (id, params) in [
+        ("file.newProject", json!({})),
+        ("file.open", json!({"path":"/other.ecproj"})),
+        ("file.recovery.open", json!({})),
+        ("file.closeProject", json!({})),
+        ("file.saveAs", json!({"path":"/other.ecproj"})),
+        ("file.save", json!({})),
+    ] {
+        assert!(s.execute(id, params).is_err(), "{id} must not bypass the host adapter");
+    }
+}
