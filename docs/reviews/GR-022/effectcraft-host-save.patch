 impl EffectcraftApp {
+    /// Enable the opt-in, single-document host mode.
+    pub fn enable_host_mode(&mut self) {
+        self.host_mode = true;
+        self.session.set_host_mode(true);
+    }
+
+    pub fn is_host_mode(&self) -> bool {
+        self.host_mode
+    }
+
+    /// Accept the initial host document only; it never receives a local filesystem path.
+    pub fn host_open(&mut self, name: String, bytes: &[u8]) -> Result<(), String> {
+        if !self.host_mode {
+            return Err("EffectCraft host mode accepts one initial project only".into());
+        }
+        if self.host_name.is_some() || self.host_pending.is_some() {
+            return Err(self.host_open_failure("EffectCraft host mode accepts one initial project only"));
+        }
+        if bytes.len() > 256 * 1024 * 1024 || !name.to_ascii_lowercase().ends_with(".ecproj") || name.contains('/') || name.contains('\\') {
+            return Err(self.host_open_failure("host open requires a supported .ecproj file under 256 MiB"));
+        }
+        self.session.open_host_project(bytes).map_err(|e| self.host_open_failure(&e.to_string()))?;
+        self.host_name = Some(name);
+        Ok(())
+    }
+
+    fn host_open_failure(&mut self, reason: &str) -> String {
+        let error = format!(
+            "{reason}. This editor cannot save pre-open edits or retry its initial host Open in place. Undo those edits (or copy them elsewhere), then reload this iframe to retry."
+        );
+        self.ui.status = error.clone();
+        error
+    }
+
+    pub fn begin_host_save(&mut self) -> Result<serde_json::Value, String> {
+        if !self.host_mode || self.host_name.is_none() {
+            return Err("no host project is open".into());
+        }
+        if self.host_pending.is_some() {
+            return Err("a host save is already awaiting confirmation".into());
+        }
+        let snapshot = self.session.host_save_snapshot().map_err(|e| e.to_string())?;
+        if snapshot.bytes.len() > 256 * 1024 * 1024 {
+            return Err("host save exceeds the 256 MiB limit".into());
+        }
+        let ticket = format!("effectcraft:{}", self.host_next_ticket);
+        self.host_next_ticket = self.host_next_ticket.saturating_add(1);
+        let name = self.host_name.clone().ok_or_else(|| "no host project is open".to_string())?;
+        self.host_outbox = Some(HostSaveRequest { ticket: ticket.clone(), name, bytes: snapshot.bytes.clone() });
+        self.host_pending = Some(PendingHostSave { ticket: ticket.clone(), snapshot, started_at: self.last_ui_time, outcome_unknown: false });
+        self.ui.status = "Saving to host…".into();
+        Ok(serde_json::json!({"pending": true, "ticket": ticket}))
+    }
+
+    pub fn take_host_save(&mut self) -> Option<HostSaveRequest> {
+        self.host_outbox.take()
+    }
+
+    pub fn host_save_send_failed(&mut self, ticket: &str, error: &str) {
+        if self.host_pending.as_ref().is_some_and(|pending| pending.ticket == ticket) {
+            self.host_pending = None;
+            self.host_outbox = None;
+            self.ui.status = format!("Host save was not sent: {error}");
+        }
+    }
+
+    pub fn host_save_result(&mut self, ticket: &str, ok: bool, error: Option<&str>) {
+        if !self.host_pending.as_ref().is_some_and(|pending| pending.ticket == ticket) {
+            return;
+        }
+        let Some(pending) = self.host_pending.take() else { return };
+        if !ok {
+            self.ui.status = format!("Host save failed: {}", error.unwrap_or("storage rejected the write"));
+        } else if !self.session.ack_host_save(pending.snapshot) {
+            self.ui.status = "Host save completed for an older document; current changes remain unsaved".into();
+        } else if self.session.is_dirty() {
+            self.ui.status = "Earlier changes saved; newer edits remain unsaved".into();
+        } else {
+            self.ui.status = "Saved to host".into();
+        }
+    }
+
+    pub fn host_dirty(&self) -> bool {
+        self.session.is_dirty() || self.host_pending.is_some()
+    }
+
+    pub fn tick_host_save_timeout(&mut self, now: f64, ctx: &egui::Context) {
+        let Some(pending) = &mut self.host_pending else { return };
+        if pending.outcome_unknown {
+            return;
+        }
+        let remaining = 120.0 - (now - pending.started_at).max(0.0);
+        if remaining <= 0.0 {
+            pending.outcome_unknown = true;
+            self.ui.status = "Save outcome unknown; check the host before trying again".into();
+        } else {
+            ctx.request_repaint_after(std::time::Duration::from_secs_f64(remaining));
+        }
+    }
