+//! WordCraft adapter for the shared Craft parent-frame transport.
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use craft_platform::browser::host::{HostListener, HostMessage, HostTransport};
+use craft_platform::host_protocol::{PendingSaves, SaveTicket};
+use wordcraft_ui_egui::async_saves::{AsyncSaves, SaveOutcome};
+use wordcraft_ui_egui::{Inbox, Services};
+
+const MAX_AUTHOR_CHARS: usize = 200;
+
+#[derive(Clone)]
+pub struct Bridge {
+    transport: HostTransport,
+    saves: AsyncSaves,
+    pending: Rc<RefCell<PendingSaves<u64>>>,
+    listener: Rc<RefCell<Option<HostListener>>>,
+    reported: Rc<Cell<Option<bool>>>,
+}
+
+impl Bridge {
+    /// `None` when this page is not framed by a same-origin parent.
+    pub fn new(saves: AsyncSaves) -> Option<Self> {
+        Some(Self {
+            transport: HostTransport::current("wordcraft").ok()??,
+            saves,
+            pending: Rc::default(),
+            listener: Rc::default(),
+            reported: Rc::default(),
+        })
+    }
+
+    pub fn connect(&self, services: &mut Services, inbox: Inbox, ctx: egui::Context) {
+        self.listen(inbox, ctx);
+        let bridge = self.clone();
+        services.download = Some(Box::new(move |path: &str, bytes: &[u8]| {
+            let name = file_name(path);
+            let save_id = bridge.saves.start();
+            let Some(ticket) = SaveTicket::new(format!("wordcraft:{save_id}")) else {
+                bridge.saves.finish(save_id, SaveOutcome::Failed("couldn't create save ticket".into()));
+                return Err("couldn't create save ticket".to_string());
+            };
+            if bridge.pending.borrow_mut().insert(ticket.clone(), save_id).is_err() {
+                bridge.saves.finish(save_id, SaveOutcome::Failed("too many saves are waiting for the host".into()));
+                return Err("too many saves are waiting for the host".to_string());
+            }
+            if let Err(error) = bridge.transport.post_save(&ticket, &name, bytes, false) {
+                bridge.pending.borrow_mut().complete(&ticket);
+                bridge.saves.finish(save_id, SaveOutcome::Failed(js_error(error)));
+                return Err("couldn't send save to host".to_string());
+            }
+            Ok(())
+        }));
+
+        let bridge = self.clone();
+        services.open_async = Some(Box::new(move |purpose: &str| {
+            let _ = bridge.transport.post_open_request(purpose);
+        }));
+
+        let bridge = self.clone();
+        let previous = services.on_dirty.take();
+        services.on_dirty = Some(Box::new(move |dirty| {
+            if let Some(previous) = &previous {
+                previous(dirty);
+            }
+            bridge.post_dirty(dirty);
+        }));
+    }
+
+    pub fn set_author(app: &mut wordcraft_ui_egui::WordApp, author: &str) {
+        let author: String = author.trim().chars().take(MAX_AUTHOR_CHARS).collect();
+        if !author.is_empty() {
+            app.session.author = author;
+        }
+    }
+
+    pub fn post_ready(&self) {
+        let _ = self.transport.post_ready(env!("CARGO_PKG_VERSION"));
+    }
+
+    pub fn post_failed(&self, error: &str) {
+        let _ = self.transport.post_failed(error);
+    }
+
+    pub fn post_dirty(&self, dirty: bool) {
+        if self.reported.get() == Some(dirty) {
+            return;
+        }
+        if self.transport.post_dirty(dirty).is_ok() {
+            self.reported.set(Some(dirty));
+        }
+    }
+
+    fn listen(&self, inbox: Inbox, ctx: egui::Context) {
+        let saves = self.saves.clone();
+        let pending = self.pending.clone();
+        let reported = self.reported.clone();
+        let listener = self.transport.listen(move |message| match message {
+            HostMessage::Open { name, bytes } => {
+                inbox.lock().unwrap_or_else(|e| e.into_inner()).push((name, bytes));
+                ctx.request_repaint();
+            }
+            HostMessage::SaveResult { ticket, ok, error } => {
+                let Some(save_id) = pending.borrow_mut().complete(&ticket) else {
+                    return;
+                };
+                let outcome =
+                    if ok { SaveOutcome::Saved } else { SaveOutcome::Failed(error.unwrap_or_else(|| "the host couldn't save the file".to_string())) };
+                saves.finish(save_id, outcome);
+                reported.set(None);
+                ctx.request_repaint();
+            }
+        });
+        if let Ok(listener) = listener {
+            *self.listener.borrow_mut() = Some(listener);
+        }
+    }
+}
+
+fn file_name(path: &str) -> String {
+    std::path::Path::new(path).file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_else(|| "document.docx".to_string())
+}
+
+fn js_error(error: wasm_bindgen::JsValue) -> String {
+    error.as_string().unwrap_or_else(|| "host message failed".to_string())
+}
