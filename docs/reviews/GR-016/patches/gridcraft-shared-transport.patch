+    /// Record the exact workbook snapshot acknowledged by a host save. A later edit keeps the
+    /// document dirty because `wb` no longer points at this snapshot; a closed document is ignored.
+    pub fn mark_saved(&mut self, uid: u64, snapshot: Arc<Workbook>, title: Option<&str>) -> bool {
+        let Some(doc) = self.docs.iter_mut().find(|doc| doc.uid == uid) else { return false };
+        doc.saved = snapshot;
+        if doc.path.is_none()
+            && let Some(title) = title
+        {
+            doc.title = title.to_string();
+        }
+        true
+    }
     pub fn doc(&self) -> Result<&DocState> {
         self.active().ok_or(EngineError::NoDocument)
     }
