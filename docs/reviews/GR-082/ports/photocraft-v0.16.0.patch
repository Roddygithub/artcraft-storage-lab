+        app.services.write_unconfirmed = download;
+        app.open_file("/synthetic/bound.pcraft", b"x").unwrap();
+        app.run("layer.new.layer", json!({})).unwrap();
+        menus::invoke(&mut app, &egui::Context::default(), "file.save", json!({})).unwrap();
+        assert_eq!(written.borrow().as_slice(), [("/synthetic/bound.pcraft".into(), b"out".to_vec())]);
+        assert_eq!(app.session.active().unwrap().is_dirty(), download);
+        assert!(app.host_save_pending.is_none());
+    }
+}
