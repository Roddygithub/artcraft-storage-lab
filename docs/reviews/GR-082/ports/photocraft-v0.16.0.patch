diff --git c/apps/photocraft-web/src/host_inbox.rs w/apps/photocraft-web/src/host_inbox.rs
new file mode 100644
index 0000000..8e02a69
--- /dev/null
+++ w/apps/photocraft-web/src/host_inbox.rs
@@ -0,0 +1,97 @@
+use std::mem;
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum HostEvent {
+    Open { open_id: String, name: String, bytes: Vec<u8> },
+    SaveResult { open_id: String, document_id: String, ticket: String, ok: bool, error: Option<String> },
+}
+
+#[derive(Default)]
+pub struct HostInbox {
+    open: Option<(String, String, Vec<u8>)>,
+    opened: bool,
+    save_result: Option<(String, bool, Option<String>)>,
+}
+
+impl HostInbox {
+    /// Keep only the first Open and the one ACK for the currently outstanding save.
+    pub fn push(&mut self, event: HostEvent, expected: Option<(&str, &str, &str)>) {
+        match event {
+            HostEvent::Open { open_id, name, bytes } if !self.opened => {
+                self.opened = true;
+                self.open = Some((open_id, name, bytes));
+            }
+            HostEvent::SaveResult { open_id, document_id, ticket, ok, error }
+                if expected == Some((open_id.as_str(), document_id.as_str(), ticket.as_str())) && self.save_result.is_none() =>
+            {
+                self.save_result = Some((ticket, ok, error));
+            }
+            HostEvent::Open { .. } | HostEvent::SaveResult { .. } => {}
+        }
+    }
+
+    pub fn take(&mut self) -> (Option<(String, String, Vec<u8>)>, Option<(String, bool, Option<String>)>) {
+        (mem::take(&mut self.open), mem::take(&mut self.save_result))
+    }
+}
+
+pub fn require_listener<T, E>(host_mode: bool, listener: Result<Option<T>, E>) -> Result<Option<T>, E> {
+    if host_mode { listener } else { Ok(None) }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn unknown_and_duplicate_results_cannot_grow_or_fill_queue_ahead_of_valid_ack() {
+        let mut inbox = HostInbox::default();
+        inbox.push(HostEvent::Open { open_id: "open-1".into(), name: "one.pcraft".into(), bytes: vec![1] }, None);
+        for _ in 0..10_000 {
+            inbox.push(
+                HostEvent::SaveResult { open_id: "open-1".into(), document_id: "42".into(), ticket: "unknown".into(), ok: true, error: None },
+                Some(("open-1", "42", "live-ticket")),
+            );
+        }
+        inbox.push(
+            HostEvent::SaveResult { open_id: "open-1".into(), document_id: "42".into(), ticket: "live-ticket".into(), ok: true, error: None },
+            Some(("open-1", "42", "live-ticket")),
+        );
+        for _ in 0..10_000 {
+            inbox.push(
+                HostEvent::SaveResult { open_id: "open-1".into(), document_id: "42".into(), ticket: "live-ticket".into(), ok: false, error: None },
+                Some(("open-1", "42", "live-ticket")),
+            );
+        }
+
+        let (open, result) = inbox.take();
+        assert_eq!(open, Some(("open-1".into(), "one.pcraft".into(), vec![1])));
+        assert_eq!(result, Some(("live-ticket".into(), true, None)));
+        assert_eq!(inbox.take(), (None, None));
+        inbox.push(HostEvent::Open { open_id: "open-1".into(), name: "two.pcraft".into(), bytes: vec![2] }, None);
+        assert_eq!(inbox.take(), (None, None), "a drain does not allow a replacement Open");
+    }
+
+    #[test]
+    fn host_listener_failure_propagates_instead_of_allowing_ready() {
+        let result: Result<Option<()>, &str> = require_listener(true, Err("listener failed"));
+        assert_eq!(result, Err("listener failed"));
+    }
+
+    #[test]
+    fn matching_ticket_with_wrong_native_or_open_identity_cannot_acknowledge_save() {
+        let mut inbox = HostInbox::default();
+        for (open_id, document_id) in [("other-open", "42"), ("open-1", "other-document")] {
+            inbox.push(
+                HostEvent::SaveResult { open_id: open_id.into(), document_id: document_id.into(), ticket: "live-ticket".into(), ok: true, error: None },
+                Some(("open-1", "42", "live-ticket")),
+            );
+        }
+        assert_eq!(inbox.take(), (None, None));
+        inbox.push(
+            HostEvent::SaveResult { open_id: "open-1".into(), document_id: "42".into(), ticket: "live-ticket".into(), ok: true, error: None },
+            Some(("open-1", "42", "live-ticket")),
+        );
+        assert_eq!(inbox.take().1, Some(("live-ticket".into(), true, None)));
+    }
+}
