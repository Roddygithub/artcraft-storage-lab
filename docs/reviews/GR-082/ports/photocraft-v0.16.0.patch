@@ -0,0 +1,41 @@
+//! Policy for a single browser host-bound document. Standalone callers do not install it.
+use serde_json::Value;
+
+pub(crate) const BLOCKED: &str = "This command is unavailable for a host-bound document";
+pub(crate) const MAX_BYTES: usize = 50 * 1024 * 1024;
+
+pub(crate) fn check_size(length: usize) -> Result<(), String> {
+    if length == 0 || length > MAX_BYTES {
+        return Err("Host documents must contain 1 byte to 50 MiB".into());
+    }
+    Ok(())
+}
+
+pub(crate) fn authorize(id: &str, params: &Value) -> photocraft_engine::Result<()> {
+    // File commands include batch/automate/import routes which may replace or create tabs.
+    // Explicit exports do not change the bound document's saved baseline.
+    let blocked = (id.starts_with("file.") && !id.starts_with("file.export"))
+        || matches!(id, "actions.play" | "image.duplicate" | "history.newDocument" | "channel.split" | "channel.merge" | "layer.smartObjects.editContents")
+        || (matches!(id, "layer.duplicate" | "layer.copyToDocument" | "channel.duplicate") && params.get("document").and_then(Value::as_str) == Some("new"))
+        || (id == "select.refineEdge" && params.get("output").and_then(Value::as_str).is_some_and(|v| v.starts_with("newDocument")))
+        || (id == "image.calculations" && params.get("result").and_then(Value::as_str) == Some("newDocument"));
+    if blocked { Err(photocraft_engine::EngineError::Other(BLOCKED.into())) } else { Ok(()) }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn host_payload_boundary() {
+        assert!(check_size(0).is_err());
+        assert!(check_size(1).is_ok());
+        assert!(check_size(MAX_BYTES).is_ok());
+        assert!(check_size(MAX_BYTES + 1).is_err());
+    }
+}
+
+/// Until the first host Open, Paste must not synthesize a clipboard document.
+pub(crate) fn authorize_waiting(id: &str, params: &Value) -> photocraft_engine::Result<()> {
+    authorize(id, params)?;
+    if id.starts_with("edit.paste") { Err(photocraft_engine::EngineError::Other(BLOCKED.into())) } else { Ok(()) }
+}
