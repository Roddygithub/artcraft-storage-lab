+#[test]
+#[ignore = "requires dbus-daemon; private session bus only"]
+fn legacy_read_keeps_queued_signals_and_drop_cancels_idle_subscription() -> Result<(), Box<dyn std::error::Error>> {
+    use std::io::BufRead;
+    use std::process::{Command, Stdio};
+    struct Daemon(std::process::Child);
+    impl Drop for Daemon {
+        fn drop(&mut self) {
+            let _ = self.0.kill();
+            let _ = self.0.wait();
+        }
+    }
+    struct Settings {
+        captured: std::sync::mpsc::Sender<()>,
+        released: async_channel::Receiver<()>,
+    }
+    #[zbus::interface(name = "org.freedesktop.portal.Settings")]
+    impl Settings {
+        async fn read(&self, namespace: &str, _key: &str) -> zbus::fdo::Result<OwnedValue> {
+            if namespace != STANDARD {
+                return Err(zbus::fdo::Error::InvalidArgs("unknown namespace".into()));
+            }
+            self.captured.send(()).map_err(|e| zbus::fdo::Error::Failed(e.to_string()))?;
+            self.released.recv().await.map_err(|e| zbus::fdo::Error::Failed(e.to_string()))?;
+            OwnedValue::try_from(Value::Value(Box::new(Value::U32(2)))).map_err(|e| zbus::fdo::Error::Failed(e.to_string()))
+        }
+    }
+    let mut daemon = Daemon(
+        Command::new("dbus-daemon")
+            .args(["--session", "--nofork", "--print-address=1"])
+            .arg(format!("--address=unix:abstract=craft-appearance-test-{}", std::process::id()))
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()?,
+    );
+    let mut address = String::new();
+    std::io::BufReader::new(daemon.0.stdout.take().ok_or("no daemon stdout")?).read_line(&mut address)?;
+    let (captured, seen) = std::sync::mpsc::channel();
+    let (release, released) = async_channel::bounded(1);
+    let server = futures_lite::future::block_on(
+        zbus::connection::Builder::address(address.trim())?.name(DEST)?.serve_at(PATH, Settings { captured, released })?.build(),
+    )?;
+    let client = futures_lite::future::block_on(zbus::connection::Builder::address(address.trim())?.build())?;
+    let (woke, wakes) = std::sync::mpsc::channel();
+    let tracker = Watcher::spawn(
+        true,
+        move || {
+            let _ = woke.send(());
+        },
+        move |shared| async move {
+            let _ = watch_connection(&shared, &mut true, &mut false, client).await;
+        },
+    )
+    .ok_or("could not start observer")?;
+    seen.recv_timeout(Duration::from_secs(2))?;
+    futures_lite::future::block_on(server.emit_signal(None::<&str>, PATH, IFACE, "SettingChanged", &(STANDARD, KEY, OwnedValue::from(1u32))))?;
+    release.send_blocking(())?;
+    wakes.recv_timeout(Duration::from_secs(2))?;
+    wakes.recv_timeout(Duration::from_secs(2))?;
+    assert_eq!(tracker.current(), Some(Theme::Dark));
+    // A malformed update must not clear the valid value or cause a wake.
+    futures_lite::future::block_on(server.emit_signal(None::<&str>, PATH, IFACE, "SettingChanged", &(STANDARD, KEY, OwnedValue::from(true))))?;
+    assert!(wakes.recv_timeout(Duration::from_millis(50)).is_err());
+    assert_eq!(tracker.current(), Some(Theme::Dark));
+    let before = std::time::Instant::now();
+    drop(tracker);
+    assert!(before.elapsed() < Duration::from_secs(1));
+    // Drop also cancels a backend that has entered Read and never replies.
+    let client = futures_lite::future::block_on(zbus::connection::Builder::address(address.trim())?.build())?;
+    let pending = Watcher::spawn(
+        true,
+        || {},
+        move |shared| async move {
+            let _ = watch_connection(&shared, &mut true, &mut false, client).await;
+        },
+    )
+    .ok_or("could not start pending-read observer")?;
+    seen.recv_timeout(Duration::from_secs(2))?;
+    let before = std::time::Instant::now();
+    drop(pending);
+    assert!(before.elapsed() < Duration::from_secs(1));
+    // A newly available portal uses ReadOne, and a replacement owner must trigger a reread.
+    futures_lite::future::block_on(server.release_name(DEST))?;
+    struct ModernSettings(u32);
+    #[zbus::interface(name = "org.freedesktop.portal.Settings")]
+    impl ModernSettings {
+        fn read_one(&self, namespace: &str, _key: &str) -> zbus::fdo::Result<OwnedValue> {
+            if namespace == STANDARD { Ok(OwnedValue::from(self.0)) } else { Err(zbus::fdo::Error::InvalidArgs("unknown namespace".into())) }
+        }
+    }
+    let client = futures_lite::future::block_on(zbus::connection::Builder::address(address.trim())?.build())?;
+    let (woke, wakes) = std::sync::mpsc::channel();
+    let (attempted, attempts) = std::sync::mpsc::channel();
+    let tracker = Watcher::spawn(
+        true,
+        move || {
+            let _ = woke.send(());
+        },
+        move |shared| async move {
+            // The production observer repeats this session after its bounded reconnect backoff.
+            loop {
+                let _ = watch_connection(&shared, &mut true, &mut false, client.clone()).await;
+                let _ = attempted.send(());
+                async_io::Timer::after(Duration::from_millis(10)).await;
+            }
+        },
+    )
+    .ok_or("could not start modern observer")?;
+    attempts.recv_timeout(Duration::from_secs(2))?;
+    let modern =
+        futures_lite::future::block_on(zbus::connection::Builder::address(address.trim())?.name(DEST)?.serve_at(PATH, ModernSettings(2))?.build())?;
+
+    wakes.recv_timeout(Duration::from_secs(2))?;
+    assert_eq!(tracker.current(), Some(Theme::Light));
+    futures_lite::future::block_on(modern.release_name(DEST))?;
+    let replacement =
+        futures_lite::future::block_on(zbus::connection::Builder::address(address.trim())?.name(DEST)?.serve_at(PATH, ModernSettings(1))?.build())?;
+    wakes.recv_timeout(Duration::from_secs(2))?;
+    assert_eq!(tracker.current(), Some(Theme::Dark));
+    futures_lite::future::block_on(replacement.emit_signal(None::<&str>, PATH, IFACE, "SettingChanged", &(STANDARD, KEY, OwnedValue::from(0u32))))?;
+    wakes.recv_timeout(Duration::from_secs(2))?;
+    assert_eq!(tracker.current(), None);
+    // GNOME's string schema fills the empty standard preference. Manual mode still caches it,
+    // and opting back into System sees that latest cache without a redundant wake.
+    tracker.set_active(false);
+    futures_lite::future::block_on(replacement.emit_signal(None::<&str>, PATH, IFACE, "SettingChanged", &(GNOME, KEY, Value::from("prefer-dark"))))?;
+    let deadline = std::time::Instant::now() + Duration::from_secs(2);
+    while tracker.current() != Some(Theme::Dark) {
+        assert!(std::time::Instant::now() < deadline, "GNOME change was not cached");
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    assert!(matches!(wakes.try_recv(), Err(std::sync::mpsc::TryRecvError::Empty)));
+    tracker.set_active(true);
+    assert_eq!(tracker.current(), Some(Theme::Dark));
+    assert!(matches!(wakes.try_recv(), Err(std::sync::mpsc::TryRecvError::Empty)));
+    futures_lite::future::block_on(replacement.emit_signal(None::<&str>, PATH, IFACE, "SettingChanged", &(GNOME, KEY, Value::from("default"))))?;
+    wakes.recv_timeout(Duration::from_secs(2))?;
+    assert_eq!(tracker.current(), None);
+    drop(tracker);
+    Ok(())
+}
diff --git c/integration/craft-platform/src/browser.rs w/integration/craft-platform/src/browser.rs
new file mode 100644
index 0000000..3369970
--- /dev/null
+++ w/integration/craft-platform/src/browser.rs
@@ -0,0 +1,90 @@
+//! Browser downloads. Caller owns MIME/name decisions and pacing; this module owns resource cleanup.
+pub mod host;
+use wasm_bindgen::{JsCast, JsValue, closure::Closure};
+use web_sys::{Blob, BlobPropertyBag, HtmlAnchorElement, Url, Window};
+
+/// Object-URL lifetime for a requested download; the default is 60 seconds.
+#[derive(Clone, Copy, Debug)]
+pub struct DownloadOptions {
+    /// Positive delay in milliseconds before cleanup; nonpositive values reject the click.
+    pub revoke_after_ms: i32,
+}
+impl Default for DownloadOptions {
+    fn default() -> Self {
+        Self { revoke_after_ms: 60_000 }
+    }
+}
+
+/// Prepared DOM link and object URL. Dropping without clicking cleans both up.
+/// Preparation can occur before an app's download pacer yields.
+pub struct PreparedDownload {
+    window: Window,
+    anchor: HtmlAnchorElement,
+    url: Option<String>,
+}
+impl PreparedDownload {
+    /// Prepare an owned Blob and hidden link using the caller's bytes, MIME and filename.
+    /// No download is requested until [`Self::click`]; browser setup failures return an error.
+    pub fn bytes(name: &str, mime: &str, bytes: &[u8]) -> Result<Self, JsValue> {
+        let parts = js_sys::Array::of1(&js_sys::Uint8Array::from(bytes));
+        let options = BlobPropertyBag::new();
+        options.set_type(mime);
+        Self::blob(name, &Blob::new_with_u8_array_sequence_and_options(&parts, &options)?)
+    }
+    /// Prepare a hidden link and owned object URL for an existing Blob.
+    /// Blank filenames, missing browser DOM and setup failures return an error.
+    pub fn blob(name: &str, blob: &Blob) -> Result<Self, JsValue> {
+        if name.trim().is_empty() {
+            return Err(JsValue::from_str("a file name is required"));
+        }
+        let window = web_sys::window().ok_or_else(|| JsValue::from_str("no browser window"))?;
+        let document = window.document().ok_or_else(|| JsValue::from_str("no browser document"))?;
+        document.body().ok_or_else(|| JsValue::from_str("the page has no body"))?;
+        let anchor = document.create_element("a")?.dyn_into::<HtmlAnchorElement>()?;
+        anchor.set_download(name);
+        anchor.set_attribute("style", "display:none")?;
+        let download = Self { window, anchor, url: Some(Url::create_object_url_with_blob(blob)?) };
+        if let Some(url) = &download.url {
+            download.anchor.set_href(url);
+        }
+        Ok(download)
+    }
+    /// Register cleanup before clicking: a timer failure returns an error without triggering
+    /// a partial download. Success only means a click was issued; browser acceptance is unobservable.
+    pub fn click(mut self, options: DownloadOptions) -> Result<(), JsValue> {
+        if options.revoke_after_ms <= 0 {
+            return Err(JsValue::from_str("download lifetime must be positive"));
+        }
+        let Some(url) = self.url.as_ref().cloned() else {
+            return Err(JsValue::from_str("download has no object URL"));
+        };
+        let body = self.window.document().and_then(|d| d.body()).ok_or_else(|| JsValue::from_str("the page has no body"))?;
+        body.append_child(&self.anchor)?;
+        let revoke = Closure::once(move || {
+            let _ = Url::revoke_object_url(&url);
+        });
+        self.window.set_timeout_with_callback_and_timeout_and_arguments_0(revoke.as_ref().unchecked_ref(), options.revoke_after_ms)?;
+        revoke.forget(); // Ownership transfers only after successful timer registration.
+        self.url = None;
+        self.anchor.click();
+        Ok(())
+    }
+}
+impl Drop for PreparedDownload {
+    fn drop(&mut self) {
+        self.anchor.remove();
+        if let Some(url) = self.url.take() {
+            let _ = Url::revoke_object_url(&url);
+        }
+    }
+}
+/// Prepare bytes and request a download with the specified URL lifetime.
+/// Success means the click was issued, not that the browser accepted or saved the file.
+pub fn download_bytes(name: &str, mime: &str, bytes: &[u8], options: DownloadOptions) -> Result<(), JsValue> {
+    PreparedDownload::bytes(name, mime, bytes)?.click(options)
+}
+/// Prepare a Blob and request a download with the specified URL lifetime.
+/// Setup or scheduling failures clean up owned resources and return an error.
+pub fn download_blob(name: &str, blob: &Blob, options: DownloadOptions) -> Result<(), JsValue> {
+    PreparedDownload::blob(name, blob)?.click(options)
+}
diff --git c/integration/craft-platform/src/browser/host.rs w/integration/craft-platform/src/browser/host.rs
new file mode 100644
index 0000000..52b53e0
--- /dev/null
+++ w/integration/craft-platform/src/browser/host.rs
@@ -0,0 +1,442 @@
+//! Same-origin iframe transport for the common Craft host protocol.
+use js_sys::{Array, Object, Reflect, Uint8Array};
+use std::{cell::RefCell, collections::HashMap, rc::Rc};
+use wasm_bindgen::{JsCast, JsValue, closure::Closure};
+use web_sys::{EventTarget, MessageEvent, Window};
+
+use crate::host_protocol::{OpenAdmission, SaveTicket, accepts_parent_message};
+
+const MAX_OPEN_BYTES: usize = 256 * 1024 * 1024;
+const MAX_TYPE_UTF16_UNITS: u32 = 128;
+const MAX_NAME_UTF16_UNITS: u32 = 1024;
+const MAX_TICKET_UTF16_UNITS: u32 = 256;
+const MAX_ERROR_UTF16_UNITS: u32 = 4096;
+
+thread_local! {
+    static OPEN_ADMISSIONS: RefCell<HashMap<(String, String), Rc<RefCell<OpenAdmission>>>> =
+        RefCell::new(HashMap::new());
+}
+
+/// Messages received from the parent host.
+pub enum HostMessage {
+    Open {
+        name: String,
+        bytes: Vec<u8>,
+    },
+    SaveResult {
+        ticket: SaveTicket,
+        ok: bool,
+        error: Option<String>,
+    },
+}
+
+/// Correlation for one parsed native document. These strings are not credentials.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct DocumentIdentity {
+    pub open_id: String,
+    pub document_id: String,
+}
+
+/// Strict protocol used only by identity-aware WordCraft/GridCraft adapters.
+pub enum IdentityHostMessage {
+    Open { open_id: String, name: String, bytes: Vec<u8> },
+    SaveResult { identity: DocumentIdentity, ticket: SaveTicket, ok: bool, error: Option<String> },
+}
+
+/// Same-origin parent window transport for one named Craft app.
+#[derive(Clone)]
+pub struct HostTransport {
+    parent: Window,
+    origin: String,
+    app: String,
+    open_admission: Rc<RefCell<OpenAdmission>>,
+}
+
+impl HostTransport {
+    /// Return a transport only when this page is framed by a same-origin parent.
+    pub fn current(app: &str) -> Result<Option<Self>, JsValue> {
+        let Some(window) = web_sys::window() else {
+            return Ok(None);
+        };
+        let Some(parent) = window.parent()? else {
+            return Ok(None);
+        };
+        if Object::is(parent.as_ref(), window.as_ref()) {
+            return Ok(None);
+        }
+        let origin = window.location().origin()?;
+        if origin.is_empty() || app.trim().is_empty() || parent.location().origin()? != origin {
+            return Ok(None);
+        }
+        let open_admission = shared_open_admission(&origin, app);
+        Ok(Some(Self {
+            parent,
+            origin,
+            app: app.to_owned(),
+            open_admission,
+        }))
+    }
+
+    /// Listen for parent messages. Exact origin and `event.source` are both checked.
+    /// Open bytes are admitted within a cumulative per-app runtime budget before copying.
+    pub fn listen(
+        &self,
+        mut callback: impl FnMut(HostMessage) + 'static,
+    ) -> Result<HostListener, JsValue> {
+        let window = web_sys::window().ok_or_else(|| JsValue::from_str("no browser window"))?;
+        let parent: JsValue = self.parent.clone().into();
+        let origin = self.origin.clone();
+        let app = self.app.clone();
+        let open_admission = self.open_admission.clone();
+        let handler = Closure::<dyn FnMut(MessageEvent)>::new(move |event: MessageEvent| {
+            let source_is_parent = event
+                .source()
+                .is_some_and(|source| Object::is(source.as_ref(), &parent));
+            if !accepts_parent_message(&event.origin(), &origin, source_is_parent) {
+                return;
+            }
+            let data = event.data();
+            let Ok(kind) = string_field(&data, "type", MAX_TYPE_UTF16_UNITS) else {
+                return;
+            };
+            if kind == format!("{app}:open") {
+                let Ok(name) = string_field(&data, "name", MAX_NAME_UTF16_UNITS) else {
+                    return;
+                };
+                let Ok(value) = Reflect::get(&data, &JsValue::from_str("bytes")) else {
+                    return;
+                };
+                let Some(length) = bytes_len(&value).filter(|length| *length <= MAX_OPEN_BYTES)
+                else {
+                    return;
+                };
+                if !open_admission.borrow_mut().admit(length, MAX_OPEN_BYTES) {
+                    return;
+                }
+                let Some(bytes) = read_bytes(&value, MAX_OPEN_BYTES) else {
+                    return;
+                };
+                callback(HostMessage::Open { name, bytes });
+            } else if kind == format!("{app}:saveResult") {
+                if let Some(message) = parse_save_result(&data) {
+                    callback(message);
+                }
+            }
+        });
+        window.add_event_listener_with_callback("message", handler.as_ref().unchecked_ref())?;
+        Ok(HostListener {
+            target: window.unchecked_into(),
+            handler: Some(handler),
+        })
+    }
+
+    /// Notify the parent that the editor bridge is ready.
+    pub fn post_ready(&self, version: &str) -> Result<(), JsValue> {
+        self.post(
+            &format!("{}:ready", self.app),
+            &[(&"version", &JsValue::from_str(version))],
+        )
+    }
+
+    /// Report editor dirty state.
+    pub fn post_dirty(&self, dirty: bool) -> Result<(), JsValue> {
+        self.post(
+            &format!("{}:dirty", self.app),
+            &[(&"dirty", &JsValue::from_bool(dirty))],
+        )
+    }
+
+    /// Send a failure that is not tied to a save ticket.
+    pub fn post_failed(&self, error: &str) -> Result<(), JsValue> {
+        self.post(
+            &format!("{}:failed", self.app),
+            &[(&"error", &JsValue::from_str(error))],
+        )
+    }
+
+    /// Ask the parent for a file after the user invokes the app's Open command.
+    pub fn post_open_request(&self, purpose: &str) -> Result<(), JsValue> {
+        self.post(
+            &format!("{}:openRequest", self.app),
+            &[("purpose", &JsValue::from_str(purpose))],
+        )
+    }
+
+    /// Ask the parent to open a file. App-specific name and byte policy stays with the app.
+    pub fn post_open(&self, name: &str, bytes: &[u8]) -> Result<(), JsValue> {
+        let object = self.message(&format!("{}:open", self.app));
+        Reflect::set(&object, &"name".into(), &name.into())?;
+        let buffer = Uint8Array::from(bytes).buffer();
+        Reflect::set(&object, &"bytes".into(), &buffer)?;
+        self.parent
+            .post_message_with_transfer(&object, &self.origin, &Array::of1(&buffer))
+    }
+
+    /// Send serialized bytes with an opaque ticket. This means delivered to the parent only;
+    /// the host must send a later `saveResult` after durable storage confirms the write.
+    pub fn post_save(
+        &self,
+        ticket: &SaveTicket,
+        name: &str,
+        bytes: &[u8],
+        save_as: bool,
+    ) -> Result<(), JsValue> {
+        let object = self.message(&format!("{}:save", self.app));
+        Reflect::set(&object, &"ticket".into(), &ticket.as_str().into())?;
+        Reflect::set(&object, &"name".into(), &name.into())?;
+        let buffer = Uint8Array::from(bytes).buffer();
+        Reflect::set(&object, &"bytes".into(), &buffer)?;
+        Reflect::set(&object, &"saveAs".into(), &save_as.into())?;
+        self.parent
+            .post_message_with_transfer(&object, &self.origin, &Array::of1(&buffer))
+    }
+
+    /// No fallback to the legacy listener: an old host cannot open a writable document.
+    /// Only one initial open is admitted, including when parsing that open later fails.
+    pub fn listen_identity(
+        &self,
+        mut callback: impl FnMut(IdentityHostMessage) + 'static,
+    ) -> Result<HostListener, JsValue> {
+        let window = web_sys::window().ok_or_else(|| JsValue::from_str("no browser window"))?;
+        let transport = self.clone();
+        let mut received_open = false;
+        let handler = Closure::<dyn FnMut(MessageEvent)>::new(move |event: MessageEvent| {
+            let source_is_parent = event.source().is_some_and(|source|
+                Object::is(source.as_ref(), transport.parent.as_ref()));
+            if !accepts_parent_message(&event.origin(), &transport.origin, source_is_parent) { return; }
+            let data = event.data();
+            let Ok(kind) = string_field(&data, "type", MAX_TYPE_UTF16_UNITS) else { return; };
+            if kind == format!("{}:open", transport.app) {
+                if received_open { return; }
+                if Reflect::get(&data, &"saveIdentity".into()).ok().and_then(|v| v.as_f64()) != Some(1.0)
+                    || string_field(&data, "mode", 32).ok().as_deref() != Some("update-only") { return; }
+                let Some(open_id) = identity_field(&data, "openId") else { return; };
+                let Ok(name) = string_field(&data, "name", MAX_NAME_UTF16_UNITS) else { return; };
+                let Ok(value) = Reflect::get(&data, &"bytes".into()) else { return; };
+                let Some(length) = bytes_len(&value).filter(|n| *n <= MAX_OPEN_BYTES) else { return; };
+                if !transport.open_admission.borrow_mut().admit(length, MAX_OPEN_BYTES) { return; }
+                received_open = true;
+                let Some(bytes) = read_bytes(&value, MAX_OPEN_BYTES) else { return; };
+                callback(IdentityHostMessage::Open { open_id, name, bytes });
+            } else if kind == format!("{}:saveResult", transport.app) {
+                let Some(open_id) = identity_field(&data, "openId") else { return; };
+                let Some(document_id) = identity_field(&data, "documentId") else { return; };
+                if let Some(HostMessage::SaveResult { ticket, ok, error }) = parse_save_result(&data) {
+                    callback(IdentityHostMessage::SaveResult {
+                        identity: DocumentIdentity { open_id, document_id }, ticket, ok, error,
+                    });
+                }
+            }
+        });
+        window.add_event_listener_with_callback("message", handler.as_ref().unchecked_ref())?;
+        Ok(HostListener { target: window.unchecked_into(), handler: Some(handler) })
+    }
+
+    pub fn post_identity_ready(&self, version: &str) -> Result<(), JsValue> {
+        self.post(&format!("{}:ready", self.app), &[
+            ("version", &JsValue::from_str(version)), ("saveIdentity", &JsValue::from_f64(1.0)),
+        ])
+    }
+
+    /// Call only after the trusted initial file parsed and the native identity was captured.
+    pub fn post_opened(&self, identity: &DocumentIdentity) -> Result<(), JsValue> {
+        self.post(&format!("{}:opened", self.app), &[
+            ("openId", &identity.open_id.as_str().into()),
+            ("documentId", &identity.document_id.as_str().into()),
+        ])
+    }
+
+    pub fn post_identity_save(&self, identity: &DocumentIdentity, ticket: &SaveTicket,
+        name: &str, bytes: &[u8]) -> Result<(), JsValue> {
+        if bytes.len() > MAX_OPEN_BYTES { return Err(JsValue::from_str("save exceeds size limit")); }
+        let object = self.message(&format!("{}:save", self.app));
+        Reflect::set(&object, &"openId".into(), &identity.open_id.as_str().into())?;
+        Reflect::set(&object, &"documentId".into(), &identity.document_id.as_str().into())?;
+        Reflect::set(&object, &"intent".into(), &"save".into())?;
+        Reflect::set(&object, &"ticket".into(), &ticket.as_str().into())?;
+        Reflect::set(&object, &"name".into(), &name.into())?;
+        let buffer = Uint8Array::from(bytes).buffer();
+        Reflect::set(&object, &"bytes".into(), &buffer)?;
+        self.parent.post_message_with_transfer(&object, &self.origin, &Array::of1(&buffer))
+    }
+
+    /// A clean acknowledgement includes the successful ticket, so an unrelated clean event
+    /// cannot confirm a durable write. Initial clean state has no ticket.
+    pub fn post_identity_dirty(&self, identity: &DocumentIdentity, dirty: bool,
+        ticket: Option<&SaveTicket>) -> Result<(), JsValue> {
+        let object = self.message(&format!("{}:dirty", self.app));
+        Reflect::set(&object, &"openId".into(), &identity.open_id.as_str().into())?;
+        Reflect::set(&object, &"documentId".into(), &identity.document_id.as_str().into())?;
+        Reflect::set(&object, &"dirty".into(), &dirty.into())?;
+        if let Some(ticket) = ticket { Reflect::set(&object, &"ticket".into(), &ticket.as_str().into())?; }
+        self.parent.post_message(&object, &self.origin)
+    }
+
+    fn post(&self, kind: &str, fields: &[(&str, &JsValue)]) -> Result<(), JsValue> {
+        let object = self.message(kind);
+        for (key, value) in fields {
+            Reflect::set(&object, &JsValue::from_str(key), value)?;
+        }
+        self.parent.post_message(&object, &self.origin)
+    }
+
+    fn message(&self, kind: &str) -> Object {
+        let object = Object::new();
+        let _ = Reflect::set(&object, &"type".into(), &kind.into());
+        object
+    }
+}
+
+fn shared_open_admission(origin: &str, app: &str) -> Rc<RefCell<OpenAdmission>> {
+    OPEN_ADMISSIONS.with(|admissions| {
+        let mut admissions = admissions.borrow_mut();
+        let key = (origin.to_owned(), app.to_owned());
+        Rc::clone(
+            admissions
+                .entry(key)
+                .or_insert_with(|| Rc::new(RefCell::new(OpenAdmission::default()))),
+        )
+    })
+}
+
+/// Owns and removes the global message listener on drop.
+pub struct HostListener {
+    target: EventTarget,
+    handler: Option<Closure<dyn FnMut(MessageEvent)>>,
+}
+impl Drop for HostListener {
+    fn drop(&mut self) {
+        if let Some(handler) = self.handler.take() {
+            let _ = self
+                .target
+                .remove_event_listener_with_callback("message", handler.as_ref().unchecked_ref());
+        }
+    }
+}
+
+fn string_field(value: &JsValue, key: &str, max_utf16_units: u32) -> Result<String, JsValue> {
+    let field = Reflect::get(value, &JsValue::from_str(key))?;
+    let Some(field) = field.dyn_ref::<js_sys::JsString>() else {
+        return Err(JsValue::from_str("expected string field"));
+    };
+    if field.length() > max_utf16_units {
+        return Err(JsValue::from_str("string field exceeds size limit"));
+    }
+    field
+        .as_string()
+        .ok_or_else(|| JsValue::from_str("expected string field"))
+}
+
+fn identity_field(value: &JsValue, key: &str) -> Option<String> {
+    string_field(value, key, 128).ok().filter(|s| !s.trim().is_empty())
+}
+
+fn bytes_len(value: &JsValue) -> Option<usize> {
+    if let Some(array) = value.dyn_ref::<Uint8Array>() {
+        Some(array.length() as usize)
+    } else if let Some(buffer) = value.dyn_ref::<js_sys::ArrayBuffer>() {
+        Some(buffer.byte_length() as usize)
+    } else {
+        None
+    }
+}
+
+fn read_bytes(value: &JsValue, max_bytes: usize) -> Option<Vec<u8>> {
+    let length = bytes_len(value)?;
+    if length > max_bytes {
+        return None;
+    }
+    if let Some(array) = value.dyn_ref::<Uint8Array>() {
+        Some(array.to_vec())
+    } else if value.is_instance_of::<js_sys::ArrayBuffer>() {
+        Some(Uint8Array::new(value).to_vec())
+    } else {
+        None
+    }
+}
+
+fn parse_save_result(data: &JsValue) -> Option<HostMessage> {
+    let ticket_value = string_field(data, "ticket", MAX_TICKET_UTF16_UNITS).ok()?;
+    let ticket = SaveTicket::new(ticket_value)?;
+    let ok = Reflect::get(data, &JsValue::from_str("ok"))
+        .ok()?
+        .as_bool()?;
+    let error = string_field(data, "error", MAX_ERROR_UTF16_UNITS).ok();
+    Some(HostMessage::SaveResult { ticket, ok, error })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use wasm_bindgen_test::wasm_bindgen_test;
+
+    #[wasm_bindgen_test]
+    fn separate_transports_share_open_budget_for_same_app_and_origin() {
+        let first = shared_open_admission("https://host.test", "wordcraft");
+        let second = shared_open_admission("https://host.test", "wordcraft");
+        assert!(Rc::ptr_eq(&first, &second));
+        assert!(first.borrow_mut().admit(4, 8));
+        assert!(second.borrow_mut().admit(4, 8));
+        assert!(!first.borrow_mut().admit(1, 8));
+
+        let other_app = shared_open_admission("https://host.test", "gridcraft");
+        assert!(!Rc::ptr_eq(&first, &other_app));
+        assert!(other_app.borrow_mut().admit(8, 8));
+    }
+
+    #[wasm_bindgen_test]
+    fn oversized_arraybuffer_and_typed_array_are_rejected_before_copy() {
+        let buffer = js_sys::ArrayBuffer::new(8);
+        assert!(read_bytes(buffer.as_ref(), 4).is_none());
+
+        let array = Uint8Array::new_with_length(8);
+        assert!(read_bytes(array.as_ref(), 4).is_none());
+        assert_eq!(
+            read_bytes(array.as_ref(), 8).map(|bytes| bytes.len()),
+            Some(8)
+        );
+    }
+
+    #[wasm_bindgen_test]
+    fn oversized_metadata_strings_are_rejected_before_conversion() {
+        let object = Object::new();
+        let long = JsValue::from_str("0123456789");
+        assert!(Reflect::set(&object, &"field".into(), &long).is_ok());
+        assert!(string_field(object.as_ref(), "field", 4).is_err());
+        assert_eq!(
+            string_field(object.as_ref(), "field", 10).ok().as_deref(),
+            Some("0123456789")
+        );
+    }
+
+    #[wasm_bindgen_test]
+    fn malformed_save_result_ack_is_ignored_instead_of_becoming_failure() {
+        for malformed in [
+            JsValue::UNDEFINED,
+            JsValue::NULL,
+            JsValue::from_str("false"),
+            JsValue::from_f64(0.0),
+        ] {
+            let object = Object::new();
+            assert!(
+                Reflect::set(&object, &"ticket".into(), &JsValue::from_str("ticket-1")).is_ok()
+            );
+            assert!(Reflect::set(&object, &"ok".into(), &malformed).is_ok());
+            assert!(parse_save_result(object.as_ref()).is_none());
+        }
+
+        let object = Object::new();
+        assert!(Reflect::set(&object, &"ticket".into(), &JsValue::from_str("ticket-1")).is_ok());
+        assert!(Reflect::set(&object, &"ok".into(), &JsValue::FALSE).is_ok());
+        assert!(matches!(
+            parse_save_result(object.as_ref()),
+            Some(HostMessage::SaveResult { ok: false, .. })
+        ));
+
+        assert!(Reflect::set(&object, &"ok".into(), &JsValue::TRUE).is_ok());
+        assert!(matches!(
+            parse_save_result(object.as_ref()),
+            Some(HostMessage::SaveResult { ok: true, .. })
+        ));
+    }
+}
diff --git c/integration/craft-platform/src/dialog_outcome.rs w/integration/craft-platform/src/dialog_outcome.rs
new file mode 100644
index 0000000..7f67500
--- /dev/null
+++ w/integration/craft-platform/src/dialog_outcome.rs
@@ -0,0 +1,97 @@
+//! Dialog results with evidence: an empty rfd answer does not establish user cancellation.
+/// Host assessment of whether a native backend is available; unknown is not proven absence.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Capability {
+    /// The host has confirmed that a backend is available.
+    Available,
+    /// Proven backend absence, with a diagnostic suitable for the host.
+    Unavailable(String),
+    /// Inconclusive capability evidence; the host should still permit a picker attempt.
+    Unknown(String),
+}
+/// The layer that prevented a dialog request from completing.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ErrorKind {
+    /// The host proved that no backend is available.
+    Unavailable,
+    /// Request transport or background execution failed.
+    Worker,
+    /// The picker backend reported or encountered a failure.
+    Backend,
+}
+/// A classified dialog failure with a host-facing diagnostic.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct DialogError {
+    /// The failing layer.
+    pub kind: ErrorKind,
+    /// Diagnostic text for the host to present or log.
+    pub message: String,
+}
+impl DialogError {
+    /// Construct a failure without inferring cancellation from the diagnostic.
+    pub fn new(kind: ErrorKind, message: impl Into<String>) -> Self {
+        Self { kind, message: message.into() }
+    }
+}
+impl std::fmt::Display for DialogError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(&self.message)
+    }
+}
+impl std::error::Error for DialogError {}
+/// Selection, explicit cancellation, failure, or an answer whose cause is unknown.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Outcome<T> {
+    /// A value returned by the picker.
+    Selected(T),
+    /// Explicit app/backend cancellation; never inferred from rfd's empty answer.
+    Cancelled,
+    /// A transport, capability or backend failure.
+    Failed(DialogError),
+    /// No selection; rfd cannot say whether the user cancelled or its backend failed.
+    Indeterminate,
+}
+impl<T> Outcome<T> {
+    /// Preserve a selection; an empty rfd answer is indeterminate, never proven cancellation.
+    pub fn from_rfd(value: Option<T>) -> Self {
+        value.map_or(Self::Indeterminate, Self::Selected)
+    }
+    /// Transform only a selected value, preserving all other outcomes unchanged.
+    pub fn map<U>(self, map: impl FnOnce(T) -> U) -> Outcome<U> {
+        match self {
+            Self::Selected(value) => Outcome::Selected(map(value)),
+            Self::Cancelled => Outcome::Cancelled,
+            Self::Failed(error) => Outcome::Failed(error),
+            Self::Indeterminate => Outcome::Indeterminate,
+        }
+    }
+    /// Construct a backend failure with the supplied diagnostic.
+    pub fn failed(message: impl Into<String>) -> Self {
+        Self::Failed(DialogError::new(ErrorKind::Backend, message))
+    }
+}
+impl<T> Outcome<Vec<T>> {
+    /// Treat missing and empty multi-selection answers as indeterminate.
+    pub fn from_rfd_files(value: Option<Vec<T>>) -> Self {
+        Self::from_rfd(value.filter(|paths| !paths.is_empty()))
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn missing_and_empty_rfd_answers_never_establish_cancellation() {
+        assert_eq!(Outcome::<String>::from_rfd(None), Outcome::Indeterminate);
+        assert_eq!(Outcome::<Vec<String>>::from_rfd_files(Some(Vec::new())), Outcome::Indeterminate);
+        assert_eq!(Outcome::from_rfd_files(Some(vec!["a"])), Outcome::Selected(vec!["a"]));
+        for _capability in [Capability::Available, Capability::Unavailable("missing".into()), Capability::Unknown("timeout".into())] {
+            assert_eq!(Outcome::<String>::from_rfd(None), Outcome::Indeterminate);
+        }
+    }
+    #[test]
+    fn mapping_preserves_explicit_cancellation_and_failure() {
+        assert_eq!(Outcome::<u8>::Cancelled.map(u32::from), Outcome::Cancelled);
+        assert_eq!(Outcome::<u8>::failed("worker stopped").map(u32::from), Outcome::failed("worker stopped"));
+        assert_eq!(Outcome::Selected(7_u8).map(u32::from), Outcome::Selected(7));
+    }
+}
diff --git c/integration/craft-platform/src/dialogs.rs w/integration/craft-platform/src/dialogs.rs
new file mode 100644
index 0000000..b09c66b
--- /dev/null
+++ w/integration/craft-platform/src/dialogs.rs
@@ -0,0 +1,258 @@
+//! UI-thread picker creation with reserved waiting workers. No backend or application policy.
+//!
+//! `create` must call the native picker method eagerly on the event-loop thread, returning its
+//! already-created future. Hosts retain the parent through transport AND their continuation.
+//! A missing backend answer is indeterminate; only explicit backend evidence proves cancellation.
+use crate::dialog_outcome::{DialogError, ErrorKind, Outcome};
+use std::{
+    future::Future,
+    pin::Pin,
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+        mpsc::{self, Receiver, Sender, SyncSender, TryRecvError},
+    },
+    thread::JoinHandle,
+};
+/// An already-created native picker future that a reserved worker can wait on.
+pub type DialogFuture<T> = Pin<Box<dyn Future<Output = Outcome<T>> + Send>>;
+
+/// Wait for a future without polling an idle native dialog.
+pub fn block_on<T>(future: impl Future<Output = T>) -> T {
+    struct Unpark(std::thread::Thread);
+    impl std::task::Wake for Unpark {
+        fn wake(self: Arc<Self>) {
+            self.0.unpark();
+        }
+    }
+    let waker = std::task::Waker::from(Arc::new(Unpark(std::thread::current())));
+    let mut context = std::task::Context::from_waker(&waker);
+    let mut future = std::pin::pin!(future);
+    loop {
+        if let std::task::Poll::Ready(value) = future.as_mut().poll(&mut context) {
+            return value;
+        }
+        std::thread::park();
+    }
+}
+// Notification callbacks must not unwind a reserved worker after the UI observes readiness.
+fn notify(wake: &dyn Fn()) {
+    let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(wake));
+}
+fn worker_error(message: impl Into<String>) -> DialogError {
+    DialogError::new(ErrorKind::Worker, message)
+}
+fn guarded<T>(f: impl FnOnce() -> Outcome<T>) -> Outcome<T> {
+    std::panic::catch_unwind(std::panic::AssertUnwindSafe(f)).unwrap_or_else(|_| Outcome::Failed(worker_error("The file-dialog backend failed")))
+}
+/// Reserve the worker before opening a native sheet. A failed reservation never calls `create`.
+/// No timeout is imposed on a live picker. Backend constructor/poll panics become explicit failures.
+pub fn wait_prepared<T: Send + 'static, F: Future<Output = Outcome<T>> + Send + 'static>(
+    create: impl FnOnce() -> F,
+    deliver: impl FnOnce(Outcome<T>) + Send + 'static,
+) -> std::io::Result<JoinHandle<()>> {
+    let (send, receive) = mpsc::channel::<F>();
+    let worker = std::thread::Builder::new().name("file-dialog".into()).spawn(move || {
+        deliver(guarded(|| match receive.recv() {
+            Ok(future) => block_on(future),
+            Err(_) => Outcome::Failed(worker_error("The file-dialog factory failed")),
+        }));
+    })?;
+    if let Ok(future) = std::panic::catch_unwind(std::panic::AssertUnwindSafe(create)) {
+        send.send(future).map_err(|_| std::io::Error::other("The reserved file-dialog worker stopped"))?;
+    }
+    Ok(worker)
+}
+
+type Job<R, T> = (R, Sender<Outcome<T>>);
+/// Clonable request endpoint. At most one queued, preparing or live request is accepted.
+pub struct DialogClient<R, T> {
+    sender: SyncSender<Job<R, T>>,
+    busy: Arc<AtomicBool>,
+    wake: Arc<dyn Fn() + Send + Sync>,
+}
+impl<R, T> Clone for DialogClient<R, T> {
+    fn clone(&self) -> Self {
+        Self { sender: self.sender.clone(), busy: self.busy.clone(), wake: self.wake.clone() }
+    }
+}
+impl<R, T> DialogClient<R, T> {
+    /// Queue a request without blocking and wake the host to pump it.
+    /// A busy or unavailable host answers with a worker failure; no second picker is opened.
+    pub fn request(&self, request: R) -> Receiver<Outcome<T>> {
+        let (answer, receive) = mpsc::channel();
+        if self.busy.compare_exchange(false, true, Ordering::SeqCst, Ordering::SeqCst).is_err() {
+            let _ = answer.send(Outcome::Failed(worker_error("A file dialog is already pending")));
+        } else if let Err(error) = self.sender.try_send((request, answer)) {
+            self.busy.store(false, Ordering::SeqCst);
+            let (_, answer) = match error {
+                mpsc::TrySendError::Full(job) | mpsc::TrySendError::Disconnected(job) => job,
+            };
+            let _ = answer.send(Outcome::Failed(worker_error("The file-dialog host is unavailable")));
+        }
+        notify(self.wake.as_ref());
+        receive
+    }
+}
+struct Preparing<R, T> {
+    request: R,
+    ready: Receiver<()>,
+    send: Sender<DialogFuture<T>>,
+    completion: Completion<T>,
+}
+struct Completion<T> {
+    done: Receiver<Outcome<T>>,
+    answer: Sender<Outcome<T>>,
+}
+impl<T> Completion<T> {
+    fn poll(&self) -> Option<Outcome<T>> {
+        match self.done.try_recv() {
+            Ok(outcome) => Some(outcome),
+            Err(TryRecvError::Empty) => None,
+            Err(TryRecvError::Disconnected) => Some(Outcome::Failed(worker_error("The file-dialog worker stopped without an answer"))),
+        }
+    }
+}
+enum State<R, T> {
+    Preparing(Preparing<R, T>),
+    Waiting(Completion<T>),
+}
+/// Event-loop-owned transport. Dropping a reply does not release a live picker or its parent.
+/// `pump` must run before consuming replies, and after app code that may enqueue a request.
+/// The host must retain this service/window while `pending()` or its own continuation is pending.
+pub struct NativeDialogs<R, T> {
+    queue: Receiver<Job<R, T>>,
+    busy: Arc<AtomicBool>,
+    state: Option<State<R, T>>,
+    wake: Arc<dyn Fn() + Send + Sync>,
+    check: Arc<dyn Fn() -> Result<(), DialogError> + Send + Sync>,
+}
+impl<R, T: Send + 'static> NativeDialogs<R, T> {
+    /// Create a client and its event-loop-owned service without a backend preflight check.
+    pub fn new(wake: impl Fn() + Send + Sync + 'static) -> (DialogClient<R, T>, Self) {
+        Self::with_preflight(wake, || Ok(()))
+    }
+    /// Optional host-owned advisory check, run on the reserved worker before any picker exists.
+    /// Hosts must bound this check. Unknown capability must permit the actual picker; return an
+    /// Unavailable error only when absence is proven. This service performs no filesystem probes.
+    pub fn with_preflight(
+        wake: impl Fn() + Send + Sync + 'static,
+        check: impl Fn() -> Result<(), DialogError> + Send + Sync + 'static,
+    ) -> (DialogClient<R, T>, Self) {
+        let (sender, queue) = mpsc::sync_channel(1);
+        let busy = Arc::new(AtomicBool::new(false));
+        let wake: Arc<dyn Fn() + Send + Sync> = Arc::new(wake);
+        (DialogClient { sender, busy: busy.clone(), wake: wake.clone() }, Self { queue, busy, state: None, wake, check: Arc::new(check) })
+    }
+    /// Whether a queued, preparing or live picker still owns the transport reservation.
+    pub fn pending(&self) -> bool {
+        self.busy.load(Ordering::SeqCst)
+    }
+    /// Advance requests on the event-loop thread and publish completed replies.
+    /// Call before consuming replies and after enqueuing work. `create` must eagerly open
+    /// the native picker on this thread and return its already-created future.
+    pub fn pump(&mut self, mut create: impl FnMut(R) -> DialogFuture<T>) {
+        if let Some(state) = self.state.take() {
+            match state {
+                State::Waiting(completion) => {
+                    if let Some(outcome) = completion.poll() {
+                        // Only the UI pump publishes replies, after releasing the transport.
+                        // A continuation can therefore immediately request its next picker.
+                        self.busy.store(false, Ordering::SeqCst);
+                        let _ = completion.answer.send(outcome);
+                    } else {
+                        self.state = Some(State::Waiting(completion));
+                    }
+                }
+                State::Preparing(preparing) => {
+                    if let Some(outcome) = preparing.completion.poll() {
+                        self.busy.store(false, Ordering::SeqCst);
+                        let _ = preparing.completion.answer.send(outcome);
+                    } else if preparing.ready.try_recv().is_ok() {
+                        let future = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| create(preparing.request)))
+                            .unwrap_or_else(|_| Box::pin(async { Outcome::Failed(worker_error("The file-dialog factory failed")) }));
+                        let _ = preparing.send.send(future);
+                        self.state = Some(State::Waiting(preparing.completion));
+                    } else {
+                        self.state = Some(State::Preparing(preparing));
+                    }
+                }
+            }
+        }
+        if self.state.is_none()
+            && let Ok((request, answer)) = self.queue.try_recv()
+        {
+            let (ready_send, ready) = mpsc::channel();
+            let (send, receive) = mpsc::channel::<DialogFuture<T>>();
+            let (done_send, done) = mpsc::channel();
+            let check = self.check.clone();
+            let wake = self.wake.clone();
+            let started = std::thread::Builder::new().name("file-dialog".into()).spawn(move || {
+                let output = guarded(|| {
+                    if let Err(error) = check() {
+                        return Outcome::Failed(error);
+                    }
+                    if ready_send.send(()).is_err() {
+                        return Outcome::Failed(worker_error("The file-dialog host stopped"));
+                    }
+                    notify(wake.as_ref());
+                    match receive.recv() {
+                        Ok(future) => block_on(future),
+                        Err(_) => Outcome::Failed(worker_error("The file-dialog host stopped")),
+                    }
+                });
+                let _ = done_send.send(output);
+                notify(wake.as_ref());
+            });
+            match started {
+                Ok(_) => self.state = Some(State::Preparing(Preparing { request, ready, send, completion: Completion { done, answer } })),
+                Err(error) => {
+                    self.busy.store(false, Ordering::SeqCst);
+                    let _ = answer.send(Outcome::Failed(worker_error(error.to_string())));
+                    notify(self.wake.as_ref());
+                }
+            }
+        }
+    }
+}
+/// Holds close intent while a picker/continuation owns the parent. A retry never authorizes
+/// discarding documents: the caller must run its ordinary unsaved-work policy again.
+#[cfg(feature = "egui")]
+#[derive(Default, Debug)]
+pub struct DeferredClose {
+    held: bool,
+}
+#[cfg(feature = "egui")]
+impl DeferredClose {
+    /// Hold actual close requests while a picker or app continuation is pending.
+    /// Return `true` once after settlement so the host retries its unsaved-work policy;
+    /// this never grants permission to discard changes or closes the viewport itself.
+    pub fn update(&mut self, ctx: &egui::Context, pending: bool) -> bool {
+        let outgoing = ctx.viewport(|v| {
+            v.commands
+                .iter()
+                .rev()
+                .find_map(|c| match c {
+                    egui::ViewportCommand::Close => Some(true),
+                    egui::ViewportCommand::CancelClose => Some(false),
+                    _ => None,
+                })
+                .unwrap_or(false)
+        });
+        if pending {
+            let requested = outgoing || ctx.input(|i| i.viewport().close_requested());
+            self.held |= requested;
+            // Every viewport command requests a repaint. An idle native picker must sleep.
+            if requested {
+                ctx.send_viewport_cmd(egui::ViewportCommand::CancelClose);
+            }
+            false
+        } else if std::mem::take(&mut self.held) {
+            ctx.send_viewport_cmd(egui::ViewportCommand::CancelClose);
+            ctx.request_repaint();
+            true
+        } else {
+            false
+        }
+    }
+}
diff --git c/integration/craft-platform/src/host_protocol.rs w/integration/craft-platform/src/host_protocol.rs
new file mode 100644
index 0000000..a43a52b
--- /dev/null
+++ w/integration/craft-platform/src/host_protocol.rs
@@ -0,0 +1,149 @@
+//! Small, app-agnostic pieces of the parent-frame save protocol.
+use std::collections::HashMap;
+
+/// Opaque host correlation token. It is deliberately a string so it is safe across JS runtimes.
+#[derive(Clone, Debug, Eq, Hash, PartialEq)]
+pub struct SaveTicket(String);
+
+impl SaveTicket {
+    /// Construct a non-empty ticket.
+    pub fn new(value: impl Into<String>) -> Option<Self> {
+        let value = value.into();
+        (!value.trim().is_empty() && value.len() <= 256).then_some(Self(value))
+    }
+
+    /// Borrow the wire representation.
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+/// Tracks pending host saves and consumes each acknowledgement at most once.
+#[derive(Debug)]
+pub struct PendingSaves<T> {
+    pending: HashMap<SaveTicket, T>,
+}
+
+impl<T> Default for PendingSaves<T> {
+    fn default() -> Self {
+        Self {
+            pending: HashMap::new(),
+        }
+    }
+}
+
+const MAX_PENDING_SAVES: usize = 64;
+
+/// Bounds total parent-provided document copies in one editor runtime.
+#[derive(Debug, Default)]
+pub struct OpenAdmission {
+    messages: usize,
+    bytes: usize,
+}
+
+const MAX_OPEN_MESSAGES: usize = 64;
+
+impl<T> PendingSaves<T> {
+    pub fn insert(&mut self, ticket: SaveTicket, value: T) -> Result<(), T> {
+        if self.pending.contains_key(&ticket) || self.pending.len() >= MAX_PENDING_SAVES {
+            return Err(value);
+        }
+        self.pending.insert(ticket, value);
+        Ok(())
+    }
+    pub fn complete(&mut self, ticket: &SaveTicket) -> Option<T> {
+        self.pending.remove(ticket)
+    }
+    pub fn len(&self) -> usize {
+        self.pending.len()
+    }
+    pub fn is_empty(&self) -> bool {
+        self.pending.is_empty()
+    }
+    /// Whether any outstanding save carries a matching snapshot or revision.
+    pub fn any(&self, predicate: impl FnMut(&T) -> bool) -> bool {
+        self.pending.values().any(predicate)
+    }
+}
+
+impl OpenAdmission {
+    /// Admit multiple opens within a cumulative byte and message budget.
+    pub fn admit(&mut self, byte_len: usize, max_bytes: usize) -> bool {
+        if self.messages >= MAX_OPEN_MESSAGES || byte_len > max_bytes.saturating_sub(self.bytes) {
+            return false;
+        }
+        self.messages += 1;
+        self.bytes += byte_len;
+        true
+    }
+}
+
+/// True only for a message from the expected origin and actual parent frame.
+pub fn accepts_parent_message(origin: &str, expected_origin: &str, source_is_parent: bool) -> bool {
+    source_is_parent && origin == expected_origin
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn tickets_are_opaque_strings_and_can_exceed_js_safe_integer_range() {
+        let ticket = SaveTicket::new("wordcraft:9007199254740993").expect("non-empty");
+        assert_eq!(ticket.as_str(), "wordcraft:9007199254740993");
+    }
+
+    #[test]
+    fn pending_save_acknowledgement_is_consumed_once() {
+        let ticket = SaveTicket::new("gridcraft:1").expect("non-empty");
+        let mut pending = PendingSaves::default();
+        assert_eq!(pending.insert(ticket.clone(), 42), Ok(()));
+        assert_eq!(pending.complete(&ticket), Some(42));
+        assert_eq!(pending.complete(&ticket), None);
+    }
+
+    #[test]
+    fn pending_saves_are_bounded() {
+        let mut pending = PendingSaves::default();
+        for id in 0..MAX_PENDING_SAVES {
+            let ticket = SaveTicket::new(format!("app:{id}")).expect("non-empty");
+            assert!(pending.insert(ticket, id).is_ok());
+        }
+        let overflow = SaveTicket::new("app:overflow").expect("non-empty");
+        assert!(pending.insert(overflow, 0).is_err());
+    }
+
+    #[test]
+    fn parent_messages_require_exact_origin_and_parent_source() {
+        assert!(accepts_parent_message(
+            "https://host.test",
+            "https://host.test",
+            true
+        ));
+        assert!(!accepts_parent_message(
+            "https://evil.test",
+            "https://host.test",
+            true
+        ));
+        assert!(!accepts_parent_message(
+            "https://host.test",
+            "https://host.test",
+            false
+        ));
+    }
+
+    #[test]
+    fn open_admission_bounds_cumulative_bytes_and_message_count() {
+        let mut admission = OpenAdmission::default();
+        assert!(!admission.admit(9, 8));
+        assert!(admission.admit(4, 8));
+        assert!(admission.admit(4, 8));
+        assert!(!admission.admit(1, 8));
+
+        let mut empty_opens = OpenAdmission::default();
+        for _ in 0..MAX_OPEN_MESSAGES {
+            assert!(empty_opens.admit(0, 8));
+        }
+        assert!(!empty_opens.admit(0, 8));
+    }
+}
