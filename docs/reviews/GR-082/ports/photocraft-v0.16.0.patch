+
+[lints.clippy]
+dbg_macro = "warn"
+todo = "warn"
+
+[features]
+default = []
+dialogs = []
+appearance = ["dep:zbus", "dep:futures-lite", "dep:async-channel", "dep:async-io", "dep:async-process"]
+browser = ["dep:wasm-bindgen", "dep:js-sys", "dep:web-sys"]
