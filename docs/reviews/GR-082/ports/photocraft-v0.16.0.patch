new file mode 100644
index 0000000..ee1334a
--- /dev/null
+++ w/apps/photocraft-web/src/host_native.rs
@@ -0,0 +1,74 @@
+//! Trusted initial host open: native format only, with stable persisted identity.
+pub fn load(name: &str, bytes: &[u8]) -> Result<photocraft_doc::Document, String> {
+    if !name.to_ascii_lowercase().ends_with(".pcraft") || bytes.is_empty() || bytes.len() > 50 * 1024 * 1024 {
+        return Err("Host documents must be native .pcraft files containing 1 byte to 50 MiB".into());
+    }
+    let limits = photocraft_format::LoadOptions {
+        preserve_ids: true,
+        max_manifest_bytes: 8 * 1024 * 1024,
+        max_blob_bytes: 50 * 1024 * 1024,
+        max_total_bytes: 256 * 1024 * 1024,
+        max_canvas_pixels: 16_777_216,
+        ..Default::default()
+    };
+    let mut doc = photocraft_format::load_from_bytes_with(bytes, &limits).map_err(|e| e.to_string())?;
+    // `preserve_ids` is a request: v0.16.0 remaps IDs implausibly ahead of its allocator.
+    // Read the stored ID only after the bounded load has admitted this exact immutable
+    // manifest (the public manifest-only API uses larger default limits).
+    let stored_id = photocraft_format::read_manifest(bytes).map_err(|e| e.to_string())?.document.id;
+    if doc.id.0 != stored_id {
+        return Err("Host open refused: PhotoCraft could not preserve the native document identity".into());
+    }
+    doc.name = name.into();
+    Ok(doc)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn native_identity_survives_open_edit_export_reopen() {
+        let mut session = photocraft_engine::Session::new();
+        session.execute("file.new", serde_json::json!({"width": 4, "height": 4})).unwrap();
+        let doc = session.active().unwrap().doc.as_ref().clone();
+        let original = photocraft_format::save_to_bytes(&doc, &Default::default()).unwrap();
+        let opened = load("bound.pcraft", &original).unwrap();
+        assert_eq!(opened.id, doc.id);
+        let mut session = photocraft_engine::Session::new();
+        session.add_document(opened, None);
+        session.execute("layer.new.layer", serde_json::json!({})).unwrap();
+        let snapshot = session.active().unwrap().saved_snapshot();
+        let exported = photocraft_io::export(snapshot.document(), "bound.pcraft", &Default::default()).unwrap();
+        let reopened = load("bound.pcraft", &exported.bytes).unwrap();
+        assert_eq!(reopened.id.0.to_string(), doc.id.0.to_string());
+        assert_eq!(reopened.layers.len(), snapshot.document().layers.len());
+        assert!(reopened.layers.len() > doc.layers.len());
+    }
+
+    #[test]
+    fn remapped_native_identity_is_refused_instead_of_binding_a_replacement() {
+        let mut session = photocraft_engine::Session::new();
+        session.execute("file.new", serde_json::json!({"width": 4, "height": 4})).unwrap();
+        let mut doc = session.active().unwrap().doc.as_ref().clone();
+        doc.id = photocraft_doc::DocId(9_007_199_254_740_993);
+        let bytes = photocraft_format::save_to_bytes(&doc, &Default::default()).unwrap();
+        let error = load("bound.pcraft", &bytes).unwrap_err();
+        assert!(error.contains("could not preserve the native document identity"), "{error}");
+    }
+
+    #[test]
+    fn unsafe_or_non_native_input_is_rejected() {
+        assert!(load("bound.pcraft", b"malformed").is_err());
+        assert!(load("bound.pcraft", b"").is_err());
+        let mut session = photocraft_engine::Session::new();
+        session.execute("file.new", serde_json::json!({"width": 4, "height": 4})).unwrap();
+        let mut doc = session.active().unwrap().doc.as_ref().clone();
+        let bytes = photocraft_format::save_to_bytes(&doc, &Default::default()).unwrap();
+        assert!(load("bound.png", &bytes).is_err());
+        doc.size.width = 4097;
+        doc.size.height = 4097;
+        let bytes = photocraft_format::save_to_bytes(&doc, &Default::default()).unwrap();
+        assert!(load("bound.pcraft", &bytes).is_err());
+    }
+}
