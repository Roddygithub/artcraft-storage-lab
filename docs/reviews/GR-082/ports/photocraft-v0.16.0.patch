+            assert!(menus::invoke(&mut app, &egui::Context::default(), id, params.clone()).is_err(), "menu: {id}");
+            assert!(app.session.execute(id, params.clone()).is_err(), "nested engine: {id}");
+            assert_eq!(app.session.documents().len(), 1, "{id}");
+        }
+    }
+    assert!(app.open_bytes("drop.pcraft", b"x").is_err());
+    assert!(app.open_file("local.pcraft", b"x").is_err());
+    assert!(app.open_path("nonexistent.pcraft").is_err());
+    assert_eq!(app.open_paths(&["local.pcraft".into()]), 0);
+    assert!(app.open_dialog_file().is_err());
+    assert!(app.open_automation_bytes("local.pcraft", b"x").is_err());
+    assert!(app.open_file_pathless("second.pcraft", b"x").is_err());
+    assert!(app.save_as(Some("copy.pcraft".into())).is_err());
+    assert!(app.save_as_with(None, Default::default()).is_err());
+    assert!(app.save_automation(Some("copy.pcraft".into())).is_err());
