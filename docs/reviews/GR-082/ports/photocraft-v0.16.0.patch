+#[test]
+fn host_save_respects_modal_workspaces_and_refuses_changed_native_identity() {
+    let (mut base, written) = app_with(Vec::new());
+    base.services.host_mode = true;
+    let sent = Rc::new(Cell::new(0));
+    let sends = sent.clone();
+    base.services.host_save = Some(Box::new(move |_, _| {
+        sends.set(sends.get() + 1);
+        Ok(format!("save-{}", sends.get()))
+    }));
+    let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), base.services);
+    assert!(app.host_document_identity().is_err());
+    assert!(app.save_host_snapshot().is_err());
+    app.open_file_pathless("bound.pcraft", b"x").unwrap();
+    let id = app.session.active().unwrap().doc.id;
+    assert_eq!(app.host_document_identity().unwrap(), id.0.to_string());
+    app.run("layer.new.layer", json!({})).unwrap();
+    let ctx = egui::Context::default();
+    crate::liquify_ui::open(&mut app, &ctx).unwrap();
+    assert_eq!(crate::distort_ui::modal_workspace(&app), Some("filter.liquify"));
+    assert!(app.save_host_snapshot().is_err());
+    assert!(app.run("file.save", json!({})).is_err());
+    assert!(menus::invoke(&mut app, &ctx, "file.save", json!({})).is_err());
+    assert_eq!(sent.get(), 0, "modal save never serializes or sends");
+    crate::liquify_ui::cancel(&mut app);
+    let ticket = app.save_host_snapshot().unwrap();
+    assert!(app.session.active().unwrap().is_dirty());
+    assert!(app.host_save_result(&ticket, true, None));
+    assert!(!app.session.active().unwrap().is_dirty());
+    std::sync::Arc::make_mut(&mut app.session.active_mut().unwrap().doc).id = photocraft_doc::DocId(id.0 + 1);
+    assert!(app.host_document_identity().is_err());
+    assert!(app.save_host_snapshot().is_err());
+    assert_eq!(sent.get(), 1, "a replacement cannot use the host binding");
+    assert!(written.borrow().is_empty());
+}
