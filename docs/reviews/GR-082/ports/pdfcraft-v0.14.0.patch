+#[cfg(test)]
+mod host_save_ack_tests {
+    use super::*;
+    use pdfcraft_engine::{Edit, FieldValue};
+
+    fn app_with_edit(value: &str) -> (PdfCraftApp, pdfcraft_engine::DocId) {
+        let mut app = PdfCraftApp::new();
+        app.open_bytes("source.pdf", None, include_bytes!("../tests/data/form.pdf").to_vec()).unwrap();
+        let id = app.views[0].id;
+        assert!(app.apply_edit(Edit::SetFieldValue { name: "name".into(), value: FieldValue::Text(value.into()) }));
+        (app, id)
+    }
+
+    fn queue_save(app: &mut PdfCraftApp, id: pdfcraft_engine::DocId, ticket: &str) {
+        let bytes = app.session.save_bytes(id).unwrap();
+        let generation = app.session.get(id).unwrap().edit_generation();
+        app.host_pending_saves.insert(
+            ticket.into(),
+            PendingHostSave {
+                id,
+                generation,
+                target: SaveTarget::InPlace,
+                name: "source.pdf".into(),
+                bytes,
+                after: vec![HostSaveAfter::new(|_| {})],
+                queued: None,
+            },
+        );
+    }
+
+    #[test]
+    fn failed_host_save_keeps_the_document_dirty_and_duplicate_ack_is_ignored() {
+        let (mut app, id) = app_with_edit("dirty before save");
+        queue_save(&mut app, id, "pdfcraft:1");
+        app.host_save_results.lock().unwrap().push(("pdfcraft:1".into(), false, Some("conflict".into())));
+        app.settle_host_saves();
+        assert!(app.session.get(id).unwrap().dirty);
+        assert!(!app.host_pending_saves.contains_key("pdfcraft:1"));
+
+        let generation = app.session.get(id).unwrap().edit_generation();
+        app.host_save_results.lock().unwrap().push(("pdfcraft:1".into(), true, None));
+        app.settle_host_saves();
+        assert!(app.session.get(id).unwrap().dirty);
+        assert_eq!(app.session.get(id).unwrap().edit_generation(), generation);
+    }
+
+    #[test]
+    fn successful_ack_clears_only_the_exact_editor_snapshot() {
+        let (mut app, id) = app_with_edit("save snapshot");
+        queue_save(&mut app, id, "pdfcraft:2");
+        app.host_save_results.lock().unwrap().push(("pdfcraft:2".into(), true, None));
+        app.settle_host_saves();
+        assert!(!app.session.get(id).unwrap().dirty);
+
+        let (mut app, id) = app_with_edit("first snapshot");
+        queue_save(&mut app, id, "pdfcraft:3");
+        assert!(app.apply_edit(Edit::SetFieldValue { name: "name".into(), value: FieldValue::Text("newer edit".into()) }));
+        let generation = app.session.get(id).unwrap().edit_generation();
+        app.host_save_results.lock().unwrap().push(("pdfcraft:3".into(), true, None));
+        app.settle_host_saves();
+        let doc = app.session.get(id).unwrap();
+        assert!(doc.dirty);
+        assert_eq!(doc.edit_generation(), generation);
+        assert_eq!(doc.form.iter().find(|field| field.name == "name").unwrap().value, ["newer edit"]);
+    }
+
+    #[test]
+    fn acknowledgement_commits_new_form_typing_before_running_close_callback() {
+        let (mut app, id) = app_with_edit("saved snapshot");
+        let closed = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let callback_closed = closed.clone();
+        let bytes = app.session.save_bytes(id).unwrap();
+        let generation = app.session.get(id).unwrap().edit_generation();
+        app.host_pending_saves.insert(
+            "pdfcraft:typing".into(),
+            PendingHostSave {
+                id,
+                generation,
+                target: SaveTarget::InPlace,
+                name: "source.pdf".into(),
+                bytes,
+                after: vec![HostSaveAfter::new(move |_| callback_closed.store(true, std::sync::atomic::Ordering::SeqCst))],
+                queued: None,
+            },
+        );
+        app.views[0].pending_edit = Some(Edit::SetFieldValue { name: "name".into(), value: FieldValue::Text("typed while saving".into()) });
+        app.host_save_results.lock().unwrap().push(("pdfcraft:typing".into(), true, None));
+
+        app.settle_host_saves();
+
+        assert!(!closed.load(std::sync::atomic::Ordering::SeqCst));
+        assert!(app.session.get(id).unwrap().dirty);
+        assert_eq!(app.session.get(id).unwrap().form.iter().find(|field| field.name == "name").unwrap().value, ["typed while saving"]);
+    }
+
+    #[test]
+    fn acknowledgement_commits_new_paragraph_text_before_running_close_callback() {
+        let (mut app, mut editor) = crate::edit_text_ui::tests::preview_app();
+        let id = app.views[0].id;
+        editor.text = "paragraph typed while saving".into();
+        let bytes = app.session.save_bytes(id).unwrap();
+        let generation = app.session.get(id).unwrap().edit_generation();
+        let closed = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let callback_closed = closed.clone();
+        app.views[0].line_editor = Some(editor);
+        app.host_pending_saves.insert(
+            "pdfcraft:paragraph".into(),
+            PendingHostSave {
+                id,
+                generation,
+                target: SaveTarget::InPlace,
+                name: "preview.pdf".into(),
+                bytes,
+                after: vec![HostSaveAfter::new(move |_| callback_closed.store(true, std::sync::atomic::Ordering::SeqCst))],
+                queued: None,
+            },
+        );
+        app.host_save_results.lock().unwrap().push(("pdfcraft:paragraph".into(), true, None));
+
+        app.settle_host_saves();
+
+        assert!(!closed.load(std::sync::atomic::Ordering::SeqCst));
+        let doc = app.session.get(id).unwrap();
+        assert!(doc.dirty);
+        assert!(doc.text_blocks(0).iter().any(|block| block.text == "paragraph typed while saving"));
+    }
+
+    #[test]
+    fn acknowledgement_commits_new_text_box_before_running_close_callback() {
+        use crate::content_ui::{TextDraft, default_style};
+        let (mut app, id) = app_with_edit("saved snapshot");
+        queue_save(&mut app, id, "pdfcraft:new-text");
+        let closed = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let callback_closed = closed.clone();
+        app.host_pending_saves.get_mut("pdfcraft:new-text").unwrap().after =
+            vec![HostSaveAfter::new(move |_| callback_closed.store(true, std::sync::atomic::Ordering::SeqCst))];
+        app.views[0].content.draft = Some(TextDraft {
+            page: 0,
+            index: None,
+            rect: [72.0, 72.0, 272.0, 92.0],
+            text: "new text typed while saving".into(),
+            style: default_style(),
+            focus: true,
+        });
+        app.host_save_results.lock().unwrap().push(("pdfcraft:new-text".into(), true, None));
+
+        app.settle_host_saves();
+
+        assert!(!closed.load(std::sync::atomic::Ordering::SeqCst));
+        assert!(app.session.get(id).unwrap().dirty);
+        assert!(app.views[0].content.draft.is_none());
+        let bytes = app.session.save_bytes(id).unwrap();
+        let mut reopened = PdfCraftApp::new();
+        reopened.open_bytes("reopened.pdf", None, bytes.as_ref().clone()).unwrap();
+        let doc = reopened.session.get(reopened.views[0].id).unwrap();
+        assert!(doc.added().iter().any(|content| matches!(&content.content,
+            pdfcraft_engine::AddedContent::Text(text) if text.text == "new text typed while saving")));
+    }
+
+    #[test]
+    fn same_snapshot_save_requests_coalesce_and_preserve_close_callback() {
+        let (mut app, id) = app_with_edit("save once");
+        queue_save(&mut app, id, "pdfcraft:coalesced");
+        let generation = app.session.get(id).unwrap().edit_generation();
+        let closed = std::sync::Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let callback_closed = closed.clone();
+        assert_eq!(
+            app.defer_to_pending_host_save(
+                id,
+                generation,
+                SaveTarget::InPlace,
+                &mut Some(HostSaveAfter::new(move |_| callback_closed.store(true, std::sync::atomic::Ordering::SeqCst))),
+            ),
+            DeferHostSave::Deferred
+        );
+        assert_eq!(app.host_pending_saves.len(), 1);
+        app.host_save_results.lock().unwrap().push(("pdfcraft:coalesced".into(), true, None));
+
+        app.settle_host_saves();
+
+        assert!(closed.load(std::sync::atomic::Ordering::SeqCst));
+        assert!(!app.session.get(id).unwrap().dirty);
+    }
+
+    #[test]
+    fn save_callbacks_have_a_per_document_cap() {
+        let (mut app, id) = app_with_edit("save callback cap");
+        queue_save(&mut app, id, "pdfcraft:callback-cap");
+        let generation = app.session.get(id).unwrap().edit_generation();
+        let pending = app.host_pending_saves.get_mut("pdfcraft:callback-cap").unwrap();
+        pending.after.extend((1..MAX_HOST_SAVE_CALLBACKS_PER_DOC).map(|_| HostSaveAfter::new(|_: &mut PdfCraftApp| {})));
+
+        let mut callback: Option<HostSaveAfter> = Some(HostSaveAfter::new(|_| {}));
+        assert_eq!(app.defer_to_pending_host_save(id, generation, SaveTarget::InPlace, &mut callback), DeferHostSave::Full);
+        assert!(callback.is_some());
+        assert_eq!(app.host_pending_saves.get("pdfcraft:callback-cap").unwrap().after.len(), MAX_HOST_SAVE_CALLBACKS_PER_DOC);
+
+        let follow_up_callbacks =
+            HostSaveAfter::combine((0..MAX_HOST_SAVE_CALLBACKS_PER_DOC).map(|_| HostSaveAfter::new(|_: &mut PdfCraftApp| {})).collect());
+        assert_eq!(follow_up_callbacks.retained_callbacks, MAX_HOST_SAVE_CALLBACKS_PER_DOC);
+        let pending = app.host_pending_saves.get_mut("pdfcraft:callback-cap").unwrap();
+        pending.after.clear();
+        pending.after.push(follow_up_callbacks);
+        let mut callback = Some(HostSaveAfter::new(|_: &mut PdfCraftApp| {}));
+        assert_eq!(app.defer_to_pending_host_save(id, generation, SaveTarget::InPlace, &mut callback), DeferHostSave::Full);
+    }
+
+    #[test]
+    fn closing_a_tab_releases_its_pending_snapshot() {
+        let (mut app, id) = app_with_edit("discard pending snapshot");
+        queue_save(&mut app, id, "pdfcraft:closed");
+        assert!(!app.host_pending_saves.is_empty());
+        app.close_tab(0);
+        assert!(app.host_pending_saves.is_empty());
+    }
+}
