+#![cfg(all(target_arch = "wasm32", feature = "browser"))]
+use craft_platform::browser::{DownloadOptions, PreparedDownload, download_bytes};
+use wasm_bindgen::{JsValue, prelude::wasm_bindgen};
+use wasm_bindgen_test::{wasm_bindgen_test, wasm_bindgen_test_configure};
+wasm_bindgen_test_configure!(run_in_browser);
+
+#[wasm_bindgen(module = "/tests/browser_harness.js")]
+extern "C" {
+    fn setup(mode: &str);
+    fn restore();
+    fn created_count() -> u32;
+    fn revoked_count() -> u32;
+    fn clicked_count() -> u32;
+    fn anchor_count() -> u32;
+    fn last_name() -> String;
+    fn last_mime() -> String;
+    fn timer_before_click() -> bool;
+    fn wait_for_cleanup() -> js_sys::Promise;
+}
+struct Restore;
+impl Drop for Restore {
+    fn drop(&mut self) {
+        restore();
+    }
+}
+
+#[wasm_bindgen_test]
+fn abandoning_a_prepared_download_releases_its_url() -> Result<(), JsValue> {
+    setup("");
+    let _restore = Restore;
+    let prepared = PreparedDownload::bytes("export.txt", "text/plain", b"content")?;
+    assert_eq!(created_count(), 1);
+    drop(prepared);
+    assert_eq!(revoked_count(), 1);
+    assert_eq!(clicked_count(), 0);
+    assert_eq!(anchor_count(), 0);
+    Ok(())
+}
+
+#[wasm_bindgen_test]
+fn failed_attachment_and_timer_do_not_click_or_leak() {
+    for mode in ["attach-error", "timer-error"] {
+        setup(mode);
+        let _restore = Restore;
+        assert!(download_bytes("export.txt", "text/plain", b"content", Default::default()).is_err());
+        assert_eq!(created_count(), 1);
+        assert_eq!(revoked_count(), 1);
+        assert_eq!(clicked_count(), 0);
+        assert_eq!(anchor_count(), 0);
+    }
+}
+
+#[wasm_bindgen_test]
+async fn successful_download_releases_its_url_after_the_click() -> Result<(), JsValue> {
+    setup("");
+    let _restore = Restore;
+    download_bytes("export.txt", "text/plain", b"content", DownloadOptions { revoke_after_ms: 5 })?;
+    assert_eq!(clicked_count(), 1);
+    assert_eq!(last_name(), "export.txt");
+    assert_eq!(last_mime(), "text/plain");
+    assert!(timer_before_click());
+    assert_eq!(revoked_count(), 0);
+    assert_eq!(anchor_count(), 0);
+    wasm_bindgen_futures::JsFuture::from(wait_for_cleanup()).await?;
+    assert_eq!(revoked_count(), 1);
+    Ok(())
+}
+
+#[wasm_bindgen_test]
+fn invalid_lifetime_cleans_a_prepared_download() {
+    setup("");
+    let _restore = Restore;
+    assert!(download_bytes("export.txt", "text/plain", b"content", DownloadOptions { revoke_after_ms: 0 }).is_err());
+    assert_eq!(revoked_count(), 1);
+    assert_eq!(clicked_count(), 0);
+}
+
+#[wasm_bindgen_test]
+fn failed_setup_does_not_allocate_a_url_or_click() {
+    for mode in ["element-error", "style-error"] {
+        setup(mode);
+        let _restore = Restore;
+        assert!(download_bytes("export.txt", "text/plain", b"content", Default::default()).is_err());
+        assert_eq!(created_count(), 0);
+        assert_eq!(revoked_count(), 0);
+        assert_eq!(clicked_count(), 0);
+        assert_eq!(anchor_count(), 0);
+    }
+}
+
+#[wasm_bindgen_test]
+fn empty_name_is_rejected_before_allocating_resources() {
+    setup("");
+    let _restore = Restore;
+    assert!(download_bytes("  ", "text/plain", b"content", Default::default()).is_err());
+    assert_eq!(created_count(), 0);
+    assert_eq!(clicked_count(), 0);
+}
diff --git c/integration/craft-platform/tests/browser_harness.js w/integration/craft-platform/tests/browser_harness.js
new file mode 100644
index 0000000..fc652c3
--- /dev/null
+++ w/integration/craft-platform/tests/browser_harness.js
@@ -0,0 +1,42 @@
+// Test-only browser fault injection; no app runtime depends on this module.
+let originals;
+let created, revoked, clicked, scheduled, lastName, lastMime, timerBeforeClick;
+export function setup(mode) {
+    created = 0; revoked = 0; clicked = 0; scheduled = 0;
+    lastName = ''; lastMime = ''; timerBeforeClick = false;
+    originals = {
+        create: URL.createObjectURL, revoke: URL.revokeObjectURL,
+        click: HTMLAnchorElement.prototype.click,
+        append: Node.prototype.appendChild, timer: window.setTimeout,
+        element: Document.prototype.createElement,
+        attribute: Element.prototype.setAttribute,
+    };
+    URL.createObjectURL = function(blob) { created++; lastMime = blob.type; return originals.create.call(URL, blob); };
+    URL.revokeObjectURL = function(url) { revoked++; return originals.revoke.call(URL, url); };
+    HTMLAnchorElement.prototype.click = function() {
+        clicked++; lastName = this.download; timerBeforeClick = scheduled > 0;
+    };
+    window.setTimeout = function(...args) {
+        if (mode === 'timer-error') throw new Error('timer failed');
+        scheduled++;
+        return originals.timer.apply(window, args);
+    };
+    if (mode === 'attach-error') Node.prototype.appendChild = function() { throw new Error('attachment failed'); };
+    if (mode === 'element-error') Document.prototype.createElement = function() { throw new Error('element failed'); };
+    if (mode === 'style-error') Element.prototype.setAttribute = function() { throw new Error('style failed'); };
+}
+export function restore() {
+    URL.createObjectURL = originals.create; URL.revokeObjectURL = originals.revoke;
+    HTMLAnchorElement.prototype.click = originals.click;
+    Node.prototype.appendChild = originals.append; window.setTimeout = originals.timer;
+    Document.prototype.createElement = originals.element;
+    Element.prototype.setAttribute = originals.attribute;
+}
+export function created_count() { return created; }
+export function revoked_count() { return revoked; }
+export function clicked_count() { return clicked; }
+export function anchor_count() { return document.querySelectorAll('a[download]').length; }
+export function last_name() { return lastName; }
+export function last_mime() { return lastMime; }
+export function timer_before_click() { return timerBeforeClick; }
+export function wait_for_cleanup() { return new Promise(resolve => originals.timer.call(window, resolve, 50)); }
diff --git c/integration/craft-platform/tests/dialog_lifecycle.rs w/integration/craft-platform/tests/dialog_lifecycle.rs
new file mode 100644
index 0000000..1b78d03
--- /dev/null
+++ w/integration/craft-platform/tests/dialog_lifecycle.rs
@@ -0,0 +1,248 @@
+#![cfg(all(feature = "dialogs", not(target_arch = "wasm32")))]
+use craft_platform::{
+    dialog_outcome::{DialogError, ErrorKind, Outcome},
+    dialogs::{NativeDialogs, wait_prepared},
+};
+use std::sync::{
+    Arc,
+    atomic::{AtomicUsize, Ordering},
+    mpsc,
+};
+use std::time::{Duration, Instant};
+fn pump_until<R, T: Send + 'static>(
+    service: &mut NativeDialogs<R, T>,
+    mut create: impl FnMut(R) -> craft_platform::dialogs::DialogFuture<T>,
+    until: impl Fn() -> bool,
+) {
+    let deadline = Instant::now() + Duration::from_secs(3);
+    while !until() {
+        assert!(Instant::now() < deadline, "worker did not settle");
+        service.pump(&mut create);
+        std::thread::yield_now();
+    }
+}
+#[test]
+fn factory_is_eager_on_caller_and_completion_on_worker() -> Result<(), Box<dyn std::error::Error>> {
+    let caller = std::thread::current().id();
+    let (tx, rx) = mpsc::channel();
+    let worker = wait_prepared(
+        || {
+            assert_eq!(caller, std::thread::current().id());
+            async { Outcome::Selected(42) }
+        },
+        move |outcome| {
+            let _ = tx.send((outcome, std::thread::current().id()));
+        },
+    )?;
+    let (outcome, thread) = rx.recv_timeout(Duration::from_secs(3))?;
+    assert_eq!(outcome, Outcome::Selected(42));
+    assert_ne!(caller, thread);
+    assert!(worker.join().is_ok());
+    Ok(())
+}
+#[test]
+fn constructor_and_poll_failures_are_not_cancellation() -> Result<(), Box<dyn std::error::Error>> {
+    for construct in [false, true] {
+        let (tx, rx) = mpsc::channel();
+        let worker = wait_prepared(
+            || {
+                if construct {
+                    std::panic::resume_unwind(Box::new("constructor"));
+                }
+                async {
+                    std::panic::resume_unwind(Box::new("poll"));
+                    #[allow(unreachable_code)]
+                    Outcome::<u8>::Cancelled
+                }
+            },
+            move |outcome| {
+                let _ = tx.send(outcome);
+            },
+        )?;
+        assert!(matches!(rx.recv_timeout(Duration::from_secs(3))?, Outcome::Failed(DialogError { kind: ErrorKind::Worker, .. })));
+        assert!(worker.join().is_ok());
+    }
+    Ok(())
+}
+#[test]
+fn queued_and_dropped_replies_keep_live_picker_busy() -> Result<(), Box<dyn std::error::Error>> {
+    let (c, mut service) = NativeDialogs::<(), u8>::new(|| {});
+    let reply = c.request(());
+    assert!(service.pending());
+    drop(reply);
+    let (release, wait) = mpsc::channel();
+    let mut wait = Some(wait);
+    let created = Arc::new(AtomicUsize::new(0));
+    let count = created.clone();
+    pump_until(
+        &mut service,
+        move |()| {
+            count.fetch_add(1, Ordering::SeqCst);
+            let wait = wait.take();
+            Box::pin(async move {
+                let _ = wait.map(|w| w.recv());
+                Outcome::Selected(1)
+            })
+        },
+        || created.load(Ordering::SeqCst) == 1,
+    );
+    assert!(service.pending());
+    assert!(matches!(c.request(()).recv_timeout(Duration::from_secs(3))?, Outcome::Failed(_)));
+    release.send(())?;
+    let deadline = Instant::now() + Duration::from_secs(3);
+    while service.pending() {
+        assert!(Instant::now() < deadline);
+        service.pump(|()| Box::pin(async { Outcome::Indeterminate }));
+        std::thread::yield_now();
+    }
+    Ok(())
+}
+#[test]
+fn proven_absence_skips_native_factory() -> Result<(), Box<dyn std::error::Error>> {
+    let (c, mut service) = NativeDialogs::<(), u8>::with_preflight(|| {}, || Err(DialogError::new(ErrorKind::Unavailable, "test backend missing")));
+    let reply = c.request(());
+    let called = Arc::new(AtomicUsize::new(0));
+    let count = called.clone();
+    let mut result = None;
+    let deadline = Instant::now() + Duration::from_secs(3);
+    while result.is_none() {
+        assert!(Instant::now() < deadline);
+        service.pump(|()| {
+            count.fetch_add(1, Ordering::SeqCst);
+            Box::pin(async { Outcome::Selected(1) })
+        });
+        result = reply.try_recv().ok();
+        std::thread::yield_now();
+    }
+    assert_eq!(called.load(Ordering::SeqCst), 0);
+    assert!(matches!(result, Some(Outcome::Failed(DialogError { kind: ErrorKind::Unavailable, .. }))));
+    Ok(())
+}
+#[test]
+fn missing_backend_answer_is_ambiguous() {
+    assert_eq!(Outcome::<u8>::from_rfd(None), Outcome::Indeterminate);
+}
+#[cfg(feature = "egui")]
+#[test]
+fn held_close_retries_policy_without_granting_discard() {
+    let ctx = egui::Context::default();
+    let mut close = craft_platform::dialogs::DeferredClose::default();
+    let mut input = egui::RawInput::default();
+    input.viewports.entry(egui::ViewportId::ROOT).or_default().events.push(egui::ViewportEvent::Close);
+    let mut output = ctx.run_ui(input, |ui| assert!(!close.update(ui.ctx(), true)));
+    assert!(output.viewport_output[&egui::ViewportId::ROOT].commands.contains(&egui::ViewportCommand::CancelClose));
+    output.textures_delta.clear();
+    let mut output = ctx.run_ui(egui::RawInput::default(), |ui| assert!(close.update(ui.ctx(), false)));
+    assert!(!output.viewport_output[&egui::ViewportId::ROOT].commands.contains(&egui::ViewportCommand::Close));
+    output.textures_delta.clear();
+    let mut output = ctx.run_ui(egui::RawInput::default(), |ui| assert!(!close.update(ui.ctx(), false)));
+    output.textures_delta.clear();
+}
+#[test]
+fn notification_panic_cannot_kill_reserved_picker_worker() -> Result<(), Box<dyn std::error::Error>> {
+    let (c, mut service) = NativeDialogs::<(), u8>::new(|| std::panic::resume_unwind(Box::new("wake failure")));
+    let reply = c.request(());
+    let mut result = None;
+    let deadline = Instant::now() + Duration::from_secs(3);
+    while result.is_none() {
+        assert!(Instant::now() < deadline);
+        service.pump(|()| Box::pin(async { Outcome::Selected(7) }));
+        result = reply.try_recv().ok();
+        std::thread::yield_now();
+    }
+    assert_eq!(result, Some(Outcome::Selected(7)));
+    Ok(())
+}
+
+#[test]
+fn completion_between_pumps_cannot_reject_a_chained_request() -> Result<(), Box<dyn std::error::Error>> {
+    let wakes = Arc::new(AtomicUsize::new(0));
+    let count = wakes.clone();
+    let (client, mut service) = NativeDialogs::<u8, u8>::new(move || {
+        count.fetch_add(1, Ordering::SeqCst);
+    });
+    let first = client.request(1);
+    let (release, wait) = mpsc::channel();
+    let mut wait = Some(wait);
+    let created = Arc::new(AtomicUsize::new(0));
+    let count = created.clone();
+    pump_until(
+        &mut service,
+        move |value| {
+            count.fetch_add(1, Ordering::SeqCst);
+            let wait = wait.take();
+            Box::pin(async move {
+                let _ = wait.map(|wait| wait.recv());
+                Outcome::Selected(value)
+            })
+        },
+        || created.load(Ordering::SeqCst) == 1,
+    );
+    // Finish after the host's pump, before its app continuation polls the reply.
+    release.send(())?;
+    let deadline = Instant::now() + Duration::from_secs(3);
+    while wakes.load(Ordering::SeqCst) < 3 {
+        assert!(Instant::now() < deadline, "worker did not publish completion");
+        std::thread::yield_now();
+    }
+    assert!(matches!(first.try_recv(), Err(mpsc::TryRecvError::Empty)));
+    assert!(service.pending(), "an unpublished completion still retains the parent");
+    service.pump(|value| Box::pin(async move { Outcome::Selected(value) }));
+    assert_eq!(first.try_recv()?, Outcome::Selected(1));
+    assert!(!service.pending());
+    // The app can chain the next dialog immediately upon observing the first answer.
+    let second = client.request(2);
+    assert!(matches!(second.try_recv(), Err(mpsc::TryRecvError::Empty)));
+    let mut result = None;
+    while result.is_none() {
+        assert!(Instant::now() < deadline, "chained picker did not settle");
+        service.pump(|value| Box::pin(async move { Outcome::Selected(value) }));
+        result = second.try_recv().ok();
+        std::thread::yield_now();
+    }
+    assert_eq!(result, Some(Outcome::Selected(2)));
+    assert!(!service.pending());
+    Ok(())
+}
