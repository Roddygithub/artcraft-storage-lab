+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{BitDepth, EncodeOptions, encode};
+
+    #[test]
+    fn symphonia_decodes_synthetic_flac_and_reports_frames() {
+        let input = AudioBuffer { sample_rate: 48_000, channels: vec![vec![0.0, 0.25, -0.5, 0.75], vec![0.1, -0.2, 0.3, -0.4]] };
+        let bytes = encode(&input, &EncodeOptions { format: FileFormat::Flac, bit_depth: BitDepth::Int24, dither: false, bwf: None })
+            .expect("synthetic FLAC encoding");
+        let (info, decoded) = decode(&bytes, FileFormat::Flac).expect("Symphonia FLAC decoding");
+        assert_eq!(info.format, FileFormat::Flac);
+        assert_eq!(info.sample_rate, 48_000);
+        assert_eq!(info.channels, 2);
+        assert_eq!(info.frames, 4);
+        assert_eq!(decoded.frames(), 4);
+        assert!((decoded.channels[0][1] - 0.25).abs() < 0.0001);
+        assert!((decoded.channels[1][2] - 0.3).abs() < 0.0001);
+    }
+
+    #[test]
+    fn symphonia_rejects_truncated_id3_before_metadata_allocation() {
+        let malformed = b"ID3\x04\0\0\x7f\x7f\x7f\x7f";
+        assert!(open(malformed).is_err());
+    }
+
+    #[test]
+    fn container_preflight_ignores_markers_outside_root_boxes() {
+        assert_eq!(container(b"RIFF\0\0\0\0WAVEdata caff"), Some((Container::Wav, 0)));
+        assert_eq!(container(b"ID3 metadata fLaC audio"), None);
+        let mut padded_caf = vec![0; 100];
+        padded_caf.extend_from_slice(b"caff\0\x01");
+        assert_eq!(container(&padded_caf), Some((Container::Caf, 100)));
+
+        let mut mp4 = Vec::from([0, 0, 0, 12]);
+        mp4.extend_from_slice(b"free");
+        mp4.extend_from_slice(b"skip");
+        mp4.extend_from_slice(&[0, 0, 0, 16]);
+        mp4.extend_from_slice(b"ftyp");
+        mp4.extend_from_slice(b"M4A ");
+        mp4.extend_from_slice(&[0; 4]);
+        assert_eq!(container(&mp4), Some((Container::Mp4, 0)));
+
+        let mut padded_mp4 = vec![0; 100];
+        padded_mp4.extend_from_slice(&mp4);
+        assert_eq!(container(&padded_mp4), Some((Container::Mp4, 100)));
+
+        let mut nested = Vec::from([0, 0, 0, 16]);
+        nested.extend_from_slice(b"free");
+        nested.extend_from_slice(b"ftyp");
+        nested.extend_from_slice(b"data");
+        assert_eq!(container(&nested), None);
+
+        assert_eq!(container(b"\0\0\0\x08ftyp"), None);
+        assert_eq!(container(b"\0\0\0\xffftypM4A "), None);
+    }
