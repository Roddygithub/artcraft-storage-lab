+/// Locate and skip the leading ID3v2 tag before handing the stream to Symphonia. In particular,
+/// this avoids asking a metadata reader to allocate a frame using an untrusted ID3 size.
+fn id3v2_len(bytes: &[u8]) -> Option<usize> {
+    if bytes.get(..3)? != b"ID3" {
+        return None;
+    }
+    let size = bytes.get(6..10)?.iter().fold(0usize, |acc, &x| (acc << 7) | usize::from(x & 0x7f));
+    Some(10usize.saturating_add(size))
+}
