+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Container {
+    Caf,
+    Mp4,
+    Flac,
+    Wav,
+}
+
+fn has_top_level_ftyp(bytes: &[u8]) -> bool {
+    let mut pos = 0usize;
+    while pos.checked_add(8).is_some_and(|end| end <= bytes.len()) {
+        let Some(size) = be_u32(bytes, pos) else { return false };
+        let Some(kind) = bytes.get(pos + 4..pos + 8) else { return false };
+        let (header, size) = if size == 1 {
+            let Some(size) = be_u64(bytes, pos + 8) else { return false };
+            (16usize, size)
+        } else {
+            (8usize, u64::from(size))
+        };
+        let Ok(size) = usize::try_from(size) else { return false };
+        if size < header || size > bytes.len() - pos || size == 0 {
+            return false;
+        }
+        if kind == b"ftyp" {
+            let Some(payload_size) = size.checked_sub(header) else { return false };
+            return payload_size >= 8 && (payload_size - 8) % 4 == 0;
+        }
+        let Some(next) = pos.checked_add(size) else { return false };
+        pos = next;
+    }
+    false
+}
+
+/// Identify only root containers. Searching the whole file lets arbitrary marker bytes in tags
+/// or audio payloads trigger the wrong parser's preflight checks.
+fn container(bytes: &[u8]) -> Option<(Container, usize)> {
+    // An MP4 atom starts with a binary size, often zero-prefixed; recognize it before treating
+    // leading zero bytes as padding.
+    if has_top_level_ftyp(bytes) {
+        return Some((Container::Mp4, 0));
+    }
+    // For zero-padded MP4, the first non-zero size byte can be inside its 32-bit size field.
+    // Try the at-most-four possible starts for that header, but only across an all-zero prefix.
+    let first_nonzero = bytes.iter().position(|&byte| byte != 0)?;
+    for start in first_nonzero.saturating_sub(3)..=first_nonzero {
+        if bytes[..start].iter().all(|&byte| byte == 0) && has_top_level_ftyp(bytes.get(start..)?) {
+            return Some((Container::Mp4, start));
+        }
+    }
+    // Symphonia accepts zero-padded streams. Match only the first non-padding byte, never a
+    // coincidental marker buried in metadata or an encoded audio packet.
+    let start = first_nonzero;
+    let bytes = bytes.get(start..)?;
+    if bytes.starts_with(b"caff") {
+        return Some((Container::Caf, start));
+    }
+    if bytes.starts_with(b"fLaC") {
+        return Some((Container::Flac, start));
+    }
+    if bytes.starts_with(b"RIFF") {
+        return Some((Container::Wav, start));
+    }
+
+    if has_top_level_ftyp(bytes) {
+        return Some((Container::Mp4, start));
+    }
+    None
+}
