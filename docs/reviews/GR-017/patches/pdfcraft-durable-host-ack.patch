 use crate::PdfCraftApp;
 
+/// A PDF snapshot waiting for the storage host to report its durable result.
+pub(crate) struct PendingHostSave {
+    pub(crate) id: pdfcraft_engine::DocId,
+    generation: u64,
+    target: SaveTarget,
+    name: String,
+    bytes: std::sync::Arc<Vec<u8>>,
+    after: Vec<HostSaveAfter>,
+    queued: Option<QueuedHostSave>,
+}
+
+struct HostSaveAfter {
+    callback: Box<dyn FnOnce(&mut PdfCraftApp) + Send + 'static>,
+    retained_callbacks: usize,
+}
+
+impl HostSaveAfter {
+    fn new(callback: impl FnOnce(&mut PdfCraftApp) + Send + 'static) -> Self {
+        Self { callback: Box::new(callback), retained_callbacks: 1 }
+    }
+
+    fn combine(callbacks: Vec<Self>) -> Self {
+        let retained_callbacks = callbacks.iter().map(|callback| callback.retained_callbacks).sum();
+        Self::new(move |app| {
+            for callback in callbacks {
+                callback.run(app);
+            }
+        })
+        .with_count(retained_callbacks)
+    }
+
+    fn with_count(mut self, retained_callbacks: usize) -> Self {
+        self.retained_callbacks = retained_callbacks;
+        self
+    }
+
+    fn run(self, app: &mut PdfCraftApp) {
+        (self.callback)(app);
+    }
+
+    #[cfg(not(target_arch = "wasm32"))]
+    fn into_callback(self) -> Box<dyn FnOnce(&mut PdfCraftApp) + Send + 'static> {
+        Box::new(move |app| self.run(app))
+    }
+}
+
+#[cfg(any(target_arch = "wasm32", test))]
+#[derive(Debug, PartialEq, Eq)]
+enum DeferHostSave {
+    NotPending,
+    Deferred,
+    Full,
+}
+
+#[cfg(any(target_arch = "wasm32", test))]
+const MAX_HOST_SAVE_CALLBACKS_PER_DOC: usize = 64;
+
+struct QueuedHostSave {
+    target: SaveTarget,
+    after: Vec<HostSaveAfter>,
+}
+
+#[cfg(target_arch = "wasm32")]
+const MAX_PENDING_HOST_SAVE_BYTES: usize = 256 * 1024 * 1024;
