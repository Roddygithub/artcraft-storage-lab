+    fn host_save_current(&mut self) -> Result<(), String> {
+        let Some((uid, name)) = self.host_document.clone() else {
+            return Err("No host-bound presentation is open".into());
+        };
+        if self.host_pending.is_some() {
+            return Err("A host save is still awaiting confirmation; its outcome may be unknown".into());
+        }
+        if self.session.documents().len() != 1 || self.session.active().is_none_or(|d| d.uid != uid || d.path.is_some()) {
+            return Err("The host-bound presentation is no longer the only active document".into());
+        }
+        let snapshot = self.session.active().ok_or("No active presentation")?.doc.clone();
+        if self.session.active().is_some_and(|d| !d.is_dirty()) {
+            self.set_status("No changes to save");
+            return Ok(());
+        }
+        let format = name.rsplit('.').next().unwrap_or("deckcraft").to_ascii_lowercase();
+        let bytes = deckcraft_engine::cmd::file::save_bytes(&snapshot, &format).map_err(|e| e.to_string())?;
+        if bytes.len() > 256 * 1024 * 1024 {
+            return Err("Serialized presentation exceeds the 256 MiB host-save limit".into());
+        }
+        let ticket = format!("deckcraft:{}", self.host_next_ticket);
+        self.host_next_ticket = self.host_next_ticket.wrapping_add(1).max(1);
+        self.host_pending = Some(PendingHostSave { ticket: ticket.clone(), uid, snapshot, started_at: self.last_time });
+        self.host_timeout_reported = false;
+        let Some(send) = self.services.host_save.as_mut() else {
+            self.host_pending = None;
+            return Err("Host save transport is unavailable".into());
+        };
+        if let Err(e) = send(&ticket, &name, &bytes) {
+            self.host_pending = None;
+            return Err(format!("Could not send save to host: {e}"));
+        }
+        self.set_status("Saving to file host…");
+        Ok(())
+    }
+
+    fn process_host_events(&mut self) {
+        let Some(queue) = self.services.host_events.clone() else { return };
+        let events = match queue.try_borrow_mut() {
+            Ok(mut queue) => std::mem::take(&mut *queue),
+            Err(_) => return,
+        };
+        for event in events {
+            match event {
