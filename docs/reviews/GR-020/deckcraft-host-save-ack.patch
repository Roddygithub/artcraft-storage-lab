+use std::cell::RefCell;
+use std::rc::Rc;
+
+use deckcraft_engine::Session;
+use serde_json::json;
+
+use crate::{HostEvent, Services, SlideApp};
+
+#[test]
+fn host_save_stays_dirty_until_ack_and_reopens_serialized_bytes() {
+    let mut source = Session::with_new();
+    source.execute("shape.insert", &json!({"preset": "rect", "rect": [10, 10, 40, 30]})).unwrap();
+    let initial = deckcraft_engine::cmd::file::save_bytes(&source.active().unwrap().doc, "deckcraft").unwrap();
+    let expected_shapes = source.active().unwrap().doc.slides[0].shapes.len() + 1;
+    let events = Rc::new(RefCell::new(Vec::new()));
+    let captured = Rc::new(RefCell::new(None::<(String, String, Vec<u8>)>));
+    let save_capture = captured.clone();
+    let services = Services {
+        host_mode: true,
+        host_events: Some(events.clone()),
+        host_save: Some(Box::new(move |ticket, name, bytes| {
+            *save_capture.borrow_mut() = Some((ticket.to_string(), name.to_string(), bytes.to_vec()));
+            Ok(())
+        })),
+        ..Default::default()
+    };
+    let mut app = SlideApp::new(Session::new(), services);
+    app.host_open("Talk.deckcraft", &initial);
+    app.session.execute("shape.insert", &json!({"preset": "ellipse", "rect": [80, 10, 40, 30]})).unwrap();
+    assert!(app.session.active().unwrap().is_dirty());
+
+    app.host_save_current().unwrap();
+    assert!(app.session.active().unwrap().is_dirty(), "handoff is not a durable-save acknowledgement");
+    let (ticket, name, bytes) = captured.borrow_mut().take().unwrap();
+    assert_eq!(name, "Talk.deckcraft");
+    events.borrow_mut().push(HostEvent::SaveResult { ticket, ok: true, error: None });
+    app.process_host_events();
+    assert!(!app.session.active().unwrap().is_dirty());
+
+    let mut reopened = Session::new();
+    reopened.execute("file.openBytes", &json!({"name": name, "data": deckcraft_engine::cmd::base64_encode(&bytes)})).unwrap();
+    let slide = reopened.active().unwrap().doc.slides.first().unwrap();
+    assert_eq!(slide.shapes.len(), expected_shapes, "the acknowledged serialized bytes contain the later edit");
+}
+
+#[test]
+fn host_mode_rejects_document_creation_and_save_as() {
+    let mut app = SlideApp::new(Session::new(), Services { host_mode: true, ..Default::default() });
+    assert!(app.run("file.new", json!({})).is_err());
+    assert!(app.run("file.saveAs", json!({"path": "other.deckcraft"})).is_err());
+    assert!(app.session.documents().is_empty());
+}
+
+#[test]
+fn stale_host_ack_keeps_edits_made_after_submission_dirty() {
+    let mut source = Session::with_new();
+    source.execute("shape.insert", &json!({"preset": "rect", "rect": [10, 10, 40, 30]})).unwrap();
+    let initial = deckcraft_engine::cmd::file::save_bytes(&source.active().unwrap().doc, "deckcraft").unwrap();
+    let events = Rc::new(RefCell::new(Vec::new()));
+    let captured = Rc::new(RefCell::new(None::<String>));
+    let save_capture = captured.clone();
+    let services = Services {
+        host_mode: true,
+        host_events: Some(events.clone()),
+        host_save: Some(Box::new(move |ticket, _, _| {
+            *save_capture.borrow_mut() = Some(ticket.to_string());
+            Ok(())
+        })),
+        ..Default::default()
+    };
+    let mut app = SlideApp::new(Session::new(), services);
+    app.host_open("Talk.deckcraft", &initial);
+    app.session.execute("shape.insert", &json!({"preset": "ellipse", "rect": [80, 10, 40, 30]})).unwrap();
+    app.host_save_current().unwrap();
+    app.session.execute("shape.insert", &json!({"preset": "star5", "rect": [130, 10, 40, 30]})).unwrap();
+    events.borrow_mut().push(HostEvent::SaveResult { ticket: captured.borrow_mut().take().unwrap(), ok: true, error: None });
+    app.process_host_events();
+    assert!(app.session.active().unwrap().is_dirty());
+}
+
+#[test]
+fn failed_host_save_keeps_the_document_dirty() {
+    let source = Session::with_new();
+    let initial = deckcraft_engine::cmd::file::save_bytes(&source.active().unwrap().doc, "deckcraft").unwrap();
+    let events = Rc::new(RefCell::new(Vec::new()));
+    let captured = Rc::new(RefCell::new(None::<String>));
+    let save_capture = captured.clone();
+    let services = Services {
+        host_mode: true,
+        host_events: Some(events.clone()),
+        host_save: Some(Box::new(move |ticket, _, _| {
+            *save_capture.borrow_mut() = Some(ticket.to_string());
+            Ok(())
+        })),
+        ..Default::default()
+    };
+    let mut app = SlideApp::new(Session::new(), services);
+    app.host_open("Talk.deckcraft", &initial);
+    app.session.execute("shape.insert", &json!({"preset": "rect", "rect": [10, 10, 40, 30]})).unwrap();
+    app.host_save_current().unwrap();
+    events.borrow_mut().push(HostEvent::SaveResult {
+        ticket: captured.borrow_mut().take().unwrap(),
+        ok: false,
+        error: Some("storage rejected the write".into()),
+    });
+    app.process_host_events();
+    assert!(app.session.active().unwrap().is_dirty());
+}
