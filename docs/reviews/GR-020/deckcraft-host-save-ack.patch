@@ -0,0 +1,73 @@
+//! Same-origin parent-frame transport for file-host saves.
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use craft_platform::browser::host::{HostListener, HostMessage, HostTransport};
+use craft_platform::host_protocol::SaveTicket;
+use deckcraft_ui_egui::{HostEvent, Services};
+
+/// Owns the listener for the lifetime of the embedded editor.
+pub struct Bridge {
+    _transport: HostTransport,
+    _listener: HostListener,
+}
+
+/// Install the validated transport into the web UI services.
+pub fn install(services: &mut Services, ctx: egui::Context) -> Result<Bridge, String> {
+    let transport = HostTransport::current("deckcraft")
+        .map_err(|e| format!("host transport setup failed: {e:?}"))?
+        .ok_or_else(|| "host mode requires a same-origin parent frame".to_string())?;
+    let events = Rc::new(RefCell::new(Vec::new()));
+    let received = events.clone();
+    let pending_ticket = Rc::new(RefCell::new(None::<String>));
+    let listener_ticket = pending_ticket.clone();
+    let repaint = ctx.clone();
+    let listener = transport
+        .listen(move |message| {
+            let mut queue = received.borrow_mut();
+            match message {
+                HostMessage::Open { name, bytes }
+                    if bytes.len() <= 256 * 1024 * 1024 && queue.len() < 16 && !queue.iter().any(|event| matches!(event, HostEvent::Open { .. })) =>
+                {
+                    queue.push(HostEvent::Open { name, bytes });
+                }
+                HostMessage::Open { .. } => return,
+                HostMessage::SaveResult { ticket, ok, error } => {
+                    if listener_ticket.borrow().as_deref() != Some(ticket.as_str()) {
+                        return;
+                    }
+                    *listener_ticket.borrow_mut() = None;
+                    if queue.len() == 16 {
+                        queue.remove(0);
+                    }
+                    queue.push(HostEvent::SaveResult { ticket: ticket.as_str().to_string(), ok, error });
+                }
+            }
+            repaint.request_repaint();
+        })
+        .map_err(|e| format!("host message listener failed: {e:?}"))?;
+    if let Err(e) = transport.post_ready(env!("CARGO_PKG_VERSION")) {
+        let _ = transport.post_failed("DeckCraft could not start its host bridge");
+        return Err(format!("could not notify host that DeckCraft is ready: {e:?}"));
+    }
+
+    let saver = transport.clone();
+    services.host_mode = true;
+    services.host_events = Some(events);
+    services.host_open_request = Some(Box::new(move |purpose| saver.post_open_request(purpose).map_err(|e| format!("{e:?}"))));
+    let saver = transport.clone();
+    let save_ticket = pending_ticket.clone();
+    services.host_save = Some(Box::new(move |ticket, name, bytes| {
+        let ticket = SaveTicket::new(ticket.to_string()).ok_or_else(|| "invalid host save ticket".to_string())?;
+        *save_ticket.borrow_mut() = Some(ticket.as_str().to_string());
+        if let Err(e) = saver.post_save(&ticket, name, bytes, false) {
+            *save_ticket.borrow_mut() = None;
+            return Err(format!("{e:?}"));
+        }
+        Ok(())
+    }));
+    let reporter = transport.clone();
+    services.host_dirty = Some(Box::new(move |dirty| reporter.post_dirty(dirty).map_err(|e| format!("{e:?}"))));
+    Ok(Bridge { _transport: transport, _listener: listener })
+}
