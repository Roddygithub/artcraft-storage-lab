+use std::sync::Arc;
+
+use serde_json::json;
+
+use crate::Session;
+
+#[test]
+fn external_acknowledgement_keeps_later_edits_dirty() {
+    let mut session = Session::new();
+    session.execute("file.new", &json!({})).unwrap();
+    session.execute("shape.insert", &json!({"preset": "rect", "rect": [0, 0, 20, 20]})).unwrap();
+    let document = session.active().unwrap();
+    let uid = document.uid;
+    let snapshot = document.doc.clone();
+
+    session.execute("shape.insert", &json!({"preset": "ellipse", "rect": [30, 0, 20, 20]})).unwrap();
+    assert_eq!(session.acknowledge_external_save(uid, snapshot.clone()), Some(false));
+    assert!(session.active().unwrap().is_dirty());
+
+    let latest = session.active().unwrap().doc.clone();
+    assert_eq!(session.acknowledge_external_save(uid, latest), Some(true));
+    assert!(!session.active().unwrap().is_dirty());
+    assert!(Arc::ptr_eq(&session.active().unwrap().saved_doc, &session.active().unwrap().doc));
+}
+
+#[test]
+fn external_acknowledgement_refuses_pathful_documents() {
+    let mut session = Session::new();
+    session.execute("file.new", &json!({})).unwrap();
+    let document = session.active_mut().unwrap();
+    document.path = Some("native.deckcraft".into());
+    let uid = document.uid;
+    let snapshot = document.doc.clone();
+    assert_eq!(session.acknowledge_external_save(uid, snapshot), None);
+}
