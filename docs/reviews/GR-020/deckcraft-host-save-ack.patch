+    /// Record a host's durable commit of an exact serialized snapshot without a filesystem path.
+    /// Returns whether the live document is still that snapshot; later edits remain dirty.
+    pub fn acknowledge_external_save(&mut self, uid: u64, snapshot: Arc<Presentation>) -> Option<bool> {
+        let st = self.docs.iter_mut().find(|d| d.uid == uid)?;
+        if st.path.is_some() {
+            return None;
+        }
+        let clean = Arc::ptr_eq(&st.doc, &snapshot);
+        st.saved_doc = snapshot;
+        st.revision += 1;
+        if clean && let Some(dir) = &self.recovery_dir {
+            recovery::discard(dir, uid);
+        }
+        Some(clean)
+    }
