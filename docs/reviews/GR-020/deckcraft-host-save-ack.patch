+    fn host_open(&mut self, name: &str, bytes: &[u8]) {
+        const MAX_HOST_DOCUMENT_BYTES: usize = 256 * 1024 * 1024;
+        let extension = name.rsplit('.').next().unwrap_or_default().to_ascii_lowercase();
+        if !matches!(extension.as_str(), "deckcraft" | "pptx" | "potx" | "ppsx") {
+            self.notify(format!("{name}: host editing supports .deckcraft, .pptx, .potx and .ppsx"));
