diff --git c/apps/photocraft-web/src/host_inbox.rs w/apps/photocraft-web/src/host_inbox.rs
new file mode 100644
index 00000000..cd68cebf
--- /dev/null
+++ w/apps/photocraft-web/src/host_inbox.rs
@@ -0,0 +1,63 @@
+use std::mem;
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum HostEvent {
+    Open { name: String, bytes: Vec<u8> },
+    SaveResult { ticket: String, ok: bool, error: Option<String> },
+}
+
+#[derive(Default)]
+pub struct HostInbox {
+    open: Option<(String, Vec<u8>)>,
+    save_result: Option<(String, bool, Option<String>)>,
+}
+
+impl HostInbox {
+    /// Keep only the first Open and the one ACK for the currently outstanding save.
+    pub fn push(&mut self, event: HostEvent, expected_ticket: Option<&str>) {
+        match event {
+            HostEvent::Open { name, bytes } if self.open.is_none() => self.open = Some((name, bytes)),
+            HostEvent::SaveResult { ticket, ok, error } if expected_ticket == Some(ticket.as_str()) && self.save_result.is_none() => {
+                self.save_result = Some((ticket, ok, error));
+            }
+            HostEvent::Open { .. } | HostEvent::SaveResult { .. } => {}
+        }
+    }
+
+    pub fn take(&mut self) -> (Option<(String, Vec<u8>)>, Option<(String, bool, Option<String>)>) {
+        (mem::take(&mut self.open), mem::take(&mut self.save_result))
+    }
+}
+
+pub fn require_listener<T, E>(host_mode: bool, listener: Result<Option<T>, E>) -> Result<Option<T>, E> {
+    if host_mode { listener } else { Ok(None) }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn unknown_and_duplicate_results_cannot_grow_or_fill_queue_ahead_of_valid_ack() {
+        let mut inbox = HostInbox::default();
+        inbox.push(HostEvent::Open { name: "one.pcraft".into(), bytes: vec![1] }, None);
+        for _ in 0..10_000 {
+            inbox.push(HostEvent::SaveResult { ticket: "unknown".into(), ok: true, error: None }, Some("live-ticket"));
+        }
+        inbox.push(HostEvent::SaveResult { ticket: "live-ticket".into(), ok: true, error: None }, Some("live-ticket"));
+        for _ in 0..10_000 {
+            inbox.push(HostEvent::SaveResult { ticket: "live-ticket".into(), ok: false, error: None }, Some("live-ticket"));
+        }
+
+        let (open, result) = inbox.take();
+        assert_eq!(open, Some(("one.pcraft".into(), vec![1])));
+        assert_eq!(result, Some(("live-ticket".into(), true, None)));
+        assert_eq!(inbox.take(), (None, None));
+    }
+
+    #[test]
+    fn host_listener_failure_propagates_instead_of_allowing_ready() {
+        let result: Result<Option<()>, &str> = require_listener(true, Err("listener failed"));
+        assert_eq!(result, Err("listener failed"));
+    }
+}
