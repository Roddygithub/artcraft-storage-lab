+fn host_save_dispatch_waits_for_matching_durable_ack_and_guards_bypass_routes() {
+    let sent: Rc<RefCell<Vec<(String, Vec<u8>)>>> = Rc::default();
+    let capture = sent.clone();
+    let sequence = Rc::new(Cell::new(0_u8));
+    let next_sequence = sequence.clone();
+    let services = Services {
+        host_mode: true,
+        import: Some(Box::new(|name: &str, _: &[u8], _: &photocraft_io::ImportOptions| {
+            Ok((Document::new(name, Size::new(4, 4), ColorMode::Rgb, SampleType::U8), Vec::new()))
+        })),
+        export: Some(Box::new(|_: &Document, _: &str, _: &crate::ExportSettings| Ok((b"serialized-pcraft".to_vec(), Vec::new())))),
+        host_save: Some(Box::new(move |name, bytes| {
+            capture.borrow_mut().push((name.into(), bytes.to_vec()));
+            let next = next_sequence.get() + 1;
+            next_sequence.set(next);
+            Ok(format!("photocraft:test-{next}"))
+        })),
+        ..Default::default()
+    };
+    let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), services);
+    app.open_file_pathless("bound.pcraft", b"input").unwrap();
+    assert!(app.open_file_pathless("second.pcraft", b"input").is_err());
+    app.session.execute("layer.new.layer", json!({})).unwrap();
+    let ticket = menus::invoke(&mut app, &egui::Context::default(), "file.save", json!({})).unwrap();
+    assert_eq!(ticket, "photocraft:test-1");
+    assert_eq!(sent.borrow().as_slice(), [("bound.pcraft".into(), b"serialized-pcraft".to_vec())]);
+    assert!(app.host_save_result("wrong-ticket", true, None) == false);
+    assert!(app.save_host_snapshot().is_err(), "second write while a ticket is pending must be refused");
+    assert!(app.host_save_result("photocraft:test-1", false, Some("write rejected")));
+    assert!(app.session.active().unwrap().is_dirty(), "negative ACK must retain dirty state");
+    let retry_ticket = menus::invoke(&mut app, &egui::Context::default(), "file.save", json!({})).unwrap();
+    assert_eq!(retry_ticket, "photocraft:test-2");
+    assert_ne!(retry_ticket, ticket, "retry ticket must be unique");
+    assert!(!app.host_save_result("photocraft:test-1", true, None), "late duplicate ACK must not acknowledge a newer save");
+    assert!(app.host_save_result("photocraft:test-2", true, None));
+    assert!(!app.session.active().unwrap().is_dirty());
+    app.session.execute("layer.new.layer", json!({})).unwrap();
+    let timeout_ticket = menus::invoke(&mut app, &egui::Context::default(), "file.save", json!({})).unwrap();
+    app.host_save_timed_out();
+    assert!(app.save_host_snapshot().is_err(), "unknown save outcome must block retry");
+    menus::invoke(&mut app, &egui::Context::default(), "file.close", json!({})).unwrap();
+    assert_eq!(app.session.documents().len(), 1, "unresolved dirty document must not close");
+    assert!(app.host_save_result(timeout_ticket.as_str().unwrap(), true, None));
+    assert!(app.run("file.new", json!({"width": 8, "height": 8})).is_err());
+    assert!(app.run("file.saveAs", json!({"path":"copy.pcraft"})).is_err());
+}
