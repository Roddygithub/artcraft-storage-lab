diff --git c/crates/ui-egui/src/host_save_tests.rs w/crates/ui-egui/src/host_save_tests.rs
new file mode 100644
index 0000000..3e33896
--- /dev/null
+++ w/crates/ui-egui/src/host_save_tests.rs
@@ -0,0 +1,100 @@
+use std::{cell::RefCell, rc::Rc};
+
+use figcraft_engine::{Session, cmd::file::file_bytes};
+use serde_json::json;
+
+use crate::{FigApp, HostEvent, Services};
+
+#[derive(Default)]
+struct State {
+    events: Vec<HostEvent>,
+    saves: Vec<(String, String, Vec<u8>)>,
+    dirty: Vec<bool>,
+}
+
+struct Host(Rc<RefCell<State>>);
+
+impl Services for Host {
+    fn host_mode(&self) -> bool {
+        true
+    }
+    fn take_host_events(&mut self) -> Vec<HostEvent> {
+        std::mem::take(&mut self.0.borrow_mut().events)
+    }
+    fn host_save(&mut self, ticket: &str, name: &str, bytes: &[u8]) -> Result<(), String> {
+        self.0.borrow_mut().saves.push((ticket.into(), name.into(), bytes.into()));
+        Ok(())
+    }
+    fn host_dirty(&mut self, dirty: bool) -> Result<(), String> {
+        self.0.borrow_mut().dirty.push(dirty);
+        Ok(())
+    }
+}
+
+#[test]
+fn host_save_waits_for_ack_and_keeps_edits_made_while_pending() {
+    let mut source = Session::new();
+    source.execute("shape.rectangle", &json!({"x": 0, "y": 0, "width": 10, "height": 10})).unwrap();
+    let bytes = file_bytes(source.ds().unwrap()).unwrap();
+    let state = Rc::new(RefCell::new(State::default()));
+    state.borrow_mut().events.push(HostEvent::Open { name: "Board.figcraft".into(), bytes });
+    let mut app = FigApp::new(Session::empty(), Box::new(Host(state.clone())));
+    let ctx = egui::Context::default();
+    app.logic(&ctx);
+    assert_eq!(app.session.docs.len(), 1);
+    assert!(!app.session.ds().unwrap().is_dirty());
+
+    assert!(app.run("file.new", json!({})).is_none());
+    assert_eq!(app.session.docs.len(), 1, "host mode refuses a second document");
+    crate::menus::invoke(&mut app, "branch.create");
+    assert!(app.ui.versions.form.is_none(), "host mode refuses branch creation");
+    crate::menus::invoke(&mut app, "collab.join");
+    assert!(app.ui.live.join.is_none(), "host mode refuses the live-join dialog");
+    assert!(app.run("file.duplicate", json!({})).is_none(), "host mode refuses file duplication");
+    assert!(app.run("version.duplicate", json!({"id": "missing"})).is_none(), "host mode refuses version duplication");
+    assert_eq!(app.session.docs.len(), 1);
+
+    app.run("shape.rectangle", json!({"x": 20, "y": 0, "width": 10, "height": 10}));
+    app.save();
+    let (ticket, name, saved_bytes) = state.borrow().saves[0].clone();
+    assert_eq!(name, "Board.figcraft");
+    assert!(app.session.ds().unwrap().is_dirty(), "handoff is not durable acknowledgement");
+
+    state.borrow_mut().events.push(HostEvent::SaveResult { ticket: "unknown".into(), ok: true, error: None });
+    app.logic(&ctx);
+    assert!(app.session.ds().unwrap().is_dirty(), "unknown ticket cannot clean the drawing");
+    state.borrow_mut().events.push(HostEvent::SaveResult { ticket, ok: true, error: None });
+    app.logic(&ctx);
+    assert!(!app.session.ds().unwrap().is_dirty(), "unknown tickets must not consume a valid pending save");
+
+    let (saved, _) = figcraft_format::load_bytes(&saved_bytes).unwrap();
+    assert_eq!(saved.nodes().filter(|n| matches!(n.kind, figcraft_doc::NodeKind::Rectangle)).count(), 2);
+
+    app.run("shape.rectangle", json!({"x": 40, "y": 0, "width": 10, "height": 10}));
+    app.save();
+    let (ticket, _, saved_bytes) = state.borrow().saves[1].clone();
+    app.run("shape.rectangle", json!({"x": 60, "y": 0, "width": 10, "height": 10}));
+    state.borrow_mut().events.push(HostEvent::SaveResult { ticket, ok: true, error: None });
+    app.logic(&ctx);
+    assert!(app.session.ds().unwrap().is_dirty(), "edits after the snapshot remain dirty");
+    let (saved, _) = figcraft_format::load_bytes(&saved_bytes).unwrap();
+    assert_eq!(saved.nodes().filter(|n| matches!(n.kind, figcraft_doc::NodeKind::Rectangle)).count(), 3);
+    assert_eq!(app.session.doc().unwrap().nodes().filter(|n| matches!(n.kind, figcraft_doc::NodeKind::Rectangle)).count(), 4);
+
+    app.save();
+    let (ticket, _, _) = state.borrow().saves[2].clone();
+    state.borrow_mut().events.push(HostEvent::SaveResult { ticket, ok: true, error: None });
+    app.logic(&ctx);
+    assert!(!app.session.ds().unwrap().is_dirty());
+
+    assert!(app.run("file.saveAs", json!({})).is_none(), "host Save As is explicitly refused");
+
+    // Defend the one-document boundary even if a second document enters through an unexpected path.
+    app.session.execute("file.new", &json!({"name": "Unsupported second tab"})).unwrap();
+    app.run("shape.rectangle", json!({"x": 80, "y": 0, "width": 10, "height": 10}));
+    app.logic(&ctx);
+    assert_eq!(state.borrow().dirty.last(), Some(&true), "all dirty tabs must protect the host session from close");
+    let save_count = state.borrow().saves.len();
+    app.save();
+    assert_eq!(state.borrow().saves.len(), save_count, "an unsupported active tab must not save the bound file");
+}
