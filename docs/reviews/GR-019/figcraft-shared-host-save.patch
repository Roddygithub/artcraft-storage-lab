@@ -0,0 +1,96 @@
+//! Thin browser adapter for the shared Craft host transport.
+
+use std::{cell::RefCell, rc::Rc};
+
+use craft_platform::browser::host::{HostListener, HostMessage, HostTransport};
+use figcraft_ui_egui::HostEvent;
+
+pub struct HostBridge {
+    transport: Option<HostTransport>,
+    _listener: Option<HostListener>,
+    events: Rc<RefCell<Vec<HostMessage>>>,
+    requested: bool,
+}
+
+impl HostBridge {
+    pub fn new(ctx: egui::Context, requested: bool) -> Self {
+        let events = Rc::new(RefCell::new(Vec::new()));
+        let (transport, listener) = if requested {
+            match HostTransport::current("figcraft") {
+                Ok(Some(transport)) => {
+                    let queue = events.clone();
+                    let wake = ctx.clone();
+                    match transport.listen(move |message| {
+                        queue.borrow_mut().push(message);
+                        wake.request_repaint();
+                    }) {
+                        Ok(listener) => {
+                            if let Err(e) = transport.post_ready(env!("CARGO_PKG_VERSION")) {
+                                log::error!("couldn't announce FigCraft host readiness: {e:?}");
+                                (None, None)
+                            } else {
+                                (Some(transport), Some(listener))
+                            }
+                        }
+                        Err(e) => {
+                            log::error!("couldn't listen for FigCraft host messages: {e:?}");
+                            (None, None)
+                        }
+                    }
+                }
+                Ok(None) => {
+                    log::error!("FigCraft host mode requires a same-origin parent frame");
+                    (None, None)
+                }
+                Err(e) => {
+                    log::error!("couldn't initialize FigCraft host transport: {e:?}");
+                    (None, None)
+                }
+            }
+        } else {
+            (None, None)
+        };
+        Self { transport, _listener: listener, events, requested }
+    }
+
+    pub fn is_requested(&self) -> bool {
+        self.requested
+    }
+
+    pub fn is_available(&self) -> bool {
+        self.transport.is_some()
+    }
+
+    pub fn take_events(&self) -> Vec<HostEvent> {
+        self.events
+            .borrow_mut()
+            .drain(..)
+            .map(|message| match message {
+                HostMessage::Open { name, bytes } => HostEvent::Open { name, bytes },
+                HostMessage::SaveResult { ticket, ok, error } => HostEvent::SaveResult { ticket: ticket.as_str().to_owned(), ok, error },
+            })
+            .collect()
+    }
+
+    pub fn save(&self, ticket: &str, name: &str, bytes: &[u8]) -> Result<(), String> {
+        let transport = self.transport.as_ref().ok_or_else(|| "The FigCraft host transport is unavailable".to_string())?;
+        let ticket = craft_platform::host_protocol::SaveTicket::new(ticket).ok_or_else(|| "Invalid save ticket".to_string())?;
+        transport.post_save(&ticket, name, bytes, false).map_err(|e| format!("Couldn't send save to host: {e:?}"))
+    }
+
+    pub fn open_request(&self) -> Result<(), String> {
+        self.transport
+            .as_ref()
+            .ok_or_else(|| "The FigCraft host transport is unavailable".to_string())?
+            .post_open_request("open")
+            .map_err(|e| format!("Couldn't request a file from the host: {e:?}"))
+    }
+
+    pub fn dirty(&self, dirty: bool) -> Result<(), String> {
+        self.transport
+            .as_ref()
+            .ok_or_else(|| "The FigCraft host transport is unavailable".to_string())?
+            .post_dirty(dirty)
+            .map_err(|e| format!("Couldn't report FigCraft dirty state: {e:?}"))
+    }
+}
