diff --git c/apps/soundcraft-web/src/host_save.rs w/apps/soundcraft-web/src/host_save.rs
new file mode 100644
index 0000000..0d3a4d6
--- /dev/null
+++ w/apps/soundcraft-web/src/host_save.rs
@@ -0,0 +1,106 @@
+use std::time::Duration;
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum AckResult {
+    Unknown,
+    Rejected,
+    SavedCurrent,
+    SavedStale,
+}
+
+struct Pending<T> {
+    ticket: String,
+    snapshot: T,
+    started_ms: f64,
+}
+
+/// One outstanding host save. Timeout means unknown commit state and blocks retry.
+pub struct HostSaveLedger<T> {
+    pending: Option<Pending<T>>,
+    unknown: bool,
+}
+
+impl<T> Default for HostSaveLedger<T> {
+    fn default() -> Self {
+        Self { pending: None, unknown: false }
+    }
+}
+
+impl<T> HostSaveLedger<T> {
+    pub fn can_start(&self) -> bool {
+        !self.unknown && self.pending.is_none()
+    }
+
+    pub fn is_unknown(&self) -> bool {
+        self.unknown
+    }
+
+    pub fn is_pending(&self) -> bool {
+        self.pending.is_some()
+    }
+
+    pub fn start(&mut self, ticket: String, snapshot: T, now_ms: f64) -> Result<(), T> {
+        if !self.can_start() || ticket.is_empty() || ticket.len() > 256 {
+            return Err(snapshot);
+        }
+        self.pending = Some(Pending { ticket, snapshot, started_ms: now_ms });
+        Ok(())
+    }
+
+    pub fn acknowledge(&mut self, ticket: &str, ok: bool, is_current: impl FnOnce(&T) -> bool) -> AckResult {
+        if !self.pending.as_ref().is_some_and(|pending| pending.ticket == ticket) {
+            return AckResult::Unknown;
+        }
+        let Some(pending) = self.pending.take() else { return AckResult::Unknown };
+        if !ok {
+            AckResult::Rejected
+        } else if is_current(&pending.snapshot) {
+            AckResult::SavedCurrent
+        } else {
+            AckResult::SavedStale
+        }
+    }
+
+    pub fn expire(&mut self, now_ms: f64, timeout: Duration) -> bool {
+        if self.pending.as_ref().is_some_and(|pending| now_ms - pending.started_ms >= timeout.as_millis() as f64) {
+            self.pending = None;
+            self.unknown = true;
+            true
+        } else {
+            false
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn ticket_ack_is_single_use_and_failed_save_can_retry() {
+        let mut ledger = HostSaveLedger::default();
+        assert!(ledger.start("soundcraft:1".into(), 7, 0.0).is_ok());
+        assert!(ledger.is_pending());
+        assert!(!ledger.is_unknown());
+        assert!(!ledger.can_start());
+        assert_eq!(ledger.acknowledge("unknown", true, |_| true), AckResult::Unknown);
+        assert!(!ledger.can_start());
+        assert_eq!(ledger.acknowledge("soundcraft:1", false, |_| true), AckResult::Rejected);
+        assert_eq!(ledger.acknowledge("soundcraft:1", true, |_| true), AckResult::Unknown);
+        assert!(ledger.can_start());
+    }
+
+    #[test]
+    fn only_an_acknowledged_unchanged_snapshot_is_clean_and_timeout_locks_retry() {
+        let mut ledger = HostSaveLedger::default();
+        assert!(ledger.start("soundcraft:1".into(), 7, 0.0).is_ok());
+        assert_eq!(ledger.acknowledge("soundcraft:1", true, |snapshot| *snapshot == 7), AckResult::SavedCurrent);
+        assert!(ledger.start("soundcraft:2".into(), 8, 1.0).is_ok());
+        assert_eq!(ledger.acknowledge("soundcraft:2", true, |snapshot| *snapshot == 7), AckResult::SavedStale);
+        assert!(ledger.start("soundcraft:3".into(), 9, 2.0).is_ok());
+        assert!(ledger.expire(120_002.0, Duration::from_secs(120)));
+        assert_eq!(ledger.acknowledge("soundcraft:3", true, |_| true), AckResult::Unknown);
+        assert!(!ledger.can_start());
+        assert!(!ledger.expire(120_003.0, Duration::from_secs(120)));
+    }
+}
