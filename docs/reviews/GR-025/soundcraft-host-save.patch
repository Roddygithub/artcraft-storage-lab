+#[derive(Default)]
+struct HostSaveState {
+    opened: bool,
+    next_ticket: u64,
+    ledger: HostSaveLedger<Arc<soundcraft_model::Session>>,
+    last_dirty: Option<bool>,
+}
+
+struct HostRuntime {
+    transport: HostTransport,
+    _listener: HostListener,
+    events: Rc<RefCell<Vec<HostMessage>>>,
+    state: Rc<RefCell<HostSaveState>>,
+}
+
+fn request_host_save(engine: &mut Engine, transport: &HostTransport, state: &Rc<RefCell<HostSaveState>>) -> Result<(), String> {
+    let mut state = state.borrow_mut();
+    if !state.opened {
+        return Err("No host-bound .scraftz session is open".into());
+    }
+    if state.ledger.is_unknown() {
+        return Err("Previous save outcome is unknown; reopen the host document before saving again".into());
+    }
+    if state.ledger.is_pending() {
+        return Err("A host save is already pending".into());
+    }
+    if !engine.is_dirty() {
+        return Err("The host-bound session has no unsaved changes".into());
+    }
+    let snapshot = engine.session_arc();
+    let (bytes, _) = io::session_bundle(&snapshot).map_err(|error| error.to_string())?;
+    if bytes.len() > MAX_HOST_SAVE_BYTES {
+        return Err(format!("Host save exceeds the {} MiB limit", MAX_HOST_SAVE_BYTES / (1024 * 1024)));
+    }
+    state.next_ticket = state.next_ticket.checked_add(1).ok_or("Host save ticket space exhausted")?;
+    let ticket = SaveTicket::new(format!("soundcraft:{}", state.next_ticket)).ok_or("Invalid host save ticket")?;
+    let name = format!("{}.{}", io::sanitize_name(&snapshot.name), io::BUNDLE_EXTENSION);
+    transport.post_save(&ticket, &name, &bytes, false).map_err(|error| format!("Host save handoff failed: {error:?}"))?;
+    state
+        .ledger
+        .start(ticket.as_str().to_owned(), snapshot, js_sys::Date::now())
+        .map_err(|_| "A host save is already pending or its outcome is unknown".to_string())?;
+    Ok(())
+}
+
+impl WebShell {
+    fn handle_host(&mut self) {
+        let Some(host) = &self.host else {
+            if self.host_requested {
+                self.app.ui.status = "Host mode unavailable: SoundCraft requires a same-origin parent frame".into();
+            }
+            return;
+        };
+        let events = std::mem::take(&mut *host.events.borrow_mut());
+        for event in events {
+            match event {
+                HostMessage::Open { name, bytes } => {
+                    if host.state.borrow().opened {
+                        self.app.ui.status = "Opening another host document is unsupported in this session".into();
+                    } else if !name.to_ascii_lowercase().ends_with(".scraftz") {
+                        self.app.ui.status = "SoundCraft host mode accepts one .scraftz session".into();
+                    } else if !bytes.starts_with(b"PK\x03\x04") {
+                        self.app.ui.status = "The host document is not a valid .scraftz bundle".into();
+                    } else {
+                        match io::open_session_bytes(&mut self.app.engine, &name, &bytes) {
+                            Ok(missing) => {
+                                host.state.borrow_mut().opened = true;
+                                self.app.engine.path = None;
+                                self.app.ui.status = if missing.is_empty() {
+                                    format!("Opened {name} from host")
+                                } else {
+                                    format!("Opened {name}; missing media: {}", missing.join(", "))
+                                };
+                                let _ = host.transport.post_dirty(self.app.engine.is_dirty());
+                                host.state.borrow_mut().last_dirty = Some(self.app.engine.is_dirty());
+                            }
+                            Err(error) => self.app.ui.status = error.to_string(),
+                        }
+                    }
+                }
+                HostMessage::SaveResult { ticket, ok, error } => {
+                    let live = self.app.engine.session_arc();
+                    let result = host.state.borrow_mut().ledger.acknowledge(ticket.as_str(), ok, |snapshot| Arc::ptr_eq(snapshot, &live));
+                    match result {
+                        AckResult::Unknown => self.app.ui.status = "Ignored unknown or duplicate host save acknowledgement".into(),
+                        AckResult::Rejected => {
+                            let reason = error.unwrap_or_else(|| "host rejected the save".into());
+                            self.app.ui.status = format!("Host save failed: {reason}");
+                        }
+                        AckResult::SavedCurrent => {
+                            self.app.engine.mark_clean();
+                            self.app.ui.status = "Saved — host confirmed the new version".into();
+                            let dirty = self.app.engine.is_dirty();
+                            let _ = host.transport.post_dirty(dirty);
+                            host.state.borrow_mut().last_dirty = Some(dirty);
+                        }
+                        AckResult::SavedStale => {
+                            self.app.ui.status = "Host saved the snapshot; newer edits remain unsaved".into();
+                        }
+                    }
+                }
+            }
+        }
+        let mut state = host.state.borrow_mut();
+        if state.ledger.expire(js_sys::Date::now(), HOST_SAVE_TIMEOUT) {
+            self.app.ui.status = "Host save timed out; outcome is unknown. Reopen the host document before saving again".into();
+        }
+        let dirty = self.app.engine.is_dirty();
+        if state.opened && state.last_dirty != Some(dirty) {
+            let _ = host.transport.post_dirty(dirty);
+            state.last_dirty = Some(dirty);
+        }
+    }
 }
 
