+/// Install a project supplied by an embedding host. Unlike `file.open`, this has no filesystem
+/// path and does not register a local recent-file entry.
+pub(crate) fn open_project_bytes(s: &mut Session, bytes: &[u8]) -> Result<Value> {
+    let loaded = filmcraft_format::decode(bytes).map_err(|e| EngineError::Other(e.to_string()))?;
+    let (from, migrated) = (loaded.schema_version, loaded.migrated());
+    install_project(s, loaded.project, None, true);
+    if let Some(view) = loaded.view.filter(|_| s.prefs.timeline.restore_open_sequences) {
+        s.restore_project_view(view);
+    }
+    if let Some(seq) = s.state.active_sequence {
+        s.events.push(crate::Event::OpenSequence(seq));
+    }
+    s.loaded_schema = from;
+    if migrated {
+        s.toast(format!("Upgraded project from schema v{from} to v{}; saving will create the current format", filmcraft_format::SCHEMA_VERSION));
+    }
+    let missing = crate::relink::on_open(s);
+    Ok(json!({"schemaVersion": from, "migrated": migrated, "missingMedia": missing}))
+}
+
 fn open_project(s: &mut Session, path: &str) -> Result<Value> {
     let bytes = s.services.read_file(path).map_err(|e| EngineError::Other(format!("{path}: {e}")))?;
     let loaded = filmcraft_format::decode(&bytes).map_err(|e| EngineError::Other(format!("{path}: {e}")))?;
diff --git c/crates/engine/src/host_save_tests.rs w/crates/engine/src/host_save_tests.rs
new file mode 100644
index 00000000..a20ac7e0
--- /dev/null
+++ w/crates/engine/src/host_save_tests.rs
@@ -0,0 +1,79 @@
+use serde_json::json;
+
+use crate::Session;
+
+fn fixture() -> Vec<u8> {
+    filmcraft_format::encode(&filmcraft_project::Project::new("Host fixture"), false)
+}
+
+#[test]
+fn host_save_ack_commits_only_the_serialized_revision_and_reopens() {
+    let mut session = Session::default();
+    session.open_host_project("Timeline.fcproj", &fixture()).expect("host project opens");
+    assert!(session.path.is_none());
+    session.execute("project.setNotes", json!({"text":"saved snapshot"})).expect("edit");
+
+    let request = session.begin_host_save().expect("serialize snapshot");
+    assert!(session.is_dirty(), "handoff alone cannot mark clean");
+    assert!(session.begin_host_save().is_err(), "only one ticket per bound session");
+    let saved_project = filmcraft_format::decode(&request.bytes).expect("request bytes decode").project;
+    assert_eq!(saved_project.notes, "saved snapshot");
+
+    session.execute("project.setNotes", json!({"text":"newer edit"})).expect("later edit");
+    assert_eq!(session.finish_host_save(&request.ticket, true), Some(false));
+    assert!(session.is_dirty(), "ACK for earlier snapshot preserves later edit");
+    assert!(session.finish_host_save(&request.ticket, true).is_none(), "ticket consumed once");
+
+    let latest = session.begin_host_save().expect("retry after known ACK");
+    assert_eq!(session.finish_host_save(&latest.ticket, true), Some(true));
+    assert!(!session.is_dirty());
+    let mut reopened = Session::default();
+    reopened.open_host_project("Timeline.fcproj", &latest.bytes).expect("fresh session reopen");
+    assert_eq!(reopened.project.notes, "newer edit");
+}
+
+#[test]
+fn failed_ack_keeps_project_dirty_and_rejects_replacement_routes() {
+    let mut session = Session::default();
+    session.open_host_project("Timeline.fcproj", &fixture()).expect("host project opens");
+    session.execute("project.setNotes", json!({"text":"edit"})).expect("edit");
+    let request = session.begin_host_save().expect("serialize");
+    assert_eq!(session.finish_host_save(&request.ticket, false), Some(false));
+    assert!(session.is_dirty());
+    for command in [
+        "file.open",
+        "file.newProject",
+        "file.newProjectFromTemplate",
+        "file.closeProject",
+        "file.closeAllProjects",
+        "file.saveAs",
+        "file.saveCopy",
+        "file.saveAsTemplate",
+        "file.recover",
+    ] {
+        assert!(session.execute(command, json!({})).is_err(), "{command} must fail closed");
+    }
+}
+
+#[test]
+fn unknown_timeout_does_not_release_ticket_for_unsafe_retry() {
+    let mut session = Session::default();
+    session.open_host_project("Timeline.fcproj", &fixture()).expect("host project opens");
+    session.execute("project.setNotes", json!({"text":"edit"})).expect("edit");
+    let request = session.begin_host_save().expect("serialize");
+    assert!(session.has_pending_host_save());
+    assert!(session.begin_host_save().is_err());
+    assert!(session.is_dirty());
+    assert!(session.finish_host_save("other-ticket", true).is_none());
+    assert!(session.has_pending_host_save());
+    assert!(session.finish_host_save(&request.ticket, false).is_some());
+}
+
+#[test]
+fn host_open_refuses_to_replace_pre_open_edits() {
+    let mut session = Session::default();
+    session.execute("project.setNotes", json!({"text":"typed before parent open"})).expect("pre-open edit");
+    assert!(session.open_host_project("Timeline.fcproj", &fixture()).is_err());
+    assert_eq!(session.project.notes, "typed before parent open");
+    assert!(session.host_project_name().is_none());
+}
