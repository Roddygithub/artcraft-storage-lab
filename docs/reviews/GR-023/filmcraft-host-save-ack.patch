+#[cfg(test)]
+mod host_save_tests {
+    use std::{cell::RefCell, rc::Rc};
+
+    use serde_json::json;
+
+    use super::invoke;
+
+    #[test]
+    fn control_save_posts_snapshot_and_waits_for_engine_ack() {
+        let bytes = filmcraft_format::encode(&filmcraft_project::Project::new("Host"), false);
+        let mut session = filmcraft_engine::Session::default();
+        session.open_host_project("Host.fcproj", &bytes).expect("open host document");
+        session.execute("project.setNotes", json!({"text":"edited"})).expect("edit");
+        let mut app = crate::FilmcraftApp::new(session);
+        app.host_mode = true;
+        let captured: Rc<RefCell<Vec<(String, String, Vec<u8>)>>> = Rc::default();
+        let sink = captured.clone();
+        app.hooks.host_save = Some(Box::new(move |ticket, name, bytes| {
+            sink.borrow_mut().push((ticket.into(), name.into(), bytes.into()));
+            Ok(())
+        }));
+        let ctx = egui::Context::default();
+        let (request, _reply) = crate::ControlRequest::new("engine.execute", json!({"command":"file.save", "params":{}}));
+        let outcome = crate::control::handle(&mut app, &ctx, &request);
+        assert!(matches!(outcome, crate::control::Outcome::Done(ref value) if value["ok"] == true && value["result"]["pending"] == true));
+        let saved = captured.borrow();
+        assert_eq!(saved.len(), 1);
+        assert_eq!(saved[0].1, "Host.fcproj");
+        assert_eq!(filmcraft_format::decode(&saved[0].2).expect("captured project").project.notes, "edited");
+        assert!(app.session.is_dirty(), "postMessage handoff is not a durable ACK");
+        assert!(app.session.has_pending_host_save());
+    }
+
+    #[test]
+    fn host_save_as_and_replacement_fail_visibly() {
+        let bytes = filmcraft_format::encode(&filmcraft_project::Project::new("Host"), false);
+        let mut session = filmcraft_engine::Session::default();
+        session.open_host_project("Host.fcproj", &bytes).expect("open host document");
+        let mut app = crate::FilmcraftApp::new(session);
+        app.host_mode = true;
+        let ctx = egui::Context::default();
+        for command in
+            ["file.saveAs", "file.saveCopy", "file.saveAsTemplate", "file.open", "file.newProject", "file.newProjectFromTemplate", "file.closeAllProjects"]
+        {
+            assert!(invoke(&mut app, &ctx, command, json!({})).is_err(), "{command}");
+        }
+        assert!(!app.session.has_pending_host_save());
+    }
+
+    #[test]
+    fn failed_host_handoff_cancels_ticket_but_keeps_dirty_state() {
+        let bytes = filmcraft_format::encode(&filmcraft_project::Project::new("Host"), false);
+        let mut session = filmcraft_engine::Session::default();
+        session.open_host_project("Host.fcproj", &bytes).expect("open host document");
+        session.execute("project.setNotes", json!({"text":"edited"})).expect("edit");
+        let mut app = crate::FilmcraftApp::new(session);
+        app.host_mode = true;
+        app.hooks.host_save = Some(Box::new(|_, _, _| Err("post failed".into())));
+        assert!(invoke(&mut app, &egui::Context::default(), "file.save", json!({})).is_err());
+        assert!(!app.session.has_pending_host_save());
+        assert!(app.session.is_dirty());
+    }
+}
