+    /// Open a native FilmCraft project supplied by an external host, without inventing a path.
+    /// This session can be host-bound only once; replacement requires a fresh editor instance.
+    pub fn open_host_project(&mut self, name: &str, bytes: &[u8]) -> Result<Value> {
+        if self.host_project_name.is_some() {
+            return Err(EngineError::Other("this editor session is already bound to a host document".into()));
+        }
+        if self.path.is_some()
+            || self.is_dirty()
+            || self.project.name != "Untitled"
+            || !self.project.items.is_empty()
+            || self.project.sequences().next().is_some()
+            || !self.history.undo.is_empty()
+            || !self.history.redo.is_empty()
+        {
+            return Err(EngineError::Other("host open is refused because this editor session already contains a project".into()));
+        }
+        if name.trim().is_empty() || name.len() > 4096 {
+            return Err(EngineError::Other("host document name is empty or too long".into()));
+        }
+        if !name.to_ascii_lowercase().ends_with(".fcproj") {
+            return Err(EngineError::Other("host mode accepts only native .fcproj projects".into()));
+        }
+        if bytes.len() > 256 * 1024 * 1024 {
+            return Err(EngineError::Other("host project exceeds the 256 MiB limit".into()));
+        }
+        let result = commands::open_project_bytes(self, bytes)?;
+        self.path = None;
+        self.host_project_name = Some(name.to_owned());
+        Ok(result)
+    }
+
+    pub fn host_project_name(&self) -> Option<&str> {
+        self.host_project_name.as_deref()
+    }
+
+    /// Serialize the current host-bound project and retain the exact snapshot until its ACK.
+    /// A timeout does not clear this record: the host may have committed but lost the response.
+    pub fn begin_host_save(&mut self) -> Result<HostSaveRequest> {
+        if self.host_project_name.is_none() || self.path.is_some() {
+            return Err(EngineError::Other("no pathless host project is open".into()));
