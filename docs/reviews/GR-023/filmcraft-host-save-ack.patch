new file mode 100644
index 00000000..ba79b334
--- /dev/null
+++ w/apps/filmcraft-web/src/host.rs
@@ -0,0 +1,134 @@
+//! Opt-in, same-origin host save bridge for one FilmCraft project per iframe.
+use std::{cell::RefCell, rc::Rc, time::Duration};
+
+use craft_platform::{
+    browser::host::{HostListener, HostMessage, HostTransport},
+    host_protocol::SaveTicket,
+};
+use filmcraft_ui_egui::FilmcraftApp;
+use web_time::Instant;
+
+#[derive(Default)]
+struct Events {
+    opened: bool,
+    open: Option<(String, Vec<u8>)>,
+    ack: Option<(SaveTicket, bool, Option<String>)>,
+}
+
+#[derive(Default)]
+struct Pending {
+    ticket: Option<SaveTicket>,
+    sent_at: Option<Instant>,
+    timeout_reported: bool,
+}
+
+pub struct HostBridge {
+    transport: HostTransport,
+    _listener: HostListener,
+    events: Rc<RefCell<Events>>,
+    pending: Rc<RefCell<Pending>>,
+    last_dirty: Option<bool>,
+}
+
+impl HostBridge {
+    pub fn new() -> Result<Option<Self>, String> {
+        let Some(transport) = HostTransport::current("filmcraft").map_err(|e| format!("host transport: {e:?}"))? else {
+            return Ok(None);
+        };
+        let events = Rc::new(RefCell::new(Events::default()));
+        let pending = Rc::new(RefCell::new(Pending::default()));
+        let event_state = events.clone();
+        let pending_state = pending.clone();
+        let listener = transport
+            .listen(move |message| {
+                let mut events = event_state.borrow_mut();
+                match message {
+                    HostMessage::Open { name, bytes } if !events.opened && events.open.is_none() => {
+                        events.opened = true;
+                        events.open = Some((name, bytes));
+                        crate::repaint();
+                    }
+                    HostMessage::SaveResult { ticket, ok, error } => {
+                        let pending = pending_state.borrow();
+                        if pending.ticket.as_ref() == Some(&ticket) && events.ack.is_none() {
+                            events.ack = Some((ticket, ok, error));
+                            crate::repaint();
+                        }
+                    }
+                    _ => {}
+                }
+            })
+            .map_err(|e| format!("host listener: {e:?}"))?;
+        Ok(Some(Self { transport, _listener: listener, events, pending, last_dirty: None }))
+    }
+
+    pub fn ready(&self) -> Result<(), String> {
+        self.transport.post_ready(env!("CARGO_PKG_VERSION")).map_err(|e| format!("host ready: {e:?}"))
+    }
+
+    pub fn save_hook(&self) -> Box<dyn FnMut(&str, &str, &[u8]) -> Result<(), String>> {
+        let transport = self.transport.clone();
+        let pending = self.pending.clone();
+        Box::new(move |ticket, name, bytes| {
+            let ticket = SaveTicket::new(ticket.to_owned()).ok_or("invalid save ticket")?;
+            {
+                let mut state = pending.borrow_mut();
+                if state.ticket.is_some() {
+                    return Err("a host save is already pending".into());
+                }
+                state.ticket = Some(ticket.clone());
+                state.sent_at = Some(Instant::now());
+                state.timeout_reported = false;
+            }
+            if let Err(error) = transport.post_save(&ticket, name, bytes, false) {
+                *pending.borrow_mut() = Pending::default();
+                return Err(format!("host save post failed: {error:?}"));
+            }
+            Ok(())
+        })
+    }
+
+    pub fn tick(&mut self, app: &mut FilmcraftApp, ctx: &egui::Context) {
+        if let Some((name, bytes)) = self.events.borrow_mut().open.take() {
+            if !name.to_ascii_lowercase().ends_with(".fcproj") {
+                let error = "host only supports native .fcproj projects";
+                app.status(error);
+                let _ = self.transport.post_failed(error);
+            } else if let Err(error) = app.session.open_host_project(&name, &bytes) {
+                let error = error.to_string();
+                app.status(error.clone());
+                let _ = self.transport.post_failed(&error);
+            } else {
+                app.status(format!("Opened {name}"));
+            }
+        }
+        if let Some((ticket, ok, error)) = self.events.borrow_mut().ack.take() {
+            let _ = self.pending.borrow_mut().ticket.take();
+            self.pending.borrow_mut().sent_at = None;
+            self.pending.borrow_mut().timeout_reported = false;
+            match app.session.finish_host_save(ticket.as_str(), ok) {
+                Some(true) => app.status("Saved to host"),
+                Some(false) if !ok => app.status(error.unwrap_or_else(|| "Host save failed; the project remains unsaved".into())),
+                Some(false) if app.session.is_dirty() => app.status("Earlier changes saved; newer project changes remain unsaved"),
+                Some(false) => app.status("Host save result could not be applied; reopen from the file host"),
+                None => {}
+            }
+        }
+        let mut pending = self.pending.borrow_mut();
+        if let Some(sent_at) = pending.sent_at {
+            let timeout = Duration::from_secs(120);
+            let elapsed = sent_at.elapsed();
+            if elapsed >= timeout && !pending.timeout_reported {
+                pending.timeout_reported = true;
+                app.status("Save outcome unknown; the host may have committed it. Reopen or reconcile before retrying.");
+            } else if !pending.timeout_reported {
+                ctx.request_repaint_after(timeout.saturating_sub(elapsed));
+            }
+        }
+        drop(pending);
+        let dirty = app.session.is_dirty() || app.session.has_pending_host_save();
+        if self.last_dirty != Some(dirty) && self.transport.post_dirty(dirty).is_ok() {
+            self.last_dirty = Some(dirty);
+        }
+    }
+}
