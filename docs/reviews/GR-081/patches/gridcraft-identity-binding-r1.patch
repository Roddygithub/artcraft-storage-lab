+    /// calls this method. No password prompt/retry can substitute another initial document.
+    pub fn open_host_document(&mut self, name: &str, bytes: &[u8]) -> Result<u64> {
+        if self.host_document != Some(None) || self.host_open_attempted { return Err(self.host_refuse()); }
+        self.host_open_attempted = true;
+        cmd::file::open(self, &serde_json::json!({ "name": name, "base64": io::base64_encode(bytes) }))?;
+        let uid = self.doc()?.uid;
+        self.host_name = Some(name.to_string());
+        self.host_document = Some(Some(uid));
+        Ok(uid)
+    }
