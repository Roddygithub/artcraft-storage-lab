+    pub fn serialize_host_save(&self) -> Result<(u64, Arc<Workbook>, String, Vec<u8>)> {
+        let uid = self.host_document_id()?;
+        let name = self.host_name.as_ref().ok_or_else(|| self.host_refuse())?;
+        let snapshot = self.doc()?.wb.clone();
+        let bytes = io::save_bytes(&snapshot, name)?;
+        Ok((uid, snapshot, name.clone(), bytes))
+    }
