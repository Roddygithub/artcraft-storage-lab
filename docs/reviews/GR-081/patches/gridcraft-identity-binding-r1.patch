+            || matches!(id, "window.activate" | "view.newWindow" | "view.hideWindow" | "view.unhideWindow")
+            || (id == "file.save" && !params.is_null() && params.as_object().is_none_or(|p| !p.is_empty()));
+        if denied { return Err(self.host_refuse()); }
+        Ok(())
+    }
