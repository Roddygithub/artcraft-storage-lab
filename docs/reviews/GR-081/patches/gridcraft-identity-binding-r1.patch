+    /// Call before exposing the UI; a missing/old parent leaves it locked.
+    pub fn lock_to_host(&mut self) {
+        if self.host_document.is_none() { self.host_document = Some(None); }
+    }
+    pub fn block_host(&mut self) {
+        if self.host_document.is_some() {
+            self.host_document = Some(None);
+            self.host_open_attempted = true;
+        }
+    }
+    pub fn host_update_only(&self) -> bool { self.host_document.is_some() }
+    pub fn host_rejection_revision(&self) -> u64 { self.host_rejections.get() }
+    pub fn host_rejected(&self) -> bool { self.host_rejections.get() != self.host_saved_rejections }
+    pub fn host_acknowledged(&mut self, revision: u64) {
+        if revision == self.host_rejections.get() && revision != u64::MAX { self.host_saved_rejections = revision; }
+    }
+    pub fn host_refuse(&self) -> EngineError {
+        self.host_rejections.set(self.host_rejections.get().saturating_add(1));
+        EngineError::BadParams { cmd: "host.update".into(), msg: "this session can only update the host's initial workbook".into() }
+    }
+    pub fn host_document_id(&self) -> Result<u64> {
+        match self.host_document {
+            Some(Some(uid)) if self.active().is_some_and(|d| d.uid == uid) => Ok(uid),
+            Some(Some(_)) => Err(self.host_refuse()),
+            _ => Err(EngineError::BadParams { cmd: "host.update".into(), msg: "waiting for the trusted host workbook".into() }),
+        }
+    }
