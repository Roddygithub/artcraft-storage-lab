+def _matches_file_type(file_path, content):
+    ext = os.path.splitext(file_path)[1].lower()
+    if ext == '.pdf':
+        return content.startswith(b'%PDF-')
+    if ext == '.svg':
+        try:
+            root = ElementTree.fromstring(content)
+        except ElementTree.ParseError:
+            return False
+        return root.tag.rsplit('}', 1)[-1].lower() == 'svg'
+    expected = {
+        '.docx': 'wordprocessingml.document',
+        '.xlsx': 'spreadsheetml.sheet',
+        '.pptx': 'presentationml.presentation',
+    }.get(ext)
+    if expected:
+        try:
+            with zipfile.ZipFile(io.BytesIO(content)) as archive:
+                entry = archive.getinfo('[Content_Types].xml')
+                if entry.file_size > MAX_CONTENT_TYPES_XML_BYTES:
+                    return False
+                with archive.open(entry) as stream:
+                    raw_types = stream.read(MAX_CONTENT_TYPES_XML_BYTES + 1)
+                if len(raw_types) > MAX_CONTENT_TYPES_XML_BYTES:
+                    return False
+                types = raw_types.decode('utf-8')
+                return expected in types
+        except (KeyError, OSError, RuntimeError, UnicodeDecodeError, zipfile.BadZipFile):
+            return False
+    return True
+
+
+def _artcraft_capability_allows_save(info, settings_obj, file_path):
+    """Preserve the narrow write authority granted by the ArtCraft route."""
+    extension = os.path.splitext(file_path)[1].lower().lstrip('.')
+    permission = info.get('permission') or {}
+    return (
+        info.get('audience') == 'artcraft'
+        and permission.get('can_edit') is True
+        and info.get('repo_id') in getattr(settings_obj, 'ARTCRAFT_REPO_IDS', ())
+        and extension in getattr(settings_obj, 'ARTCRAFT_FILE_EXTENSIONS', ())
+    )
 
