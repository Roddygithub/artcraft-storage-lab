+class ThirdpartyEditorFileSaveView(APIView):
+    """Save one third-party editor document as its current Seafile user."""
+
+    authentication_classes = []
+    permission_classes = []
+
+    def post(self, request, format=None):
+        token = request.GET.get('access_token')
+        if not token:
+            return HttpResponse(json.dumps({'error': 'invalid token'}), status=401,
+                                content_type=json_content_type)
+        info = cache.get('thirdparty_editor_access_token_' + token)
+        if not info:
+            return HttpResponse(json.dumps({'error': 'expired token'}), status=404,
+                                content_type=json_content_type)
+        if not _artcraft_capability_allows_save(
+                info, settings, info.get('file_path', '')):
+            return HttpResponse(json.dumps({'error': 'invalid editor capability'}), status=403,
+                                content_type=json_content_type)
+
+        user = info.get('request_user')
+        repo_id = info.get('repo_id')
+        file_path = info.get('file_path')
+        expected_id = request.headers.get('X-Seafile-File-ID')
+        expected_head = request.headers.get('X-Seafile-Head-ID')
+        if not user or user == ANONYMOUS_EMAIL or not repo_id or not file_path:
+            return HttpResponse(json.dumps({'error': 'invalid editor session'}), status=403,
+                                content_type=json_content_type)
+        try:
+            User.objects.get(email=user)
+        except User.DoesNotExist:
+            return HttpResponse(json.dumps({'error': 'user no longer exists'}), status=403,
+                                content_type=json_content_type)
+        if not expected_id or not expected_head or not request.body:
+            return HttpResponse(json.dumps({'error': 'missing save precondition or content'}),
+                                status=400, content_type=json_content_type)
+        if len(request.body) > getattr(settings, 'ARTCRAFT_MAX_FILE_SIZE', 50 * 1024 * 1024):
+            return HttpResponse(json.dumps({'error': 'file is too large'}), status=413,
+                                content_type=json_content_type)
+        submitted_name = urllib.parse.unquote(
+            request.headers.get('X-ArtCraft-Filename', ''))
+        if submitted_name != os.path.basename(file_path):
+            return HttpResponse(json.dumps({'error': 'Save As is not supported'}), status=400,
+                                content_type=json_content_type)
+        if not _matches_file_type(file_path, request.body):
+            return HttpResponse(json.dumps({'error': 'saved content has the wrong file type'}),
+                                status=400, content_type=json_content_type)
+
+        repo = seafile_api.get_repo(repo_id)
+        if not repo:
+            return HttpResponse(json.dumps({'error': 'library no longer exists'}), status=404,
+                                content_type=json_content_type)
+        parent_dir = os.path.dirname(file_path) or '/'
+        permission = seafile_api.check_permission_by_path(repo_id, parent_dir, user)
+        if not parse_repo_perm(permission).can_edit_on_web:
+            return HttpResponse(json.dumps({'error': 'write permission required'}), status=403,
+                                content_type=json_content_type)
+
+        if repo.head_cmmt_id != expected_head:
+            return HttpResponse(json.dumps({'error': 'library changed; reopen the file'}),
+                                status=409, content_type=json_content_type)
+        current_id = seafile_api.get_file_id_by_path(repo_id, file_path)
+        if current_id != expected_id:
+            return HttpResponse(json.dumps({'error': 'file changed; reopen it'}), status=409,
+                                content_type=json_content_type)
+
+        try:
+            update_token = seafile_api.get_fileserver_access_token(
+                repo_id, 'dummy', 'update', user, use_onetime=True)
+        except SearpcError as e:
+            logger.error(e)
+            return HttpResponse(json.dumps({'error': 'cannot authorize save'}), status=500,
+                                content_type=json_content_type)
+        if not update_token:
+            return HttpResponse(json.dumps({'error': 'cannot authorize save'}), status=500,
+                                content_type=json_content_type)
+
+        query = urllib.parse.urlencode({
+            'head': expected_head,
+            'expected_file_id': expected_id,
+        })
+        # A dedicated route makes unsupported fileservers fail with 404 before
+        # any unconditional update can happen. Never probe via update-api.
+        url = gen_inner_file_upload_url('update-conditional-api', update_token) + '?' + query
+        try:
+            response = requests.post(
+                url,
+                data={'target_file': file_path},
+                files={'file': (os.path.basename(file_path), request.body)},
+                timeout=60,
+            )
+        except requests.RequestException as e:
+            logger.error(e)
+            return HttpResponse(json.dumps({'error': 'Seafile save failed'}), status=502,
+                                content_type=json_content_type)
+        if response.status_code == 409:
+            return HttpResponse(json.dumps({'error': 'file changed; reopen it'}), status=409,
+                                content_type=json_content_type)
+        if response.status_code != 200 or not response.text.strip():
+            logger.error('Fileserver rejected third-party editor save: %s', response.status_code)
+            return HttpResponse(json.dumps({'error': 'Seafile save failed'}), status=502,
+                                content_type=json_content_type)
+
+        updated_repo = seafile_api.get_repo(repo_id)
+        return HttpResponse(json.dumps({
+            'file_id': response.text.strip(),
+            'head_commit_id': updated_repo.head_cmmt_id if updated_repo else '',
+        }), status=200, content_type=json_content_type)
