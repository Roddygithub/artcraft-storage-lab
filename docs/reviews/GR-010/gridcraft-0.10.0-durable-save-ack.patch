diff --git i/crates/engine/src/tests.rs w/crates/engine/src/tests.rs
index d6a99be..448d164 100644
--- i/crates/engine/src/tests.rs
+++ w/crates/engine/src/tests.rs
@@ -9,6 +9,33 @@ fn s() -> Session {
     s
 }
 
+#[test]
+fn host_save_ack_records_its_snapshot_without_clearing_later_edits() {
+    let mut session = s();
+    let (uid, saved_snapshot) = {
+        let doc = session.active().unwrap();
+        (doc.uid, doc.wb.clone())
+    };
+    session.new_workbook();
+    let other_uid = session.active().unwrap().uid;
+    session.set_active(0);
+    session.execute("cell.set", json!({"cell": "A1", "input": "later edit"})).unwrap();
+    assert!(session.active().unwrap().is_dirty());
+
+    assert!(session.mark_saved(uid, saved_snapshot, Some("budget.xlsx")));
+    let doc = session.documents().iter().find(|doc| doc.uid == uid).unwrap();
+    assert!(doc.is_dirty(), "a durable ack for an older snapshot must not clear newer edits");
+    assert_eq!(doc.title, "budget.xlsx");
+
+    let snapshot = doc.wb.clone();
+    assert!(session.mark_saved(uid, snapshot, None));
+    assert!(!session.documents().iter().find(|doc| doc.uid == uid).unwrap().is_dirty());
+    assert!(!session.documents().iter().find(|doc| doc.uid == other_uid).unwrap().is_dirty());
+    session.close_document(0);
+    let closed_snapshot = session.active().unwrap().wb.clone();
+    assert!(!session.mark_saved(uid, closed_snapshot, None), "late ack for a closed doc must be ignored");
+}
+
 fn v(s: &Session, a: &str) -> Value {
     s.doc().unwrap().wb.active().unwrap().value(CellRef::parse(a).unwrap())
 }
