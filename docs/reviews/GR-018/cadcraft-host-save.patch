+    /// Acknowledge a ticketed save from a host (e.g., Seafile via iframe).
+    /// Verifies the drawing's current state matches the snapshot sent with the ticket.
+    /// On success: marks the drawing clean (sets `saved` to current drawing, updates path/title if provided).
+    /// On failure (snapshot mismatch or unknown ticket): keeps drawing dirty, returns error.
+    /// Later edits after the save are preserved as dirty.
+    pub fn ack_save(&mut self, ticket: &cmd::file::SaveTicket, success: bool, path: Option<&str>) -> Result<()> {
+        let Some(info) = self.pending_saves.remove(ticket) else {
+            // Unknown or duplicate ticket: ignore silently (protocol defense).
+            return Ok(());
+        };
+
+        if !success {
+            self.echo("Host rejected the save; the drawing remains unsaved.".to_string());
+            return Ok(());
+        }
+
+        // Find the drawing by UID.
+        let Some(idx) = self.docs.iter().position(|d| d.uid == info.drawing_uid) else {
+            // Drawing was closed: nothing to do.
+            return Ok(());
+        };
+
+        // Preserve newer edits, but remember the committed snapshot and SaveAs destination.
+        let st = &mut self.docs[idx];
+        let current_matches = Arc::ptr_eq(st.drawing(), &info.snapshot);
+        let mut committed = (*info.snapshot).clone();
+        let normalize_version =
+            info.version.is_some_and(|version| info.snapshot.header.get("ACADVER").and_then(cadcraft_doc::HVal::as_str) != Some(version.code()));
+        if let Some(version) = info.version {
+            committed.header.set_str("ACADVER", version.code());
+            if st.drawing().header.get("ACADVER").and_then(cadcraft_doc::HVal::as_str) != Some(version.code()) {
+                Arc::make_mut(st.drawing_arc_mut()).header.set_str("ACADVER", version.code());
+            }
+        }
+        st.binary_dxf = info.binary_dxf;
+        st.saved = if current_matches {
+            st.drawing().clone()
+        } else if normalize_version {
+            Arc::new(committed)
+        } else {
+            info.snapshot
+        };
+        if let Some(p) = path.or(Some(&info.path)) {
+            st.path = Some(p.to_string());
+            st.title = cmd::file::file_name(p);
+        } else {
+            st.path = Some(info.path.clone());
+            st.title = cmd::file::file_name(&info.path);
+        }
+        st.end_undo_group();
+        Ok(())
+    }
