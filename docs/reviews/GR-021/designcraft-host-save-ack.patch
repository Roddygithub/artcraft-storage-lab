 impl Session {
+    /// Serialize the active, pathless document for a host save without changing its saved state.
+    pub fn host_save_snapshot(&self, uid: u64) -> Result<HostSaveSnapshot> {
+        let st = self.active().filter(|st| st.uid == uid).ok_or(EngineError::NoDocument)?;
+        if st.path.is_some() || st.preview_stash.is_some() || st.interaction.is_some() {
+            return Err(EngineError::Other("document is not in a host-saveable state".into()));
+        }
+        let document = st.doc.clone();
+        let bytes = cmd::to_bytes(&document)?;
+        Ok(HostSaveSnapshot { uid, revision: st.revision, base: st.saved_doc.clone(), document, bytes })
+    }
+
+    pub fn host_save_baseline(snapshot: &HostSaveSnapshot) -> HostSaveBaseline {
+        HostSaveBaseline { uid: snapshot.uid, revision: snapshot.revision, base: snapshot.base.clone(), document: snapshot.document.clone() }
+    }
+
+    /// Apply a durable host acknowledgement to the captured snapshot, preserving any later edits.
+    /// Returns the document's dirty state after acknowledgement.
+    pub fn acknowledge_host_save(&mut self, snapshot: HostSaveBaseline) -> Result<bool> {
+        let st = self.docs.iter_mut().find(|st| st.uid == snapshot.uid).ok_or(EngineError::NoDocument)?;
+        if st.path.is_some() || !Arc::ptr_eq(&st.saved_doc, &snapshot.base) {
+            return Err(EngineError::Other("host save snapshot is stale".into()));
+        }
+        st.saved_doc = snapshot.document;
+        st.saved_revision = snapshot.revision;
+        Ok(st.is_dirty())
+    }
