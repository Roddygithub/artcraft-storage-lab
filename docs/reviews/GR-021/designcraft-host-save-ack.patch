--- /dev/null
+++ w/crates/engine/src/tests_host_save.rs
@@ -0,0 +1,50 @@
+use crate::Session;
+use serde_json::json;
+use std::sync::Arc;
+
+#[test]
+fn host_acknowledges_only_the_captured_snapshot_and_reopens_its_bytes() {
+    let mut session = Session::new();
+    session.execute("file.new", &json!({"title": "before"})).unwrap();
+    let uid = session.active().unwrap().uid;
+    let snapshot = session.host_save_snapshot(uid).unwrap();
+    let baseline = Session::host_save_baseline(&snapshot);
+    assert!(!session.active().unwrap().is_dirty());
+
+    session
+        .edit(|doc, _| {
+            doc.title = "after".into();
+            Ok(())
+        })
+        .unwrap();
+    assert!(session.acknowledge_host_save(baseline.clone()).unwrap());
+    assert!(session.active().unwrap().is_dirty());
+
+    let reopened = crate::cmd::from_bytes(&snapshot.bytes).unwrap();
+    assert_eq!(reopened.title, "before");
+    let current = session.active().unwrap();
+    assert_eq!(current.doc.title, "after");
+    assert!(Arc::ptr_eq(&current.saved_doc, &snapshot.document));
+}
+
+#[test]
+fn host_snapshot_rejects_path_and_stale_baseline() {
+    let mut session = Session::new();
+    session.execute("file.new", &json!({})).unwrap();
+    session.execute("frame.create", &json!({"rect": [10, 10, 100, 100]})).unwrap();
+    let uid = session.active().unwrap().uid;
+    let snapshot = session.host_save_snapshot(uid).unwrap();
+    let baseline = Session::host_save_baseline(&snapshot);
+    session
+        .edit(|doc, _| {
+            doc.title = "edited".into();
+            Ok(())
+        })
+        .unwrap();
+    session.acknowledge_host_save(baseline.clone()).unwrap();
+    assert!(session.acknowledge_host_save(baseline).is_err());
+
+    let uid = session.active().unwrap().uid;
+    session.active_mut().unwrap().path = Some("/tmp/document.designcraft".into());
+    assert!(session.host_save_snapshot(uid).is_err());
+}
