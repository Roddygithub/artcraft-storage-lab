+use crate::{DesignApp, HostEvent, HostEventQueue, Services};
+use designcraft_engine::Session;
+use serde_json::json;
+use std::sync::{Arc, Mutex};
+
+fn app_with_host() -> (DesignApp, HostEventQueue, Arc<Mutex<Vec<(String, Vec<u8>)>>>) {
+    let queue = HostEventQueue::default();
+    let sent = Arc::new(Mutex::new(Vec::new()));
+    let sent_save = sent.clone();
+    let mut app = DesignApp::new(
+        Session::new(),
+        Services {
+            host_mode: true,
+            host_events: Some(queue.clone()),
+            host_save: Some(Box::new(move |ticket, _name, bytes| {
+                sent_save.lock().unwrap_or_else(|e| e.into_inner()).push((ticket.to_owned(), bytes.to_vec()));
+                Ok(())
+            })),
+            ..Default::default()
+        },
+    );
+    app.session.execute("file.new", &json!({})).unwrap();
+    app.host_bound_uid = Some(app.session.active().unwrap().uid);
+    app.host_name = Some("layout.designcraft".into());
+    (app, queue, sent)
+}
+
+#[test]
+fn host_save_waits_for_matching_durable_ack_and_keeps_later_edits_dirty() {
+    let (mut app, queue, sent) = app_with_host();
+    app.run("frame.create", json!({"rect": [10, 10, 100, 100]})).unwrap();
+    assert!(app.session.active().unwrap().is_dirty());
+    app.run("app.save", json!({})).unwrap();
+    assert_eq!(sent.lock().unwrap().len(), 1);
+    let (ticket, bytes) = sent.lock().unwrap()[0].clone();
+    assert!(app.session.active().unwrap().is_dirty());
+
+    assert!(!queue.lock().unwrap().enqueue(HostEvent::SaveResult { ticket: "unknown".into(), ok: true, error: None }));
+    app.session
+        .edit(|doc, _| {
+            doc.title = "later edit".into();
+            Ok(())
+        })
+        .unwrap();
+    assert!(queue.lock().unwrap().enqueue(HostEvent::SaveResult { ticket, ok: true, error: None }));
+    app.process_host_events(&egui::Context::default());
+    assert!(app.session.active().unwrap().is_dirty());
+    let saved = designcraft_engine::cmd::from_bytes(&bytes).unwrap();
+    assert_ne!(saved.title, "later edit");
+    assert_eq!(app.ui.status, "Earlier changes saved; newer edits remain");
+}
+
+#[test]
+fn host_mode_refuses_document_replacement_and_save_as_and_keeps_failed_save_dirty() {
+    let (mut app, queue, sent) = app_with_host();
+    app.run("frame.create", json!({"rect": [10, 10, 100, 100]})).unwrap();
+    assert!(app.run("file.new", json!({})).is_err());
+    assert!(app.run("file.saveAs", json!({"path": "/tmp/nope.designcraft"})).is_err());
+    assert!(app.run("file.saveACopy", json!({"path": "/tmp/copy.designcraft"})).is_err());
+    assert!(app.run("app.saveCopyDialog", json!({})).is_err());
+    assert!(app.open_file("file.open", json!({"path": "/tmp/second.designcraft"})).is_err());
+    assert!(app.open_named_file("file.openRecent", json!({"index": 0}), "second.designcraft".into()).is_err());
+    assert!(app.pick_and_open("open").is_err());
+    for command in ["version.duplicate", "branch.open", "collab.join", "data.merge"] {
+        assert!(app.run(command, json!({})).is_err(), "{command} must be refused in host mode");
+    }
+
+    app.run("app.save", json!({})).unwrap();
+    let ticket = sent.lock().unwrap()[0].0.clone();
+    assert!(queue.lock().unwrap().enqueue(HostEvent::SaveResult { ticket, ok: false, error: Some("conflict".into()) }));
+    app.process_host_events(&egui::Context::default());
+    assert!(app.session.active().unwrap().is_dirty());
+    assert!(app.host_pending.is_none());
+}
+
+#[test]
+fn host_open_accepts_one_native_designcraft_document() {
+    let mut source = Session::new();
+    source.execute("file.new", &json!({"title": "from host"})).unwrap();
+    source.execute("frame.create", &json!({"rect": [10, 10, 100, 100]})).unwrap();
+    let bytes = source.host_save_snapshot(source.active().unwrap().uid).unwrap().bytes;
+    let queue = HostEventQueue::default();
+    assert!(queue.lock().unwrap().enqueue(HostEvent::Open { name: "from-host.designcraft".into(), bytes: bytes.clone() }));
+    let mut app = DesignApp::new(Session::new(), Services { host_mode: true, host_events: Some(queue.clone()), ..Default::default() });
+    app.process_host_events(&egui::Context::default());
+    assert_eq!(app.session.documents().len(), 1);
+    assert!(app.host_bound_uid.is_some());
+    assert!(!app.session.active().unwrap().is_dirty());
+    assert!(queue.lock().unwrap().enqueue(HostEvent::Open { name: "second.designcraft".into(), bytes }));
+    app.process_host_events(&egui::Context::default());
+    assert_eq!(app.session.documents().len(), 1);
+}
