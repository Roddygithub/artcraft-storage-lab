+pub enum HostEvent {
+    Open { name: String, bytes: Vec<u8> },
+    SaveResult { ticket: String, ok: bool, error: Option<String> },
+}
+
+const MAX_HOST_DOCUMENT_BYTES: usize = 64 * 1024 * 1024;
+
+#[derive(Default)]
+pub struct HostEventBuffer {
+    events: Vec<HostEvent>,
+    expected_ticket: Option<String>,
+    open_queued: bool,
+}
+
+impl HostEventBuffer {
+    pub fn expect_save(&mut self, ticket: Option<String>) {
+        self.expected_ticket = ticket;
+    }
+
+    pub fn enqueue(&mut self, event: HostEvent) -> bool {
+        if self.events.len() >= 2 {
+            return false;
+        }
+        match &event {
+            HostEvent::Open { bytes, .. } if bytes.len() <= MAX_HOST_DOCUMENT_BYTES && !self.open_queued => {
+                self.open_queued = true;
+            }
+            HostEvent::SaveResult { ticket, .. } if self.expected_ticket.as_deref() == Some(ticket) => {}
+            _ => return false,
+        }
+        self.events.push(event);
+        true
+    }
+
+    fn drain(&mut self) -> Vec<HostEvent> {
+        self.open_queued = false;
+        std::mem::take(&mut self.events)
+    }
+}
 
