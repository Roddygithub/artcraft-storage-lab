@@ -0,0 +1,225 @@
+//! The `postMessage` bridge to a same-origin parent page (`?host=parent`), for pages that embed
+//! WordCraft in an `<iframe>`. Messages are plain objects with a `type`:
+//!
+//! - `wordcraft:ready` (to the parent): `{ version }`, the app is listening; send a file now.
+//! - `wordcraft:open` (from the parent): `{ name, bytes }`, bytes an `ArrayBuffer` or
+//!   `Uint8Array`. It opens like a file picked with File › Open or dropped on the window.
+//! - `wordcraft:save` (to the parent): `{ name, bytes }` (a transferred `ArrayBuffer`) and the
+//!   `ticket` that identifies this save, for every file WordCraft would otherwise download:
+//!   Save and Save As (a .docx document) and Export as PDF. The parent stores it and reports
+//!   how it ended.
+//! - `wordcraft:saveResult` (from the parent): `{ ticket, ok, error? }` — how the parent's
+//!   write ended. The document counts as saved only on `ok`; otherwise it stays unsaved and
+//!   the app says why, exactly as it does for a download that fails.
+//! - `wordcraft:openRequest` (to the parent): `{ purpose }` — the user asked File › Open (or
+//!   Insert › Pictures); the parent answers with `wordcraft:open`.
+//! - `wordcraft:dirty` (to the parent): `{ dirty }` whenever unsaved changes appear or go away.
+//! - `wordcraft:failed` (to the parent): `{ error }` when the app couldn't start.
+//!
+//! Only the parent window on the page's own origin is heard or answered. In host mode the page
+//! starts with an empty document instead of a sample, and the parent guards leaving the page.
+
+use std::cell::Cell;
+use std::rc::Rc;
+
+use wasm_bindgen::closure::Closure;
+use wasm_bindgen::JsCast as _;
+use wasm_bindgen::JsValue;
+use wordcraft_ui_egui::async_saves::{AsyncSaves, SaveOutcome};
+use wordcraft_ui_egui::{Inbox, Services};
+
+/// The longest user name taken from `?author=`.
+const MAX_AUTHOR_CHARS: usize = 200;
+
+#[derive(Clone)]
+pub struct Bridge {
+    window: web_sys::Window,
+    parent: web_sys::Window,
+    origin: String,
+    /// The saves the parent has to answer for.
+    saves: AsyncSaves,
+    /// The unsaved-changes state last reported to the parent.
+    reported: Rc<Cell<Option<bool>>>,
+}
+
+impl Bridge {
+    /// `None` when the page isn't framed (there is no parent to talk to), or when the parent is
+    /// on another origin: messages only go to this origin, so the browser would drop every
+    /// save without an error while the document showed as saved.
+    pub fn new(saves: AsyncSaves) -> Option<Self> {
+        let window = web_sys::window()?;
+        let parent = window.parent().ok().flatten()?;
+        if js_sys::Object::is(&parent, &window) {
+            return None;
+        }
+        let origin = window.location().origin().ok()?;
+        // Reading another origin's location throws, which is `None` too.
+        if parent.location().origin().ok()? != origin {
+            return None;
+        }
+        Some(Self { window, parent, origin, saves, reported: Rc::default() })
+    }
+
+    /// Send saved and exported files to the parent instead of downloading them, ask the parent
+    /// for a file instead of the browser's picker, and tell the parent when the document has
+    /// unsaved changes.
+    pub fn connect(&self, services: &mut Services, inbox: Inbox, ctx: egui::Context) {
+        self.listen(inbox, ctx);
+
+        let bridge = self.clone();
+        services.download = Some(Box::new(move |path: &str, bytes: &[u8]| {
+            let name = file_name(path);
+            // A ticket the parent answers for; until it does, the document isn't saved.
+            let ticket = bridge.saves.start();
+            if let Err(e) = bridge.post_save(&name, bytes, ticket) {
+                bridge.saves.finish(ticket, SaveOutcome::Failed(e.clone()));
+                return Err(e);
+            }
+            Ok(())
+        }));
+
+        let bridge = self.clone();
+        services.open_async = Some(Box::new(move |purpose: &str| {
+            bridge.post_open_request(purpose);
+        }));
+
+        // The browser's leave-page guard still wants to know.
+        let bridge = self.clone();
+        let previous = services.on_dirty.take();
+        services.on_dirty = Some(Box::new(move |dirty: bool| {
+            if let Some(previous) = &previous {
+                previous(dirty);
+            }
+            bridge.post_dirty(dirty);
+        }));
+    }
+
+    /// `?author=`: the host's name for the user, used where the app asks for one.
+    pub fn set_author(app: &mut wordcraft_ui_egui::WordApp, author: &str) {
+        let author: String = author.trim().chars().take(MAX_AUTHOR_CHARS).collect();
+        if !author.is_empty() {
+            app.session.author = author;
+        }
+    }
+
+    pub fn post_ready(&self) {
+        self.send(&[
+            ("type", "wordcraft:ready".into()),
+            ("version", env!("CARGO_PKG_VERSION").into()),
+        ]);
+    }
+
+    pub fn post_failed(&self, error: &str) {
+        self.send(&[("type", "wordcraft:failed".into()), ("error", error.into())]);
+    }
+
+    /// The document has unsaved changes (or hasn't any).
+    pub fn post_dirty(&self, dirty: bool) {
+        if self.reported.get() == Some(dirty) {
+            return;
+        }
+        if self.send(&[("type", "wordcraft:dirty".into()), ("dirty", dirty.into())]) {
+            self.reported.set(Some(dirty));
+        }
+    }
+
+    /// The user asked for a file; the parent answers with `wordcraft:open`.
+    fn post_open_request(&self, purpose: &str) {
+        self.send(&[("type", "wordcraft:openRequest".into()), ("purpose", purpose.into())]);
+    }
+
+    fn post_save(&self, name: &str, bytes: &[u8], ticket: u64) -> Result<(), String> {
+        let buffer = js_sys::Uint8Array::from(bytes).buffer();
+        let message = message(&[
+            ("type", "wordcraft:save".into()),
+            ("name", name.into()),
+            ("ticket", (ticket as f64).into()),
+            ("bytes", buffer.clone().into()),
+        ])
+        .ok_or_else(|| "couldn't build the message".to_string())?;
+        self.parent
+            .post_message_with_transfer(&message, &self.origin, &js_sys::Array::of1(&buffer))
+            .map_err(|e| e.as_string().unwrap_or_else(|| format!("{e:?}")))
+    }
+
+    fn listen(&self, inbox: Inbox, ctx: egui::Context) {
+        let parent = self.parent.clone();
+        let origin = self.origin.clone();
+        let saves = self.saves.clone();
+        let on_message = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |event: web_sys::MessageEvent| {
+            if event.origin() != origin || !event.source().is_some_and(|s| js_sys::Object::is(&s, &parent)) {
+                return;
+            }
+            let data = event.data();
+            match string(&data, "type").as_deref() {
+                Some("wordcraft:open") => {
+                    let name = string(&data, "name").filter(|n| !n.trim().is_empty()).unwrap_or_else(|| "document.docx".to_string());
+                    let Some(bytes) = bytes(&data) else { return };
+                    inbox.lock().unwrap_or_else(|e| e.into_inner()).push((name, bytes));
+                    ctx.request_repaint();
+                }
+                Some("wordcraft:saveResult") => {
+                    let Some(ticket) = number(&data, "ticket") else { return };
+                    let outcome = if bool(&data, "ok") {
+                        SaveOutcome::Saved
+                    } else {
+                        SaveOutcome::Failed(
+                            string(&data, "error").unwrap_or_else(|| "the host couldn't save the file".to_string()),
+                        )
+                    };
+                    saves.finish(ticket as u64, outcome);
+                }
+                _ => {}
+            }
+        });
+        if self.window.add_event_listener_with_callback("message", on_message.as_ref().unchecked_ref()).is_ok() {
+            // The listener lives as long as the page.
+            on_message.forget();
+        }
+    }
+
+    /// Post a message to the parent; false if it couldn't be sent.
+    fn send(&self, fields: &[(&str, JsValue)]) -> bool {
+        message(fields).is_some_and(|m| self.parent.post_message(&m, &self.origin).is_ok())
+    }
+}
+
+/// The name a file is saved under: the last component of its path.
+fn file_name(path: &str) -> String {
+    std::path::Path::new(path)
+        .file_name()
+        .map(|n| n.to_string_lossy().to_string())
+        .unwrap_or_else(|| "document.docx".to_string())
+}
+
+fn message(fields: &[(&str, JsValue)]) -> Option<js_sys::Object> {
+    let m = js_sys::Object::new();
+    for (key, value) in fields {
+        js_sys::Reflect::set(&m, &JsValue::from_str(key), value).ok()?;
+    }
+    Some(m)
+}
+
+fn string(data: &JsValue, key: &str) -> Option<String> {
+    js_sys::Reflect::get(data, &JsValue::from_str(key)).ok()?.as_string()
+}
+
+fn bool(data: &JsValue, key: &str) -> bool {
+    js_sys::Reflect::get(data, &JsValue::from_str(key)).ok().and_then(|v| v.as_bool()).unwrap_or(false)
+}
+
+fn number(data: &JsValue, key: &str) -> Option<f64> {
+    js_sys::Reflect::get(data, &JsValue::from_str(key)).ok()?.as_f64()
+}
+
+/// `bytes` as an `ArrayBuffer` or `Uint8Array`.
+fn bytes(data: &JsValue) -> Option<Vec<u8>> {
+    let bytes = js_sys::Reflect::get(data, &JsValue::from_str("bytes")).ok()?;
+    if let Some(array) = bytes.dyn_ref::<js_sys::Uint8Array>() {
+        Some(array.to_vec())
+    } else if bytes.is_instance_of::<js_sys::ArrayBuffer>() {
+        Some(js_sys::Uint8Array::new(&bytes).to_vec())
+    } else {
+        None
+    }
+}
