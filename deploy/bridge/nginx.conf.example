# The bridge on its own hostname (recommended: a separate origin from Seafile keeps the editor
# iframes out of Seafile's cookie scope). Serves .wasm with the right type and compression.
server {
    listen 443 ssl http2;
    server_name craft.example.org;
    # ssl_certificate ...; ssl_certificate_key ...;

    client_max_body_size 256m;        # documents saved through /relay/save
    gzip on;
    gzip_types application/wasm text/javascript application/javascript text/html text/css application/json;
    gzip_min_length 1024;

    # The bridge sets Cache-Control itself: no-store on pages and relay answers, immutable on
    # content-hashed bundle assets, no-cache + ETag on index.html / host.js / host-shim.js. Do not
    # add or override Cache-Control here.
    location / {
        proxy_pass http://127.0.0.1:8778;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
    location /relay/save {
        proxy_pass http://127.0.0.1:8778;
        proxy_set_header Host $host;
        proxy_request_buffering off;   # stream the document body through
        proxy_read_timeout 600s;       # a large PutFile plus Seafile's commit can exceed two minutes
    }
}
