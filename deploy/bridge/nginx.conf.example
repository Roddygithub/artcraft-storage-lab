# The bridge on its own hostname (recommended: a separate origin from Seafile keeps the editor
# iframes out of Seafile's cookie scope). Serves .wasm with the right type and compression.
server {
    listen 443 ssl http2;
    server_name craft.example.org;
    # ssl_certificate ...; ssl_certificate_key ...;

    client_max_body_size 256m;        # documents saved through /relay/save
    gzip on;
    gzip_types application/wasm text/javascript application/javascript text/html text/css application/json;

    location / {
        proxy_pass http://127.0.0.1:8778;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
    location /editors/ {
        proxy_pass http://127.0.0.1:8778;
        proxy_cache_valid 200 1y;      # bundles are content-hashed; index.html is revalidated by the bridge
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
