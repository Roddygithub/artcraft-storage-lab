# The bridge on its own hostname (recommended: a separate origin from Seafile keeps the editor
# iframes out of Seafile's cookie scope). Serves .wasm with the right type and compression.
# TLS is mandatory: WebGPU, clipboard API, secure cookies, and CSP all require HTTPS.
server {
    listen 443 ssl http2;
    server_name craft.example.org;

    # ---- TLS (replace with your cert paths) ----
    # ssl_certificate /etc/letsencrypt/live/craft.example.org/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/craft.example.org/privkey.pem;

    # Modern TLS config (adjust to your policy)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 256m;        # documents saved through /relay/save
    gzip on;
    gzip_vary on;
    gzip_types application/wasm text/javascript application/javascript text/html text/css application/json application/wasm;
    gzip_min_length 1024;

    # The bridge sets Cache-Control itself: no-store on pages and relay answers, immutable on
    # content-hashed bundle assets, no-cache + ETag on index.html / host.js / host-shim.js. Do not
    # add or override Cache-Control here.
    location / {
        proxy_pass http://127.0.0.1:8778;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /relay/save {
        proxy_pass http://127.0.0.1:8778;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_request_buffering off;   # stream the document body through
        proxy_read_timeout 600s;       # a large PutFile plus Seafile's commit can exceed two minutes
        proxy_send_timeout 600s;
    }

    # Optional: rate limit on editor opens (adjust to your traffic)
    # limit_req_zone $binary_remote_addr zone=editor_open:10m rate=30r/m;
    # location /edit/ { limit_req zone=editor_open burst=10 nodelay; ... }
}
