# Bridge deployment environment — copy to .env and fill in your values
# Required: both must be HTTPS origins (scheme + host [+ port]), no trailing slash.

# PUBLIC HTTPS origin of the bridge (what users type in browser)
# Example: https://craft.example.org
BRIDGE_PUBLIC_URL=

# HTTPS origin of your Seafile (what users type for Seafile)
# Example: https://seafile.example.org
BRIDGE_SEAHUB_ORIGIN=